close":"18:00"}],"note":"Typical hours — check the official site"},"bestLight":"morning","summary":"An old fort around Sree Padmanabhaswamy temple. Today most of fortifications have been dismantled, except the Eastern side. The fort will sometimes be referred to as the East Fort because of this. The Fort Gate opens directly before Sree Padmanabha Temple and is designed in a European style. The illumination of the East Fort Gate in the evenings is a major attraction.","summarySource":"wikivoyage","wikivoyageTitle":"Thiruvananthapuram","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/East_Fort_2.jpg/1280px-East_Fort_2.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/East_Fort_2.jpg/500px-East_Fort_2.jpg","w":1200,"h":901,"author":"Shyamal","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:East_Fort_2.jpg"}},{"id":"thiruvananthapuram_sree_chithra_art_gallery","areaId":"thiruvananthapuram","name":"Sree Chithra Art Gallery","category":"museum","tags":["museums"],"location":{"lat":8.51099,"lng":76.9554},"visitMinutes":120,"priceLevel":2,"photoSeed":"thiruvananthapuram_sree_chithra_art_gallery","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":63,"wikidataSitelinks":0,"fetchedAt":"2026-10-20"},"hashtags":["sreechithraartgallery","thiruvananthapuram"],"hours":{"week":[null,{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Closed Mon; Typical hours — check the official site"},"summary":"An art gallery in the Museum compound and displays a rare collection of mainly Indian paintings. The main attractions are paintings by Kerala painter Raja Ravi Varma and other famous painters Raja raja Varma and Nicholas Roerich. Also featured are miniature paintings from around the world, Kerala mural paintings, and Tanjore miniature paintings.","summarySource":"wikivoyage","wikivoyageTitle":"Thiruvananthapuram","names":{"es":"Galería de Arte Sree Chitra"},"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Hippos_in_Zoo%2C_TVM.jpg/1280px-Hippos_in_Zoo%2C_TVM.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Hippos_in_Zoo%2C_TVM.jpg/500px-Hippos_in_Zoo%2C_TVM.jpg","w":1200,"h":675,"author":"Path slopu","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Hippos_in_Zoo,_TVM.jpg"}},{"id":"thiruvananthapuram_kanaka_kunnu_palace","areaId":"thiruvananthapuram","name":"Kanaka Kunnu Palace","category":"park","tags":["nature","photo"],"location":{"lat":8.51066,"lng":76.95812},"visitMinutes":60,"priceLevel":0,"photoSeed":"thiruvananthapuram_kanaka_kunnu_palace","tickets":[],"signals":{"commonsDepicts":1,"commonsNearby":50,"wikidataSitelinks":0,"fetchedAt":"2026-10-20"},"hashtags":["kanakakunnupalace","thiruvananthapuram"],"bestLight":"golden","summary":"The cultural hotspot of ancient Thiruvananthapuram. The large palace and its sprawling gardens was once the banquet palace for visiting State guests of Travancore. Today, it has engaging galleries and the grand lawns serve as open-air auditoriums for regular concerts and evening dance programs.","summarySource":"wikivoyage","wikivoyageTitle":"Thiruvananthapuram","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Kanakakkunnu_Palace_DSW.jpg/1280px-Kanakakkunnu_Palace_DSW.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Kanakakkunnu_Palace_DSW.jpg/500px-Kanakakkunnu_Palace_DSW.jpg","w":1200,"h":524,"author":"Augustus Binu/ www.dreamsparrow.net/ facebook","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Kanakakkunnu_Palace_DSW.jpg"}},{"id":"thiruvananthapuram_niyamasabha_ma