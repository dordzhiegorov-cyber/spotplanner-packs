/5d/Hike_mark_on_stone.jpg/1280px-Hike_mark_on_stone.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/Hike_mark_on_stone.jpg/500px-Hike_mark_on_stone.jpg","w":1200,"h":800,"author":"Tiia Monto","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Hike_mark_on_stone.jpg"}},{"id":"davos_wv_winter_sports_museum","areaId":"davos","name":"Winter Sports Museum","category":"museum","tags":["museums"],"location":{"lat":46.79363,"lng":9.8204},"visitMinutes":120,"priceLevel":2,"photoSeed":"davos_wv_winter_sports_museum","tickets":[{"vendor":"Official","url":"http://www.wintersportmuseum.ch/","official":true}],"signals":{"commonsNearby":67,"wikidataSitelinks":0,"fetchedAt":"2026-10-24"},"hashtags":["wintersportsmuseum","davos"],"hours":{"week":[null,{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Closed Mon; Typical hours — check the official site"},"summary":"While in the winter wonderland of Davos, visit the Winter Sport Museum. This museum holds a large collection of winter sport equipment and documents donated by the Jürg Kaufmann family. The well-preserved exhibits (sleds, bobsleds, skis, skates, curling material, etc.) document the history of winter sports.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Secretary_Kerry_Participates_in_Roundtable_Discussion_With_%27Breaking_the_Impasse%27_Group_%2812120965504%29.jpg/1280px-Secretary_Kerry_Participates_in_Roundtable_Discussion_With_%27Breaking_the_Impasse%27_Group_%2812120965504%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Secretary_Kerry_Participates_in_Roundtable_Discussion_With_%27Breaking_the_Impasse%27_Group_%2812120965504%29.jpg/500px-Secretary_Kerry_Participates_in_Roundtable_Discussion_With_%27Breaking_the_Impasse%27_Group_%2812120965504%29.jpg","w":1200,"h":797,"author":"U.S. Department of State from United States","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Secretary_Kerry_Participates_in_Roundtable_Discussion_With_%27Breaking_the_Impasse%27_Group_(12120965504).jpg"}},{"id":"davos_wv_restaurant_bistro_gentiana","areaId":"davos","name":"Restaurant/Bistro Gentiana","category":"food","tags":["food"],"location":{"lat":46.79498,"lng":9.82094},"visitMinutes":75,"photoSeed":"davos_wv_restaurant_bistro_gentiana","tickets":[{"vendor":"Official","url":"https://www.gentiana.ch/","official":true}],"signals":{},"hashtags":["restaurantbistrogentiana","davos"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Small restaurant on the main thoroughfare of Davos. Short walk from many of the hotels. Specializes in local cuisine (fondues and regional dishes). Food is interesting and well presented. The ambience is that of a small cafe with attentive staff. Thoroughly enjoyable and moderately priced (approximately Fr. 160 for dinner for two with wine).","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_mann_co","areaId":"davos","name":"Mann & Co","category":"food","tags":["food"],"location":{"lat":46.80222,"lng":9.82738},"visitMinutes":75,"photoSeed":"davos_wv_mann_co","tickets":[],"signals":{},"hashtags":["mannco","davos"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"It's a culinary experience dining at Mann & Co, already been recognized by the \"Gault-Millau\" guide and serves exquisite 5 course meals every day. The 5 course meals includes Graubünden classics and more exotic dishes served in a fresh, modern way. The cuisine is accompanied by a sensational wine menu with a selection of 350 wines.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_piano_bar","areaId":"davos","name":"Piano Bar","category":"nightlife","tags":["nightlife"],"location":{"lat":46.79658,"lng":9.82159},"visitMinutes":90,"photoSeed":"davos_wv_piano_bar","tickets":[],"signals":{},"hashtags":["pianobar","davos"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"The party moves away from the slopes and on to the Piano Bar at the Hotel Europe, for fine cigars, an expansive array of whiskeys and sing along piano music. The default after party spot during the World Economic Forum, where traditional raucous boozing gives way to midnight singing sessions alongside the pianist.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_restaurant_postli","areaId":"davos","name":"Restaurant Pöstli","category":"food","tags":["food"],"location":{"lat":46.79401,"lng":9.8212},"visitMinutes":75,"photoSeed":"davos_wv_restaurant_postli","tickets":[],"signals":{},"hashtags":["restaurantpostli","davos"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Serving tasty platters of fresh seafood and well prepared meat, or choose from a fine selection of menu choices such as venison, beef or lamb. In winter, they usually offers live music from 17:00 to 17:30 and from 20:30 until closing time. In summer, live music begins at 18:00 and lasts until closing.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_bruhin_s_weissfluhgipfel","areaId":"davos","name":"Bruhin's Weissfluhgipfel","category":"food","tags":["food"],"location":{"lat":46.83448,"lng":9.79501},"visitMinutes":75,"photoSeed":"davos_wv_bruhin_s_weissfluhgipfel","tickets":[{"vendor":"Official","url":"https://restaurant-weissfluhgipfel.ch/","official":true}],"signals":{},"hashtags":["bruhinsweissfluhgipfel","davos"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Chef Sebastian Schallen treats his guests to simple, market fresh food, served 2864 m above sea level. Special attention has been made to the wine list, featuring a variety of good choices. Dine to views of Graubunden’s mountain world.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_carigiet_bar","areaId":"davos","name":"Carigiet Bar","category":"nightlife","tags":["nightlife"],"location":{"lat":46.80057,"lng":9.82621},"visitMinutes":90,"photoSeed":"davos_wv_carigiet_bar","tickets":[],"signals":{},"hashtags":["carigietbar","davos"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"The fun continues off the snow at the Carigiet Bar, in the Steigenberger Hotel Belvedere. Replenish your energy from the slopes with delicious cocktails and listen to the musical entertainment that plays each evening.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_der_pate","areaId":"davos","name":"Der Pate","category":"food","tags":["food"],"location":{"lat":46.80926,"lng":9.84137},"visitMinutes":75,"photoSeed":"davos_wv_der_pate","tickets":[{"vendor":"Official","url":"http://www.der-pate.ch/","official":true}],"signals":{},"hashtags":["derpate","davos"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Understated and good value pizzeria and pasta restaurant sited next to the end of the platform at Davos Dorf station. \"Der Pate\" means \"the Godfather\", so don't be surprised by the Marlon Brando film posters.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_wintergartenrestaurant_larix","areaId":"davos","name":"Wintergartenrestaurant Larix","category":"food","tags":["food"],"location":{"lat":46.78961,"lng":9.81359},"visitMinutes":75,"photoSeed":"davos_wv_wintergartenrestaurant_larix","tickets":[],"signals":{},"hashtags":["wintergartenrestaurantlarix","davos"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Enjoy classic French cuisine in a stunning outside but covered restaurant. Careful attention to detail is observed here, with fine dining china, linen napkins and warm muted tones decorating the restaurant.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_arabella_sheraton_hotel_waldhuus","areaId":"davos","name":"Arabella Sheraton Hotel Waldhuus","category":"food","tags":["food"],"location":{"lat":46.79758,"lng":9.83512},"visitMinutes":75,"photoSeed":"davos_wv_arabella_sheraton_hotel_waldhuus","tickets":[],"signals":{},"hashtags":["arabellasheratonhotelwaldhuus","davos"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Indulge in some high-class Swiss cuisine made with fresh local products. The Matta-Bar inside the restaurant is a bar with a fireplace where you can relax to the sounds of piano music.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_restaurant_muhle_sertig","areaId":"davos","name":"Restaurant Mühle Sertig","category":"food","tags":["food"],"location":{"lat":46.75966,"lng":9.82561},"visitMinutes":75,"photoSeed":"davos_wv_restaurant_muhle_sertig","tickets":[{"vendor":"Official","url":"https://www.muehle-sertig.ch/","official":true}],"signals":{},"hashtags":["restaurantmuhlesertig","davos"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Grison specialities are highly recommended here and are well accompanied by wines from Graubünden and Veltelin. Waiters serve fondue from carriage arrangements and do table service.","summarySource":"wikivoyage","wikivoyageTitle":"en:Davos"},{"id":"davos_wv_fluela_stubli_hotel_fluela","areaId":"davos","name":"Fluela-Stubli, Hotel Fluela","category":"food","tags":["food"],"location":{"lat":46.80996,"lng"