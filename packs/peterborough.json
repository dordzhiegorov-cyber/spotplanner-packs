24.jpg","w":1200,"h":900,"author":"Rodney Burton","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Peterborough_United%27s_South_Family_Stand_beginning_to_fill_up_-_geograph.org.uk_-_154824.jpg"}},{"id":"peterborough_peterscourt","areaId":"peterborough","name":"Peterscourt","category":"landmark","tags":["history","photo"],"location":{"lat":52.57414,"lng":-0.23978},"visitMinutes":45,"priceLevel":0,"photoSeed":"peterborough_peterscourt","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":101,"wikiPageviews":60,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["peterscourt","peterborough"],"bestLight":"morning","summary":"Peterscourt is a building in Peterborough, on City Road, which was designed by George Gilbert Scott and completed in 1859. It is Grade II listed.","summarySource":"wikipedia","wikipediaTitle":"Peterscourt","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/d/db/Peterscourt_-_the_south_fa%C3%A7ade_-_geograph.org.uk_-_671276.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/d/db/Peterscourt_-_the_south_fa%C3%A7ade_-_geograph.org.uk_-_671276.jpg","w":1200,"h":847,"author":"Alan Murray-Rust","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Peterscourt_-_the_south_fa%C3%A7ade_-_geograph.org.uk_-_671276.jpg"}},{"id":"peterborough_st_peter_and_all_souls_peterborough","areaId":"peterborough","name":"St Peter and All Souls, Peterborough","category":"monument","tags":["history","photo"],"location":{"lat":52.57652,"lng":-0.24265},"visitMinutes":45,"priceLevel":0,"photoSeed":"peterborough_st_peter_and_all_souls_peterborough","tickets":[{"vendor":"Official","url":"https://www.stpeterandallsouls.org.uk","official":true}],"signals":{"commonsDepicts":1,"commonsNearby":73,"wikiPageviews":44,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["stpeteran