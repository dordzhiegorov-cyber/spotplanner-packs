utes":45,"priceLevel":0,"photoSeed":"peterborough_eye_gravel_pit","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":4,"wikiPageviews":32,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["eyegravelpit","peterborough"],"bestLight":"morning","summary":"Eye Gravel Pit is a 0.4-hectare (0.99-acre) geological Site of Special Scientific Interest in Eye Green in Cambridgeshire. It is a Geological Conservation Review site, and part of it overlaps Eye Green Local Nature Reserve.","summarySource":"wikipedia","wikipediaTitle":"Eye Gravel Pit","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Eye_Gravel_Pit_3.jpg/1280px-Eye_Gravel_Pit_3.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Eye_Gravel_Pit_3.jpg/500px-Eye_Gravel_Pit_3.jpg","w":1200,"h":798,"author":"Dudley Miles","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Eye_Gravel_Pit_3.jpg"}},{"id":"peterborough_eye_green_nature_reserve","areaId":"peterborough","name":"Eye Green Nature Reserve","category":"park","tags":["nature","photo"],"location":{"lat":52.6131,"lng":-0.18407},"visitMinutes":60,"priceLevel":0,"photoSeed":"peterborough_eye_green_nature_reserve","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":4,"wikiPageviews":18,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["eyegreennaturereserve","peterborough"],"bestLight":"golden","summary":"Eye Green Local Nature Reserve is a 12 hectare Local Nature Reserve in Eye Green in Cambridgeshire. It was managed by the Wildlife Trust for Bedfordshire, Cambridgeshire and Northamptonshire until September 2016, when management was transferred to its owner, Peterborough City Council.","summarySource":"wikipedia","wikipediaTitle":"Eye Green Local Nature Reserve","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/6/63/Water-filled_disused_brick_pit%2C_Eye_Green%2C_Peterborough_-_geograph.org.uk_-_62746.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/6/63/Water-filled_disused_brick_pit%2C_Eye_Green%2C_Peterborough_-_geograph.org.uk_-_62746.jpg","w":1200,"h":884,"author":"Rodney Burton","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Water-filled_disused_brick_pit,_Eye_Green,_Peterborough_-_geograph.org.uk_-_62746.jpg"}},{"id":"peterborough_the_boardwalks","areaId":"peterborough","name":"The Boardwalks","category":"park","tags":["nature","photo"],"location":{"lat":52.569,"lng":-0.26},"visitMinutes":60,"priceLevel":0,"photoSeed":"peterborough_the_boardwalks","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":7,"wikiPageviews":12,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["theboardwalks","peterborough"],"bestLight":"golden","summary":"The Boardwalks is a 7.8 hectare Local Nature Reserve in Peterborough in Cambridgeshire. It is owned and managed by Peterborough City Council.","summarySource":"wikipedia","wikipediaTitle":"The Boardwalks","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/The_Boardwalks_11.jpg/1280px-The_Boardwalks_11.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/The_Boardwalks_11.jpg/500px-The_Boardwalks_11.jpg","w":1200,"h":798,"author":"Dudley Miles","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:The_Boardwalks_11.jpg"}},{"id":"peterborough_stanground_newt_ponds","areaId":"peterborough","name":"Stanground Newt Ponds","category":"park","tags":["nature","hiking"],"location":{"lat":52.549,"lng":-0.2295},"visitMinutes":120,"priceLevel":0,"photoSeed":"peterborough_stanground_newt_ponds","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":6,"wikiPageviews":13,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["stangroundnewtponds","peterborough"],"bestLight":"golden","summary":"Stanground Newt Ponds is a 1-hectare (2.5-acre) nature reserve in Peterborough in Cambridgeshire. It is managed by the Wildlife Trust for Bedfordshire, Cambridgeshire and Northamptonshire. The land was originally set aside during the building process of housing, while the ponds themselves have existed for decades.","summarySource":"wikipedia","wikipediaTitle":"Stanground Newt Ponds","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Stanground_Newt_Ponds_6.jpg/1280px-Stanground_Newt_Ponds_6.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Stanground_Newt_Ponds_6.jpg/500px-Stanground_Newt_Ponds_6.jpg","w":1200,"h":798,"author":"Dudley Miles","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Stanground_Newt_Ponds_6.jpg"}}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}