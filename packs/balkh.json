kidataSitelinks":0,"fetchedAt":"2026-10-24"},"hashtags":["dargahofrabiabalkhi","balkh"],"summary":"Adjacent to the Parsa shrine is this small tomb of the famous female Persian poet. She was sealed in a basement by her brother after having an affair, and wrote her most famous poem in her own blood on the wall as she died.","summarySource":"wikivoyage","wikivoyageTitle":"en:Balkh","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c0/15c_green_mosque.jpg/1280px-15c_green_mosque.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c0/15c_green_mosque.jpg/500px-15c_green_mosque.jpg","w":1200,"h":1794,"author":"bluuurgh","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:15c_green_mosque.jpg"}},{"id":"balkh_wv_bala_hissar","areaId":"balkh","name":"Bala Hissar","category":"monument","tags":["history","photo","views"],"location":{"lat":36.7678,"lng":66.901},"visitMinutes":120,"priceLevel":2,"photoSeed":"balkh_wv_bala_hissar","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-24"},"hashtags":["balahissar","balkh"],"hours":{"week":[{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Typical hours — check the official site"},"bestLight":"morning","summary":"A huge fortress built by the Timurid in the 15th century on the site of an Achaemenid fort where Alexander the Great married the beautiful Roxanne.","summarySource":"wikivoyage","wikivoyageTitle":"en:Balkh"},{"id":"balkh_wv_noh_gonbad_haji_piyada_mosque","areaId":"balkh","name":"Noh Gonbad (Haji Piyada) Mosque","category":"monument","tags":["history","photo"],"location":{"lat":36.73577,"lng":66.89578},"visitMinutes":45,"priceLevel":0,"photoSeed":"balkh_wv_noh_gonbad_haji_piyada_mosque","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-24"},"hashtags":["nohgonbadhajipiyadamosque","balkh"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"}],"note":"Typical hours — check the official site"},"summary":"Well worth a visit. Its history is unclear but it is certainly one of Afghanistan's most important historical buildings. Possibly dating from Zoroastrian times, the remains are now under a protective roof, and are worth the bumpy 2-km drive from the main Balkh - Mazar road. Head south from the centre of Balkh, cross the main east-west road and keep going.  After 500 metres you'll see a sign (in En","summarySource":"wikivoyage","wikivoyageTitle":"en:Balkh"},{"id":"balkh_wv_tepe_i_rustam","areaId":"balkh","name":"Tepe-i Rustam","category":"landmark","tags":["photo"],"location":{"lat":36.7467,"lng":66.8974},"visitMinutes":60,"priceLevel":1,"photoSeed":"balkh_wv_tepe_i_rustam","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-24"},"hashtags":["tepeirustam","balkh"],"summary":"Remains of a Buddhist stupa. Accounts of Chinese Buddhist monk and traveler Xuanzang, who visited Balkh in 630 AD, indicate the existence of a significant number of Buddhist monasteries in the city.","summarySource":"wikivoyage","wikivoyageTitle":"en:Balkh"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}