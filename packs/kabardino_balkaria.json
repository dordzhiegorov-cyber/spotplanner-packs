mbukan","kabardinobalkaria"],"bestLight":"golden","summary":"Tambukan Lake is a lake with bitter-salt water on Northern Caucasus in Stavropol Krai and the Kabardino-Balkar Republic of Russia, located eight kilometers from Pyatigorsk. The lake's surface area is 1.87 square kilometers, and its depth ranges between 1.5 and 3.1 meters.","summarySource":"wikipedia","wikipediaTitle":"Lake Tambukan","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/4/4e/%D0%9E%D0%B7%D0%B5%D1%80%D0%BE_%D0%A2%D0%B0%D0%BC%D0%B1%D1%83%D0%BA%D0%B0%D0%BD.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/4/4e/%D0%9E%D0%B7%D0%B5%D1%80%D0%BE_%D0%A2%D0%B0%D0%BC%D0%B1%D1%83%D0%BA%D0%B0%D0%BD.jpg","w":1200,"h":800,"author":"Pupsoid","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:%D0%9E%D0%B7%D0%B5%D1%80%D0%BE_%D0%A2%D0%B0%D0%BC%D0%B1%D1%83%D0%BA%D0%B0%D0%BD.jpg"}},{"id":"kabardino_balkaria_janga","areaId":"kabardino_balkaria","name":"Janga","category":"viewpoint","tags":["mountains","views","hiking"],"location":{"lat":43.01806,"lng":43.05806},"visitMinutes":180,"priceLevel":0,"photoSeed":"kabardino_balkaria_janga","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":0,"wikiPageviews":540,"wikidataSitelinks":27,"fetchedAt":"2026-10-25"},"hashtags":["janga","kabardinobalkaria"],"bestLight":"sunset","summary":"Janga or Jangi-Tau or Dzhangi-Tau is a summit in the central part of the Greater Caucasus Mountain Range.","summarySource":"wikipedia","wikipediaTitle":"Janga (mountain)"},{"id":"kabardino_balkaria_baksan_hydroelectric_power_station","areaId":"kabardino_balkaria","name":"Baksan Hydroelectric Power Station","category":"monument","tags":["history","photo"],"location":{"lat":43.65511,"lng":43.39691},"visitMinutes":30,"priceLevel":0,"photoSeed":"kabardino_balkaria_baksan_hydroelectric_power_station","tickets":[],"signals":{"commonsDepicts":6,"commonsNearby":0,"wikiPageviews":260,"wikida