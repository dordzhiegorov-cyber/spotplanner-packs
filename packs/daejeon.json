onaquarium","daejeon"],"hours":{"week":[null,null,{"open":"10:00","close":"19:00"},null,null,null,null],"note":"Closed Mon, Tue, Thu, Fri, Sat, Sun"},"summary":"It is the first and largest freshwater fish aquarium in Korea, where you can see various freshwater fish from other countries and decorated fish by theme.","summarySource":"wikivoyage","wikivoyageTitle":"en:Daejeon"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}