":42.6821},"visitMinutes":60,"priceLevel":1,"photoSeed":"gorokhovets_dom_krasnoshchekova","tickets":[],"signals":{"commonsDepicts":2,"commonsNearby":26,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["домкраснощёкова","gorokhovets"],"names":{"ru":"Дом жилой"},"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Gorokhovets_PushkinskyLane1_019_1227.jpg/1280px-Gorokhovets_PushkinskyLane1_019_1227.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Gorokhovets_PushkinskyLane1_019_1227.jpg/500px-Gorokhovets_PushkinskyLane1_019_1227.jpg","w":1200,"h":800,"author":"Ludvig14","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Gorokhovets_PushkinskyLane1_019_1227.jpg"}},{"id":"gorokhovets_wv_kafe_sultan","areaId":"gorokhovets","name":"Кафе «Султан»","category":"food","tags":["food"],"location":{"lat":56.19833,"lng":42.66683},"visitMinutes":75,"photoSeed":"gorokhovets_wv_kafe_sultan","tickets":[],"signals":{},"hashtags":["кафесултан","gorokhovets"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Кафе находится далеко от центра города, по дороге к Лысой горе. У тех, кому удаётся здесь перекусить, остаются очень хорошие впечатления и от качества еды, и от радушного обслуживания. Хозяин кафе, турецкий курд Юсуф, сам встречает гостей и сам же готовит, и знает своё дело на отлично. Одна беда – в будни он гостей не ждёт и продуктов может просто не оказаться. Но перед визитом можно позвонить и з","summarySource":"wikivoyage","wikivoyageTitle":"ru:Гороховец"},{"id":"gorokhovets_wv_staryy_gorod","areaId":"gorokhovets","name":"Старый город","category":"food","tags":["food"],"location":{"lat":56.20744,"lng":42.68015},"visitMinutes":75,"photoSeed":"gorokhovets_wv_staryy_gorod","tickets":[],"signals":{},"hashtags":["старыйгород","gorokhovets"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Кафе – а по виду обычная столовая – находится на территории местного рынка, рядом со Сретенским монастырём. Меню написано хоть и на бланке, но от руки, и разнообразием не блещет. Самые «роскошные» блюда стоят ~150 рублей (2023), но на качество еды посетители не жалуются, а некоторые даже нахваливают.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Гороховец"},{"id":"gorokhovets_wv_izba","areaId":"gorokhovets","name":"Изба","category":"food","tags":["food"],"location":{"lat":56.20688,"lng":42.67845},"visitMinutes":75,"photoSeed":"gorokhovets_wv_izba","tickets":[],"signals":{},"hashtags":["избаgorokhovets","gorokhovets"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Очень простое кафе, а точнее столовая. Еда простая, но вкусная и качественная. К сожалению, не бывает постных блюд, за исключением овощных гарниров. Солянка, мясо по-французски. По будням – единственное место, где можно пообедать после 15 часов, все остальные закрыты. Есть летняя веранда.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Гороховец"},{"id":"gorokhovets_wv_dom_roll","areaId":"gorokhovets","name":"Дом Ролл","category":"food","tags":["food"],"location":{"lat":56.2071,"lng":42.67725},"visitMinutes":75,"photoSeed":"gorokhovets_wv_dom_roll","tickets":[],"signals":{},"hashtags":["домролл","gorokhovets"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Хорошее недорогое кафе прямо в центре города. Быстрое обслуживание, качественная еда, разнообразное меню. Подходит для полноценного обеда или ужина, и по соотношению/качество уверенно обходит все остальные местные кафе.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Гороховец"},{"id":"gorokhovets_wv_kafe_m7","areaId":"gorokhovets","name":"Кафе М7","category":"food","tags":["food"],"location":{"lat":56.19783,"lng":42.70187},"visitMinutes":75,"photoSeed":"gorokhovets_wv_kafe_m7","tickets":[],"signals":{},"hashtags":["кафем7","gorokhovets"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Неплохое кафе при одноимённом мотеле. Обстановка придорожная, но еда вкусная. Примечательным является факт расположения кафе и мотеля в историческом доме Кучина.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Гороховец"},{"id":"gorokhovets_wv_burger_u_gory","areaId":"gorokhovets","name":"Бургер у Горы","category":"food","tags":["food"],"location":{"lat":56.20233,"lng":42.69032},"visitMinutes":75,"photoSeed":"gorokhovets_wv_burger_u_gory","tickets":[],"signals":{},"hashtags":["бургеругоры","gorokhovets"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Судя по названию и месту дислокации, кафе может пригодиться любителям горных лыж. Фаст-фуд, стейки, салаты, выпечка, напитки – всё это в небольшой палатке.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Гороховец"},{"id":"gorokhovets_wv_chaykhana_u_klyazmy","areaId":"gorokhovets","name":"Чайхана у Клязьмы","category":"food","tags":["food"],"location":{"lat":56.20662,"lng":42.67727},"visitMinutes":75,"photoSeed":"gorokhovets_wv_chaykhana_u_klyazmy","tickets":[],"signals":{},"hashtags":["чайханауклязьмы","gorokhovets"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Недорогое кафе русской и узбекской кухни в самом центре города. Выглядит бюджетно, но чисто. Еда простая, но вкусная, обслуживание доброжелательное.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Гороховец"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}