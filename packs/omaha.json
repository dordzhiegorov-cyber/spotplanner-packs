":"09:00","close":"20:00"},{"open":"09:00","close":"20:00"},{"open":"09:00","close":"20:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"}]},"summary":"Omaha Central Library is a public library in Omaha, Nebraska, United States. It is the main branch of the Omaha Public Library system. The four-story library was designed by Omaha-based HDR, Inc. and Alley Poyner Marchietto. Omaha Central Library features local artwork around the building.","summarySource":"wikipedia","wikipediaTitle":"Omaha Central Library","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Omaha_Central_Library_-_North_Side_-_Opening_Day_2026-04-19.jpg/1280px-Omaha_Central_Library_-_North_Side_-_Opening_Day_2026-04-19.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Omaha_Central_Library_-_North_Side_-_Opening_Day_2026-04-19.jpg/500px-Omaha_Central_Library_-_North_Side_-_Opening_Day_2026-04-19.jpg","w":1200,"h":904,"author":"David C. Bradley","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Omaha_Central_Library_-_North_Side_-_Opening_Day_2026-04-19.jpg"}},{"id":"omaha_nash_block","areaId":"omaha","name":"Nash Block","category":"landmark","tags":["history","photo"],"location":{"lat":41.2578,"lng":-95.9283},"visitMinutes":45,"priceLevel":0,"photoSeed":"omaha_nash_block","tickets":[],"signals":{"commonsDepicts":2,"commonsNearby":23,"wikiPageviews":60,"wikidataSitelinks":2,"fetchedAt":"2026-10-19"},"hashtags":["nashblock","omaha"],"bestLight":"morning","summary":"Nash Block, historically known as the McKesson-Robbins Warehouse, is a historic building located at 902-912 Farnam Street in Omaha, Nebraska. Designed by Thomas R. Kimball and built from 1905 to 1907, the building is the last remnant of Downtown Omaha's Jobbers Canyon.","summarySource":"wikipedia","wikipediaTitle":"Nash Block","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/c/cb/Nash_Block%2C_Farnam_Street_Omaha%2C_Nebraska..jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/c/cb/Nash_Block%2C_Farnam_Street_Omaha%2C_Nebraska..jpg","w":1200,"h":884,"author":"pjw","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Nash_Block,_Farnam_Street_Omaha,_Nebraska..jpg"}},{"id":"omaha_christian_specht_building","areaId":"omaha","name":"Christian Specht Building","category":"landmark","tags":["history","photo"],"location":{"lat":41.25894,"lng":-95.93109},"visitMinutes":45,"priceLevel":0,"photoSeed":"omaha_christian_specht_building","tickets":[{"vendor":"Official","url":"https://www.museumofshadows.com/","official":true}],"signals":{"commonsDepicts":1,"commonsNearby":26,"wikiPageviews":52,"wikidataSitelinks":2,"fetchedAt":"2026-10-19"},"hashtags":["christianspechtbuilding","omaha"],"bestLight":"morning","summary":"The Christian Specht Building is located at 1110 Douglas Street in Downtown Omaha, Nebraska, United States. It is the only existing building with a cast-iron facade known in Nebraska today, and one of the few ever built in the state.","summarySource":"wikipedia","wikipediaTitle":"Christian Specht Building","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/9/99/Specht_building_%28Omaha%29_from_S_1.JPG","thumb":"https://upload.wikimedia.org/wikipedia/commons/9/99/Specht_building_%28Omaha%29_from_S_1.JPG","w":1200,"h":2143,"author":"Ammodramus","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Specht_building_(Omaha)_from_S_1.JPG"}},{"id":"omaha_charles_schwab_field","areaId":"omaha","name":"Charles Schwab Field","category":"other","tags":["family"],"location":{"lat":41.267,"lng":-95.932},"visitMinutes":90,"priceLevel":2,"photoSeed":"omaha_charles_schwab_field","tickets":[{"vendor":"Official","url":"http://www.tdameritradeparkomaha.com/","official":true}],"signals":{"commonsDepicts":23,"commonsNearby":1,"wikiPageviews":680,"wikidataSitelinks":4,"fetchedAt":"2026-10-19"},"hashtags":["charlesschwabfield","omaha"],"summary":"Charles Schwab Field Omaha is a ballpark in Omaha, Nebraska, United States. Opened in 2011, the city-owned stadium replaced the historic Johnny Rosenblatt Stadium, which was about two miles (3 km) south. The diamond is aligned southeast at an approximate elevation of 1,010 feet (310 m) above sea level.","summarySource":"wikipedia","wikipediaTitle":"Charles Schwab Field","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/65/TD_Ameritrade_Park_Omaha1.jpg/1280px-TD_Ameritrade_Park_Omaha1.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/65/TD_Ameritrade_Park_Omaha1.jpg/500px-TD_Ameritrade_Park_Omaha1.jpg","w":1200,"h":800,"author":"Skinzfan23","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:TD_Ameritrade_Park_Omaha1.jpg"}},{"id":"omaha_do_space","areaId":"omaha","name":"Do Space","category":"museum","tags":["museums","history","art"],"location":{"lat":41.25897,"lng":-96.02467},"visitMinutes":120,"priceLevel":2,"photoSeed":"omaha_do_space","tickets":[{"vendor":"Official","url":"http://dospace.org","official":true}],"signals":{"commonsDepicts":0,"commonsNearby":15,"wikiPageviews":84,"wikidataSitelinks":2,"fetchedAt":"2026-10-19"},"hashtags":["dospace","omaha"],"hours":{"week":[null,{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Closed Mon; Typical hours — check the official site"},"summary":"Do Space is a 501(c)(3) non-profit community technology center in Omaha, Nebraska, United States. The center's services include a digital library, an educational center, and small makerspace featuring 3D printing technology. The library opened in 2015.","summarySource":"wikipedia","wikipediaTitle":"Do Space","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/4/45/DoSpace_text.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/4/45/DoSpace_text.jpg","w":1200,"h":508,"author":"KIOS","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:DoSpace_text.jpg"}},{"id":"omaha_poppleton_block","areaId":"omaha","name":"Poppleton Block","category":"landmark","tags":["history","photo"],"location":{"lat":41.25726,"lng":-95.92914},"visitMinutes":45,"priceLevel":0,"photoSeed":"omaha_poppleton_block","tickets":[],"signals":{"commonsDepicts":2,"commonsNearby":30,"wikiPageviews":26,"wikidataSitelinks":2,"fetchedAt":"2026-10-19"},"hashtags":["poppletonblock","omaha"],"bestLight":"morning","summary":"The Poppleton Block is located at 1001 Farnam Street in Downtown Omaha, Nebraska. The building was built in 1880 for Omaha lawyer and politician A.J. Poppleton, and was designated an Omaha Landmark on July 13, 1982, and was listed on the National Register of Historic Places later that year.","summarySource":"wikipedia","wikipediaTitle":"Poppleton Block","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Poppleton_Block_2012-09-25_23-23-03.jpg/1280px-Poppleton_Block_2012-09-25_23-23-03.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Poppleton_Block_2012-09-25_23-23-03.jpg/500px-Poppleton_Block_2012-09-25_23-23-03.jpg","w":1200,"h":676,"author":"porterhse","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Poppleton_Block_2012-09-25_23-23-03.jpg"}},{"id":"omaha_barker_building","areaId":"omaha","name":"Barker Building","category":"landmark","tags":["history","photo"],"location":{"lat":41.25738,"lng":-95.93616},"visitMinutes":45,"priceLevel":0,"photoSeed":"omaha_barker_building","tickets":[{"vendor":"Official","url":"https://www.thebarkeromaha.com/","official":true}],"signals":{"commonsDepicts":6,"commonsNearby":22,"wikiPageviews":24,"wikidataSitelinks":2,"fetchedAt":"2026-10-19"},"hashtags":["barkerbuilding","omaha"],"bestLight":"morning","summary":"The Barker Building, a seven-story apartment building located at 306 South 15th Street in Downtown Omaha, Nebraska, United States. Built in 1929, it was listed on the National Register of Historic Places on July 2, 2008.","summarySource":"wikipedia","wikipediaTitle":"Barker Building","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Barker_Building_undergoing_renovation.jpg/1280px-Barker_Building_undergoing_renovation.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Barker_Building_undergoing_renovation.jpg/500px-Barker_Building_undergoing_renovation.jpg","w":1200,"h":900,"author":"MONGO","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Barker_Building_undergoing_renovation.jpg"}},{"id":"omaha_scottish_rite_cathedral","areaId":"omaha","name":"Scottish Rite Cathedral","category":"landmark","tags":["history","photo"],"location":{"lat":41.25833,"lng":-95.94281},"visitMinutes":45,"priceLevel":0,"photoSeed":"omaha_scottish_rite_cathedral","tickets":[{"vendor":"Official","url":"https://www.scottishriteomaha.org","official":true}],"signals":{"commonsDepicts":0,"commonsNearby":15,"wikiPageviews":43,"wikidataSitelinks":2,"fetchedAt":"2026-10-19"},"hashtags":["scottishritecathedral","omaha"],"bestLight":"morning","summary":"The Scottish Rite Cathedral is a Masonic building in Omaha in the state of Nebraska in the Midwestern United States. Begun in 1912 and opened in 1914, it remains in use by the Scottish Rite.","summarySource":"wikipedia","wikipediaTitle":"Scottish Rite Cathedral (Omaha, Nebraska)","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/Scottish_Rite_Cathedral_%28Omaha%29_from_NE_