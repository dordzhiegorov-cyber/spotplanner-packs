l Flower Cave","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f9/View_from_The_Animal_Flower_Cave%2C_Barbados_%286807814333%29.jpg/1280px-View_from_The_Animal_Flower_Cave%2C_Barbados_%286807814333%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f9/View_from_The_Animal_Flower_Cave%2C_Barbados_%286807814333%29.jpg/500px-View_from_The_Animal_Flower_Cave%2C_Barbados_%286807814333%29.jpg","w":1200,"h":845,"author":"Berit from Redhill/Surrey, UK","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:View_from_The_Animal_Flower_Cave,_Barbados_(6807814333).jpg"}},{"id":"barbados_needham_s_point_lighthouse","areaId":"barbados","name":"Needham's Point Lighthouse","category":"landmark","tags":["sea","views","photo"],"location":{"lat":13.07861,"lng":-59.61094},"visitMinutes":30,"priceLevel":0,"photoSeed":"barbados_needham_s_point_lighthouse","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":10,"wikiPageviews":58,"wikidataSitelinks":6,"fetchedAt":"2026-10-13"},"hashtags":["needhamspointlighthouse","barbados"],"bestLight":"sunset","summary":"Needham's Point Lighthouse is a lighthouse located in the southwest coast of Barbados.","summarySource":"wikipedia","wikipediaTitle":"Needham's Point Lighthouse","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/5/52/NEEDHAM%27S_POINT_LIGHTHOUSE_-_BARBADOS.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/5/52/NEEDHAM%27S_POINT_LIGHTHOUSE_-_BARBADOS.jpg","w":1200,"h":1368,"author":"JERRYE AND ROY KLOTZ MD","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:NEEDHAM%27S_POINT_LIGHTHOUSE_-_BARBADOS.jpg"}},{"id":"barbados_charles_fort","areaId":"barbados","name":"Charles Fort","category":"monument","tags":["history","views"],"location":{"lat":13.0789,"lng":-59.6127},"visitMinutes":90,"priceLevel":1,"photoSeed":"b