BC Highway and Highway 5.","summarySource":"wikipedia","wikipediaTitle":"Emancipation Statue","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a6/Bussa_statue.png","thumb":"https://upload.wikimedia.org/wikipedia/commons/a/a6/Bussa_statue.png","w":1200,"h":1606,"author":"Dogfacebob","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Bussa_statue.png"}},{"id":"barbados_kensington_oval","areaId":"barbados","name":"Kensington Oval","category":"other","tags":["family"],"location":{"lat":13.105,"lng":-59.6225},"visitMinutes":90,"priceLevel":2,"photoSeed":"barbados_kensington_oval","tickets":[{"vendor":"Official","url":"http://www.kensingtonoval.org/","official":true}],"signals":{"commonsDepicts":27,"commonsNearby":4,"wikiPageviews":2264,"wikidataSitelinks":22,"fetchedAt":"2026-10-13"},"hashtags":["kensingtonoval","barbados"],"summary":"The Kensington Oval is a stadium located in the western part of Bridgetown, Barbados. It is the pre-eminent sporting facility on the island and is primarily used for cricket. It has hosted many important cricket games between local, regional, and international teams during its more than 120-year history.","summarySource":"wikipedia","wikipediaTitle":"Kensington Oval","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/3/38/Kensington_Oval_yes.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/3/38/Kensington_Oval_yes.jpg","w":1200,"h":900,"author":"subzi73","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Kensington_Oval_yes.jpg"}},{"id":"barbados_chamberlain_bridge","areaId":"barbados","name":"Chamberlain Bridge","category":"landmark","tags":["views","photo","sunset"],"location":{"lat":13.09583,"lng":-59.61389},"visitMinutes":30,"priceLevel":0,"photoSeed":"barbados_chamberlain_bridge","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby