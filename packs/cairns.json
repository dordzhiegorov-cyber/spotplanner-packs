ikipedia/commons/4/42/Cairns_Customs_House_%282015%29.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/4/42/Cairns_Customs_House_%282015%29.jpg","w":1200,"h":900,"author":"Mary Howells (Heritage branch staff)","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Cairns_Customs_House_(2015).jpg"}},{"id":"cairns_cairns_botanic_gardens","areaId":"cairns","name":"Cairns Botanic Gardens","category":"park","tags":["nature","photo"],"location":{"lat":-16.8994,"lng":145.74837},"visitMinutes":75,"priceLevel":1,"photoSeed":"cairns_cairns_botanic_gardens","tickets":[{"vendor":"Official","url":"https://www.cairns.qld.gov.au/experience-cairns/botanic-gardens","official":true}],"signals":{"commonsDepicts":54,"commonsNearby":1371,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["cairnsbotanicgardens","cairns"],"hours":{"week":[{"open":"07:30","close":"17:30"},{"open":"07:30","close":"17:30"},{"open":"07:30","close":"17:30"},{"open":"07:30","close":"17:30"},{"open":"07:30","close":"17:30"},{"open":"07:30","close":"17:30"},{"open":"07:30","close":"17:30"}]},"bestLight":"golden","summary":"The Cairns Botanic Gardens are about 4 km from the city centre, and a number of bus routes pass by the various entrances. The Gardens are divided into 5 distinct zones, including Formal Gardens, Rainforest Boardwalk and Mangroves Boardwalk.","summarySource":"wikivoyage","wikivoyageTitle":"Cairns","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Cairns_Botanic_Gardens%2C_Edge_Hill%2C_2018_01.jpg/1280px-Cairns_Botanic_Gardens%2C_Edge_Hill%2C_2018_01.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Cairns_Botanic_Gardens%2C_Edge_Hill%2C_2018_01.jpg/500px-Cairns_Botanic_Gardens%2C_Edge_Hill%2C_2018_01.jpg","w":1200,"h":675,"author":"Kerry Raymond","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia