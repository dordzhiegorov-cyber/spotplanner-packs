ia.jpg/1280px-Parque_Cret%C3%A1cico_Sucre_Bolivia.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Parque_Cret%C3%A1cico_Sucre_Bolivia.jpg/500px-Parque_Cret%C3%A1cico_Sucre_Bolivia.jpg","w":1200,"h":652,"author":"Sean Mulry","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Parque_Cret%C3%A1cico_Sucre_Bolivia.jpg"}},{"id":"sucre_wv_museo_del_tesoro","areaId":"sucre","name":"Museo del Tesoro","category":"museum","tags":["museums"],"location":{"lat":-19.04718,"lng":-65.25946},"visitMinutes":120,"priceLevel":2,"photoSeed":"sucre_wv_museo_del_tesoro","tickets":[{"vendor":"Official","url":"http://museodeltesoro.com","official":true}],"signals":{"commonsNearby":54,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["museodeltesoro","sucre"],"hours":{"week":[{"open":"09:00","close":"18:30"},{"open":"09:00","close":"18:30"},{"open":"09:00","close":"18:30"},{"open":"09:00","close":"18:30"},{"open":"09:00","close":"18:30"},{"open":"09:00","close":"18:30"},{"open":"09:00","close":"18:30"}]},"summary":"The museum's valuable collections show the history of silver and gold in Bolivia, and the evolution of the famous jewelry from Sucre. The museum has a section dedicated to the mining and jewelry of the “ametrine”, a beautiful gem that only exists in Bolivia. The museum also has a store with some good values.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/7th_Coloquio.jpg/1280px-7th_Coloquio.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/7th_Coloquio.jpg/500px-7th_Coloquio.jpg","w":1200,"h":811,"author":"ECORFAN-Mexico, S.C.","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:7th_Coloquio.jpg"}},{"id":"sucre_templo_de_san_lazaro","areaId":"sucre","name":"Templo de San Lázaro","category":"monument","tags":["history","photo"],"location":{"lat":-19.05082,"lng":-65.25464},"visitMinutes":45,"priceLevel":0,"photoSeed":"sucre_templo_de_san_lazaro","tickets":[],"signals":{"commonsDepicts":2,"commonsNearby":9,"wikidataSitelinks":2,"fetchedAt":"2026-10-23"},"hashtags":["templodesanlazaro","sucre"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"}],"note":"Typical hours — check the official site"},"summary":"The oldest surviving church in Bolivia, built in 1544.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/Templo_de_San_L%C3%A1zaro_Sucre-Bolivia.jpg/1280px-Templo_de_San_L%C3%A1zaro_Sucre-Bolivia.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/Templo_de_San_L%C3%A1zaro_Sucre-Bolivia.jpg/500px-Templo_de_San_L%C3%A1zaro_Sucre-Bolivia.jpg","w":1200,"h":1495,"author":"Ev.anabelc","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Templo_de_San_L%C3%A1zaro_Sucre-Bolivia.jpg"}},{"id":"sucre_wv_museo_de_arte_indigena_asur","areaId":"sucre","name":"Museo de Arte Indígena ASUR","category":"museum","tags":["museums"],"location":{"lat":-19.0539,"lng":-65.25379},"visitMinutes":120,"priceLevel":2,"photoSeed":"sucre_wv_museo_de_arte_indigena_asur","tickets":[],"signals":{"commonsNearby":42,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["museodearteindigenaasur","sucre"],"hours":{"week":[null,{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Closed Mon; Typical hours — check the official site"},"summary":"Displays various art forms of the indigenous groups in the region. Quite interesting. Everything is translated to English in a booklet offered by the staff. Make sure you drink enough coffee because there is a lot of information to read.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_osm_mirador_recoleta","areaId":"sucre","name":"Mirador Recoleta","category":"viewpoint","tags":["views","photo","sunset"],"location":{"lat":-19.05432,"lng":-65.25424},"visitMinutes":45,"priceLevel":0,"photoSeed":"sucre_osm_mirador_recoleta","tickets":[],"signals":{"commonsNearby":42,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["miradorrecoleta","sucre"],"bestLight":"sunset"},{"id":"sucre_parque_simon_bolivar_sucre","areaId":"sucre","name":"Parque Simón Bolívar, Sucre","category":"park","tags":["nature","photo"],"location":{"lat":-19.0419,"lng":-65.26437},"visitMinutes":60,"priceLevel":0,"photoSeed":"sucre_parque_simon_bolivar_sucre","tickets":[],"signals":{"commonsDepicts":1,"commonsNearby":5,"wikidataSitelinks":2,"fetchedAt":"2026-10-23"},"hashtags":["parquesimonbolivarsucre","sucre"],"bestLight":"golden","summary":"Take a stroll in the park, the city's favourite lovers' hangout. Just don't step on the grass. You can watch people (nice people there), watch street performances, eat. People have their small Eiffel tower there, just next is a big playing park for kids. At the upper end of Parque Bolivar stands Bolivia's supreme court. At the lower end is Estacion Aniceto Arce, Sucre's train station which is not ","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre","names":{"es":"Parque Simón Bolívar"},"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Triomfboog_parque_bolivar.jpg/1280px-Triomfboog_parque_bolivar.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Triomfboog_parque_bolivar.jpg/500px-Triomfboog_parque_bolivar.jpg","w":1200,"h":900,"author":"BraveNewWorld at nl.wikipedia","license":"CC BY-SA 2.0 be","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0/be/deed.en","page":"https://commons.wikimedia.org/wiki/File:Triomfboog_parque_bolivar.jpg"}},{"id":"sucre_wv_mercado_central","areaId":"sucre","name":"Mercado Central","category":"market","tags":["markets","food"],"location":{"lat":-19.04534,"lng":-65.25849},"visitMinutes":60,"priceLevel":0,"photoSeed":"sucre_wv_mercado_central","tickets":[],"signals":{"commonsNearby":17,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["mercadocentral","sucre"],"hours":{"week":[{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},null],"note":"Closed Sun; Typical hours — check the official site"},"bestLight":"morning","summary":"Big market selling food, produce, and other products, from birthday cakes to potatoes to candles to cow snouts. Wide variety of fresh fruit, and some stands near the back selling different kinds of fresh juice.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Mesa_28_Objetos_en_el_espacio_la_plata%2C_siglos_XVI-XVIII_%E2%80%93_D-1_XII_Congreso_AEB_02.jpg/1280px-Mesa_28_Objetos_en_el_espacio_la_plata%2C_siglos_XVI-XVIII_%E2%80%93_D-1_XII_Congreso_AEB_02.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Mesa_28_Objetos_en_el_espacio_la_plata%2C_siglos_XVI-XVIII_%E2%80%93_D-1_XII_Congreso_AEB_02.jpg/500px-Mesa_28_Objetos_en_el_espacio_la_plata%2C_siglos_XVI-XVIII_%E2%80%93_D-1_XII_Congreso_AEB_02.jpg","w":1200,"h":584,"author":"Vanett Graneros","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Mesa_28_Objetos_en_el_espacio_la_plata,_siglos_XVI-XVIII_%E2%80%93_D-1_XII_Congreso_AEB_02.jpg"}},{"id":"sucre_wv_fuente_del_bicentenario","areaId":"sucre","name":"Fuente del Bicentenario","category":"landmark","tags":["photo"],"location":{"lat":-19.04115,"lng":-65.26529},"visitMinutes":60,"priceLevel":1,"photoSeed":"sucre_wv_fuente_del_bicentenario","tickets":[],"signals":{"commonsNearby":2,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["fuentedelbicentenario","sucre"],"summary":"Tourist attraction with water, lights, and sound, making the water look like it changes color and moves to the music. Located in Parque Bolívar.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Parque_Sim%C3%B3n_Bol%C3%ADvar%2C_Sucre.jpg/1280px-Parque_Sim%C3%B3n_Bol%C3%ADvar%2C_Sucre.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Parque_Sim%C3%B3n_Bol%C3%ADvar%2C_Sucre.jpg/500px-Parque_Sim%C3%B3n_Bol%C3%ADvar%2C_Sucre.jpg","w":1200,"h":900,"author":"Mx._Granger","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Parque_Sim%C3%B3n_Bol%C3%ADvar,_Sucre.jpg"}},{"id":"sucre_wv_florin","areaId":"sucre","name":"Florin","category":"food","tags":["food"],"location":{"lat":-19.04923,"lng":-65.25847},"visitMinutes":75,"priceLevel":2,"photoSeed":"sucre_wv_florin","tickets":[{"vendor":"Official","url":"https://www.facebook.com/Cafe.Florin?ref=ts&fref=ts","official":true}],"signals":{},"hashtags":["florinsucre","sucre"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Serves a mix of Bolivian and international dishes, including shwarma, Thai and an Indonesian feast for two (or more). Great coffee, fantastic krocetten and good fast WiFi. Also doubles as a bar with live music. Cosy and great atmosphere, though it's reputed by some locals as the source of a few food poisoning cases. Nightly happy hour from 17:30 to 22:30 offers two-for-one drinks and a regular cro","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_cafe_monterosso","areaId":"sucre","name":"Cafe Monterosso","category":"food","tags":["food"],"location":{"lat":-19.04958,"lng":-65.25371},"visitMinutes":75,"priceLevel":3,"photoSeed":"sucre_wv_cafe_monterosso","tickets":[],"signals":{},"hashtags":["cafemonterosso","sucre"],"hours":{"week":[{"open":"19:00","close":"22:00"},{"open":"19:00","close":"22:00"},{"open":"19:00","close":"22:00"},{"open":"19:00","close":"22:00"},{"open":"19:00","close":"22:00"},{"open":"19:00","close":"22:00"},null],"note":"Closed Sun"},"summary":"A hidden gem, and the best Italian restaurant in town. Almost pathologically averse to advertising (the signage is a 30-cm plaque next to the front door, which is kept closed - ring the bell), but nevertheless very popular among those in the know. Roberto is an exceptionally friendly host, and the food is delicious and inventive. It's a good idea to book a table, as the place fills up quickly.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_bibliocafe","areaId":"sucre","name":"Bibliocafe","category":"cafe","tags":["cafes"],"location":{"lat":-19.04928,"lng":-65.25988},"visitMinutes":45,"photoSeed":"sucre_wv_bibliocafe","tickets":[],"signals":{},"hashtags":["bibliocafesucre","sucre"],"hours":{"week":[{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"}],"note":"Typical hours — check the official site"},"bestLight":"morning","summary":"Near the Joy Ride Cafe got mixed drinks at moderate prices. Also one of the few places in Sucre to serve Taquina Amber, one of Bolivia's best brews. Plays classic rock and pop. Also serves food. There are actually two Bibliocafes: Bibliocafe is more relaxed and intimate; Bibliocafe 'Concert' has some live music and is more energetic.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_condor_cafe","areaId":"sucre","name":"Condor Cafe","category":"food","tags":["food"],"location":{"lat":-19.04852,"lng":-65.25766},"visitMinutes":75,"priceLevel":1,"photoSeed":"sucre_wv_condor_cafe","tickets":[],"signals":{},"hashtags":["condorcafe","sucre"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Good selection of food and drinks (including specialties like stuffed potato and quinoa beer), middle-priced, very nice atmosphere. Local tourism agency Condor Trekkers works from there, so you can meet the guys (very friendly) and discuss with them different options for exploring Sucre surroundings.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_el_germen","areaId":"sucre","name":"El Germen","category":"food","tags":["food"],"location":{"lat":-19.04813,"lng":-65.2566},"visitMinutes":75,"priceLevel":2,"photoSeed":"sucre_wv_el_germen","tickets":[{"vendor":"Official","url":"https://el-germen.negocio.site/","official":true}],"signals":{},"hashtags":["elgermen","sucre"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Serves a fusion of delicious Bolivian and German cooking. All lunch specials (Bs.20) are vegetarian, but you can order meat dishes from the menu (menu dishes take a lot longer to come). Also has great desserts. The restaurant fills up quickly for lunch, so arrive early.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_restaurante_new_hong_kong","areaId":"sucre","name":"Restaurante New Hong Kong","category":"food","tags":["food"],"location":{"lat":-19.0425,"lng":-65.2649},"visitMinutes":75,"priceLevel":3,"photoSeed":"sucre_wv_restaurante_new_hong_kong","tickets":[],"signals":{},"hashtags":["restaurantenewhongkong","sucre"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Decent Chinese food (by Bolivian standards); popular with both locals and tourists. No vegetarian options, but if you're lucky and/or charming enough, they can sometimes be persuaded to throw something together. Advertises delivery, but in practice refuses to deliver.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_goblin_bar_y_cerveceria","areaId":"sucre","name":"Goblin Bar y Cerveceria","category":"nightlife","tags":["nightlife"],"location":{"lat":-19.05033,"lng":-65.25715},"visitMinutes":90,"photoSeed":"sucre_wv_goblin_bar_y_cerveceria","tickets":[{"vendor":"Official","url":"http://www.goblin.soysucre.info/","official":true}],"signals":{},"hashtags":["goblinbarycerveceria","sucre"],"hours":{"week":[null,null,null,{"open":"20:00","close":"23:59"},{"open":"20:00","close":"23:59"},{"open":"20:00","close":"23:59"},null],"note":"Closed Mon, Tue, Wed, Sun"},"bestLight":"night","summary":"Cozy bar that is Sucre's temple to beer. Gung-ho servers are happy to chat about beer styles and flavors. Artesanal craft beers are made in-house, but there are usually only a handful of beers available at any given time, mostly basic ale styles.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_la_taverna","areaId":"sucre","name":"La Taverna","category":"food","tags":["food"],"location":{"lat":-19.04677,"lng":-65.25933},"visitMinutes":75,"priceLevel":3,"photoSeed":"sucre_wv_la_taverna","tickets":[{"vendor":"Official","url":"http://lataverne.com.bo/","official":true}],"signals":{},"hashtags":["lataverna","sucre"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"In the courtyard of the Alliance Francaise. Good French inspired food but using local ingredients and wine. Good continental breakfast at Bs. 20, but the place was rarely found open in the morning. Set menu for Bs. 45, from 12:00-15:00.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_la_posada","areaId":"sucre","name":"La Posada","category":"nightlife","tags":["nightlife"],"location":{"lat":-19.04922,"lng":-65.25878},"visitMinutes":90,"photoSeed":"sucre_wv_la_posada","tickets":[],"signals":{},"hashtags":["laposada","sucre"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"Just a few steps from the main square, the hotel La Posada offers a nice buffet every Sunday that is worth the Bs. 40. because of the vegetarian parts. Starts at 12:00, don't be too late, since it can be crowded.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_patio_de_comidas","areaId":"sucre","name":"Patio de Comidas","category":"food","tags":["food"],"location":{"lat":-19.04563,"lng":-65.25763},"visitMinutes":75,"priceLevel":1,"photoSeed":"sucre_wv_patio_de_comidas","tickets":[],"signals":{},"hashtags":["patiodecomidas","sucre"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"An outdoor cooked food center inside Parque Bolivar that is frequented by only locals. Mainly meat and pizza. There are two stalls very cheap food from Bs. 3 with vegetarian options, don't ask, just eat.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_novelle_cuisine","areaId":"sucre","name":"Novelle Cuisine","category":"food","tags":["food"],"location":{"lat":-19.05149,"lng":-65.25883},"visitMinutes":75,"priceLevel":3,"photoSeed":"sucre_wv_novelle_cuisine","tickets":[],"signals":{},"hashtags":["novellecuisine","sucre"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"This parilla is the best steak in town. Bs. 30 for a huge bife de chorizo with fries and salad bar. A must for meat eaters. Cheap wine to boot!","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_pizzeria_napoli","areaId":"sucre","name":"Pizzeria Napoli","category":"food","tags":["food"],"location":{"lat":-19.04803,"lng":-65.26064},"visitMinutes":75,"priceLevel":2,"photoSeed":"sucre_wv_pizzeria_napoli","tickets":[],"signals":{},"hashtags":["pizzerianapoli","sucre"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Great pizza. Prices range for Bs. 25 a (rather small) medium to Bs. 55 a big one. Open in the evenings only. Take-away and home delivery.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_el_alfarero","areaId":"sucre","name":"El Alfarero","category":"cafe","tags":["cafes"],"location":{"lat":-19.04712,"lng":-65.25507},"visitMinutes":45,"photoSeed":"sucre_wv_el_alfarero","tickets":[],"signals":{},"hashtags":["elalfarero","sucre"],"hours":{"week":[{"open":"17:00","close":"22:00"},{"open":"17:00","close":"22:00"},{"open":"17:00","close":"22:00"},{"open":"17:00","close":"22:00"},{"open":"17:00","close":"22:00"},{"open":"17:00","close":"22:00"},{"open":"17:00","close":"22:00"}]},"bestLight":"morning","summary":"University students run a cheap and cosy cafe with some board games and pingpong table. Also screens films. Students receive a discount.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_typica_cafe","areaId":"sucre","name":"Typica Cafe","category":"food","tags":["food"],"location":{"lat":-19.05151,"lng":-65.25987},"visitMinutes":75,"priceLevel":2,"photoSeed":"sucre_wv_typica_cafe","tickets":[{"vendor":"Official","url":"http://typicabolivia.com","official":true}],"signals":{},"hashtags":["typicacafe","sucre"],"hours":{"week":[{"open":"09:00","close":"20:00"},{"open":"09:00","close":"20:00"},{"open":"09:00","close":"20:00"},{"open":"09:00","close":"20:00"},{"open":"09:00","close":"20:00"},{"open":"09:00","close":"20:00"},{"open":"10:00","close":"20:00"}]},"summary":"A charming cafe with great music selection and a large courtyard. Lots of seating options for working and reading.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_pizzaria_napolitana","areaId":"sucre","name":"Pizzaría Napolitana","category":"food","tags":["food"],"location":{"lat":-19.04831,"lng":-65.25903},"visitMinutes":75,"priceLevel":2,"photoSee