,"summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"},{"id":"sucre_wv_menfis","areaId":"sucre","name":"Menfis","category":"nightlife","tags":["nightlife"],"location":{"lat":-19.04971,"lng":-65.25872},"visitMinutes":90,"photoSeed":"sucre_wv_menfis","tickets":[],"signals":{},"hashtags":["menfissucre","sucre"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"Warm up venue for young locals on weekends.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sucre"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}