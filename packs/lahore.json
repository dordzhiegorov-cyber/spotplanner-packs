wikimedia.org/wikipedia/commons/thumb/e/ef/Lahore_Museum%2C_Lahore.jpg/1280px-Lahore_Museum%2C_Lahore.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Lahore_Museum%2C_Lahore.jpg/500px-Lahore_Museum%2C_Lahore.jpg","w":1200,"h":843,"author":"Guilhem Vellut","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Lahore_Museum,_Lahore.jpg"}},{"id":"lahore_tomb_of_allama_iqbal","areaId":"lahore","name":"Tomb of Allama Iqbal","category":"monument","tags":["history","photo"],"location":{"lat":31.5879,"lng":74.3113},"visitMinutes":30,"priceLevel":0,"photoSeed":"lahore_tomb_of_allama_iqbal","tickets":[],"signals":{"commonsDepicts":2,"commonsNearby":93,"wikiPageviews":872,"wikidataSitelinks":13,"fetchedAt":"2026-10-19"},"hashtags":["tombofallamaiqbal","lahore"],"bestLight":"morning","summary":"The Tomb of Allama Iqbal or Mazar-e-Iqbal is the final resting place of Muhammad Iqbal, the national poet of Pakistan. Designed in the Mughal architectural style, the mausoleum is located next to the walls of the iconic Mughal-era Badshahi Mosque, within the Hazuri Bagh in Lahore, Punjab, Pakistan.","summarySource":"wikipedia","wikipediaTitle":"Tomb of Allama Iqbal","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Allama_Iqbals_Tomb_East_wall_close-up_July_1_2005.jpg/1280px-Allama_Iqbals_Tomb_East_wall_close-up_July_1_2005.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Allama_Iqbals_Tomb_East_wall_close-up_July_1_2005.jpg/500px-Allama_Iqbals_Tomb_East_wall_close-up_July_1_2005.jpg","w":1200,"h":904,"author":"Wikimedia Commons contributor","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Allama_Iqbals_Tomb_East_wall_close-up_July_1_2005.jpg"}},{"id":"lahore_sheesh_mahal","areaId":"lahore","name":"Sheesh Mahal","category":"landmark","tags":["history","phot