imedia.org/wikipedia/commons/thumb/2/26/Tomb_of_Jani_Khan%2C_Lahore.JPG/1280px-Tomb_of_Jani_Khan%2C_Lahore.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/Tomb_of_Jani_Khan%2C_Lahore.JPG/500px-Tomb_of_Jani_Khan%2C_Lahore.JPG","w":1200,"h":900,"author":"Musab Bin Noor","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Tomb_of_Jani_Khan,_Lahore.JPG"}},{"id":"lahore_fort_road","areaId":"lahore","name":"Fort Road","category":"landmark","tags":["oldtown","photo","shopping"],"location":{"lat":31.5866,"lng":74.3123},"visitMinutes":45,"priceLevel":0,"photoSeed":"lahore_fort_road","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":15,"wikiPageviews":46,"wikidataSitelinks":3,"fetchedAt":"2026-10-19"},"hashtags":["fortroad","lahore"],"bestLight":"golden","summary":"Fort Road, Lahore is a road in the Old Walled City of Lahore, Pakistan. It is one of Lahore's most famous and historically significant roads. It is so named because it flanks the Lahore Fort on its southern and eastern sides.","summarySource":"wikipedia","wikipediaTitle":"Fort Road, Lahore","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/9/92/Lahore_Fort.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/9/92/Lahore_Fort.jpg","w":1200,"h":1757,"author":"M. Umair","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Lahore_Fort.jpg"}},{"id":"lahore_shah_burj_gate","areaId":"lahore","name":"Shah Burj gate","category":"landmark","tags":["photo"],"location":{"lat":31.58934,"lng":74.3127},"visitMinutes":60,"priceLevel":1,"photoSeed":"lahore_shah_burj_gate","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":60,"wikidataSitelinks":0,"fetchedAt":"2026-10-19"},"hashtags":["shahburjgate","lahore"],"summary":"Decorated with colored tiles. Known as the \"Elephant Gate\" because royal elephants would enter h