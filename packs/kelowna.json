l":"https://www.kelowna.ca/parks-recreation/parks-beaches/parks-beaches-listing/boyce-gyro-beach-park","official":true}],"signals":{"commonsNearby":1,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["boycegyrobeachpark","kelowna"],"bestLight":"sunset","summary":"Enjoy the half submerged playground in summer by swimming and hanging out of the beach. You can let yourself slide along the rope into the lake within which you may come across our lake's resident the Ogopogo (we are not joking, Loch Ness isn't the only body of water with a lake monster [the term monster is used loosely]). If you see Ogopogo make sure to be friendly as it is his home you're swimmi","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg/1280px-Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg/500px-Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg","w":1200,"h":800,"author":"Jack Borno","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg"}},{"id":"kelowna_kelowna_rockets","areaId":"kelowna","name":"Kelowna Rockets","category":"landmark","tags":["photo"],"location":{"lat":49.8929,"lng":-119.4949},"visitMinutes":60,"priceLevel":1,"photoSeed":"kelowna_kelowna_rockets","tickets":[{"vendor":"Official","url":"https://kelownarockets.com/","official":true}],"signals":{"commonsDepicts":0,"commonsNearby":1,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["kelownarockets","kelowna"],"hours":{"week":[{"open":"09:30","close":"17:30"},{"open":"09:30","close":"17:30"},{"open":"09:30","close":"17:30"},{"open":"09:30","close":"17:30"},{"open":"09:30","close":"17:30"},{"open":"10:00","close":"16:00"},null],"note":"Closed Sun"},"summary":"The Rockets are the local team in the Western Hockey League (players are 16-20 years old). Tickets can be purchased online or through the box office at Prospera Place, their home arena.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/CN_Station%2C_north_side.JPG/1280px-CN_Station%2C_north_side.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/CN_Station%2C_north_side.JPG/500px-CN_Station%2C_north_side.JPG","w":1200,"h":900,"author":"Machegav","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:CN_Station,_north_side.JPG"}},{"id":"kelowna_wv_knox_mountain_park","areaId":"kelowna","name":"Knox Mountain Park","category":"park","tags":["nature","photo"],"location":{"lat":49.913,"lng":-119.483},"visitMinutes":60,"priceLevel":0,"photoSeed":"kelowna_wv_knox_mountain_park","tickets":[{"vendor":"Official","url":"https://www.kelowna.ca/parks-recreation/parks-beaches/parks-beaches-listing/knox-mountain-park","official":true}],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["knoxmountainpark","kelowna"],"hours":{"week":[{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"}]},"bestLight":"golden","summary":"Large park and natural area north of Kelowna's downtown. The view from the top has great views of the valley, including downtown Kelowna and Okanagan Lake. There is a road most of the way up with parking, that is open in the summer. There are also many trails for walking and biking that lead to other viewpoints and Paul's Tomb, the only beach in the park.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna"},{"id":"kelowna_wv_mission_creek_regional_park","areaId":"kelowna","name":"Mission Creek Regional Park","category":"park","tags":["nature","photo"],"location":{"lat":49.8777,"lng":-119.4298},"visitMinutes":60,"priceLevel":0,"photoSeed":"kelowna_wv_mission_creek_regional_park","tickets":[{"vendor":"Official","url":"https://www.kelowna.ca/parks-recreation/parks-beaches/parks-beaches-listing/mission-creek-regional-park","official":true}],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["missioncreekregionalpark","kelowna"],"bestLight":"golden","summary":"Park set on both sides of Mission Creek. The EECO Center has environment exhibits and park information. The creekside trail has a fish ladder, an old homestead site, interpretive signs and a playground/picnic area. Salmon return to the spawning channel in Sept-Oct each year.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna"},{"id":"kelowna_wv_h2o_adventure_and_fitness_center","areaId":"kelowna","name":"H2O Adventure and Fitness Center","category":"park","tags":["nature","photo"],"location":{"lat":49.83793,"lng":-119.48113},"visitMinutes":60,"priceLevel":0,"photoSeed":"kelowna_wv_h2o_adventure_and_fitness_center","tickets":[{"vendor":"Official","url":"https://www.kelowna.ca/parks-recreation/recreation-facilities/h2o-adventure-fitness-centre","official":true}],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["h2oadventureandfitnesscenter","kelowna"],"bestLight":"golden","summary":"H2O Adventure + Fitness Centre is the largest municipally owned water park in Canada and features an Olympic-length 50-m pool, wave pool, river run, 3 water slides, children's water play area, and an ocean wave surf simulator. And, for the fitness enthusiast, a 12,000-square-foot cardio, weight equipment and exercise space await you.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}