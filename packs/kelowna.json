6:00","close":"23:00"},{"open":"06:00","close":"23:00"}]},"bestLight":"golden","summary":"Waterfront park with some nice views. Notable for Bear Plaza and it's public art, and the outdoor skating rink in winter.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Kelowna_%28BC%2C_Canada%29%2C_Kelowna_Downtown_Marina_--_2022_--_201928.jpg/1280px-Kelowna_%28BC%2C_Canada%29%2C_Kelowna_Downtown_Marina_--_2022_--_201928.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Kelowna_%28BC%2C_Canada%29%2C_Kelowna_Downtown_Marina_--_2022_--_201928.jpg/500px-Kelowna_%28BC%2C_Canada%29%2C_Kelowna_Downtown_Marina_--_2022_--_201928.jpg","w":1200,"h":1200,"author":"Dietmar Rabich","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Kelowna_(BC,_Canada),_Kelowna_Downtown_Marina_--_2022_--_201928.jpg"}},{"id":"kelowna_wv_city_park","areaId":"kelowna","name":"City Park","category":"park","tags":["nature","photo"],"location":{"lat":49.8841,"lng":-119.5017},"visitMinutes":60,"priceLevel":0,"photoSeed":"kelowna_wv_city_park","tickets":[],"signals":{"commonsNearby":3,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["citypark","kelowna"],"bestLight":"golden","summary":"A great environment in the summer to sun tan, play and enjoy yourself, or be with your family at the playgrounds. The water and skate park offer a great time in the sun.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a5/Skinny_Dip%2C_Kelowna%2C_BC_%282407329528%29.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/a/a5/Skinny_Dip%2C_Kelowna%2C_BC_%282407329528%29.jpg","w":1200,"h":899,"author":"Art Improbable from Vancouver, Canada","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Skinny_Dip,_Kelowna,_BC_(2407329528).jpg"}},{"id":"kelowna_wv_boyce_gyro_beach_park","areaId":"kelowna","name":"Boyce-Gyro Beach Park","category":"beach","tags":["beach","sea","nature","sunset"],"location":{"lat":49.8549,"lng":-119.491},"visitMinutes":120,"priceLevel":0,"photoSeed":"kelowna_wv_boyce_gyro_beach_park","tickets":[{"vendor":"Official","url":"https://www.kelowna.ca/parks-recreation/parks-beaches/parks-beaches-listing/boyce-gyro-beach-park","official":true}],"signals":{"commonsNearby":1,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["boycegyrobeachpark","kelowna"],"bestLight":"sunset","summary":"Enjoy the half submerged playground in summer by swimming and hanging out of the beach. You can let yourself slide along the rope into the lake within which you may come across our lake's resident the Ogopogo (we are not joking, Loch Ness isn't the only body of water with a lake monster [the term monster is used loosely]). If you see Ogopogo make sure to be friendly as it is his home you're swimmi","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg/1280px-Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg/500px-Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg","w":1200,"h":800,"author":"Jack Borno","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Okanagan_Lake_-_Gyro_Beach_-_panoramio.jpg"}},{"id":"kelowna_kelowna_rockets","areaId":"kelowna","name":"Kelowna Rockets","category":"landmark","tags":["photo"],"location":{"lat":49.8929,"lng":-119.4949},"visitMinutes":60,"priceLevel":1,"photoSeed":"kelowna_kelowna_rockets","tickets":[{"vendor":"Official","url":"https://kelownarockets.com/","official":true}],"signals":{"commonsDepicts":0,"commonsNearby":1,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["kelownarockets","kelowna"],"hours":{"week":[{"open":"09:30","close":"17:30"},{"open":"09:30","close":"17:30"},{"open":"09:30","close":"17:30"},{"open":"09:30","close":"17:30"},{"open":"09:30","close":"17:30"},{"open":"10:00","close":"16:00"},null],"note":"Closed Sun"},"summary":"The Rockets are the local team in the Western Hockey League (players are 16-20 years old). Tickets can be purchased online or through the box office at Prospera Place, their home arena.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna","names":{"fr":"Rockets de Kelowna","ru":"Келоуна Рокетс","ja":"ケローナロケッツ"},"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/CN_Station%2C_north_side.JPG/1280px-CN_Station%2C_north_side.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/CN_Station%2C_north_side.JPG/500px-CN_Station%2C_north_side.JPG","w":1200,"h":900,"author":"Machegav","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:CN_Station,_north_side.JPG"}},{"id":"kelowna_wv_knox_mountain_park","areaId":"kelowna","name":"Knox Mountain Park","category":"park","tags":["nature","photo"],"location":{"lat":49.913,"lng":-119.483},"visitMinutes":60,"priceLevel":0,"photoSeed":"kelowna_wv_knox_mountain_park","tickets":[{"vendor":"Official","url":"https://www.kelowna.ca/parks-recreation/parks-beaches/parks-beaches-listing/knox-mountain-park","official":true}],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["knoxmountainpark","kelowna"],"hours":{"week":[{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"},{"open":"09:30","close":"21:00"}]},"bestLight":"golden","summary":"Large park and natural area north of Kelowna's downtown. The view from the top has great views of the valley, including downtown Kelowna and Okanagan Lake. There is a road most of the way up with parking, that is open in the summer. There are also many trails for walking and biking that lead to other viewpoints and Paul's Tomb, the only beach in the park.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna"},{"id":"kelowna_wv_mission_creek_regional_park","areaId":"kelowna","name":"Mission Creek Regional Park","category":"park","tags":["nature","photo"],"location":{"lat":49.8777,"lng":-119.4298},"visitMinutes":60,"priceLevel":0,"photoSeed":"kelowna_wv_mission_creek_regional_park","tickets":[{"vendor":"Official","url":"https://www.kelowna.ca/parks-recreation/parks-beaches/parks-beaches-listing/mission-creek-regional-park","official":true}],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["missioncreekregionalpark","kelowna"],"bestLight":"golden","summary":"Park set on both sides of Mission Creek. The EECO Center has environment exhibits and park information. The creekside trail has a fish ladder, an old homestead site, interpretive signs and a playground/picnic area. Salmon return to the spawning channel in Sept-Oct each year.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna"},{"id":"kelowna_wv_h2o_adventure_and_fitness_center","areaId":"kelowna","name":"H2O Adventure and Fitness Center","category":"park","tags":["nature","photo"],"location":{"lat":49.83793,"lng":-119.48113},"visitMinutes":60,"priceLevel":0,"photoSeed":"kelowna_wv_h2o_adventure_and_fitness_center","tickets":[{"vendor":"Official","url":"https://www.kelowna.ca/parks-recreation/recreation-facilities/h2o-adventure-fitness-centre","official":true}],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["h2oadventureandfitnesscenter","kelowna"],"bestLight":"golden","summary":"H2O Adventure + Fitness Centre is the largest municipally owned water park in Canada and features an Olympic-length 50-m pool, wave pool, river run, 3 water slides, children's water play area, and an ocean wave surf simulator. And, for the fitness enthusiast, a 12,000-square-foot cardio, weight equipment and exercise space await you.","summarySource":"wikivoyage","wikivoyageTitle":"Kelowna"},{"id":"kelowna_wv_the_vibrant_vine_okanagan_villa_estate_winery","areaId":"kelowna","name":"The Vibrant Vine / Okanagan Villa Estate Winery","category":"nightlife","tags":["nightlife"],"location":{"lat":49.8605,"lng":-119.4116},"visitMinutes":90,"photoSeed":"kelowna_wv_the_vibrant_vine_okanagan_villa_estate_winery","tickets":[{"vendor":"Official","url":"https://thevibrantvine.com/","official":true}],"signals":{},"hashtags":["thevibrantvineokanaganvillaestatewinery","kelowna"],"hours":{"week":[{"open":"11:00","close":"18:00"},{"open":"11:00","close":"18:00"},{"open":"11:00","close":"18:00"},{"open":"11:00","close":"18:00"},{"open":"11:00","close":"18:00"},{"open":"11:00","close":"18:00"},{"open":"11:00","close":"18:00"}]},"bestLight":"night","summary":"Small but distinctive winery. The tasting room is a 3D experience with the art and vivid bottle labels all in 3D (glasses included for free). There's live music on summer weekends and a stage for theatre performances. The wines are mostly whites, with a couple of red blends. The WOOPS? label (a blend of several Okanagan varietals) won Best White Wine in The World 2013 at the World Wine Competition","summarySource":"wikivoyage","wikivoyageTitle":"en:Kelowna"},{"id":"kelowna_wv_lake_tai_vegetarian_restaurant","areaId":"kelowna","name":"Lake Tai Vegetarian Restaurant","category":"food","tags":["food"],"location":{"lat":49.8785,"lng":-119.4587},"visitMinutes":75,"priceLevel":1,"photoSeed":"kelowna_wv_lake_tai_vegetarian_restaurant","tickets":[{"vendor":"Official","url":"https://www.facebook.com/LakeThaiVegetarianRestaurant/","official":true}],"signals":{},"hashtags":["laketaivegetarianrestaurant","kelowna"],"hours":{"week":[{"open":"11:00","close":"21:00"},{"open":"11:00","close":"21:00"},{"open":"11:00","close":"21:00"},{"open":"11:00","close":"21:00"},{"open":"11:00","close":"21:00"},{"open":"12:30","close":"21:00"},null],"note":"Closed Sun"},"summary":"Awesome little Taiwanese vegetarian restaurant serving light, healthy meals even carnivores will love. Almost all dishes are also vegan and gluten-free. Also serves wide selection of teas, bubble tea. Incredibly nice people, great service. Accepts credit cards. Try the honey crispy bean!","summarySource":"wikivoyage","wikivoyageTitle":"en:Kelowna"},{"id":"kelowna_wv_bouchons_bistro","areaId":"kelowna","name":"Bouchons Bistro","category":"food","tags":["food"],"location":{"lat":49.8944,"lng":-119.4959},"visitMinutes":75,"priceLevel":3,"photoSeed":"kelowna_wv_bouchons_bistro","tickets":[{"vendor":"Official","url":"http://www.bouchonsbistro.com/","official":true}],"signals":{},"hashtags":["bouchonsbistro","kelowna"],"hours":{"week":[{"open":"17:30","close":"22:30"},{"open":"17:30","close":"22:30"},{"open":"17:30","close":"22:30"},{"open":"17:30","close":"22:30"},{"open":"17:30","close":"22:30"},{"open":"17:30","close":"22:30"},{"open":"17:30","close":"22:30"}]},"summary":"Elegant French restaurant with many French classics — bouillabaisse, cassoulet, foie gras, duck confit, rabbit, lamb Provinçale and pommes frites. There's also a weekly \"Chef's Table\", a three-course fixed price menu.","summarySource":"wikivoyage","wikivoyageTitle":"en:Kelowna"},{"id":"kelowna_wv_mad_mango_cafe","areaId":"kelowna","name":"Mad Mango Cafe","category":"food","tags":["food"],"location":{"lat":49.8861,"lng":-119.4917},"visitMinutes":75,"priceLevel":1,"photoSeed":"kelowna_wv_mad_mango_cafe","tickets":[{"vendor":"Official","url":"http://www.madmangocafe.com","official":true}],"signals":{},"hashtags":["madmangocafe","kelowna"],"hours":{"week":[null,{"open":"07:30","close":"18:00"},{"open":"07:30","close":"18:00"},{"open":"07:30","close":"18:00"},{"open":"07:30","close":"18:00"},{"open":"07:30","close":"18:00"},{"open":"07:30","close":"17:00"}],"note":"Closed Mon"},"summary":"Small and popular cafe that serves a mix of Asian cuisine — won ton soup, pho, Malaysian curries, sweet and sour rice and vermicelli noodles — as well as a small selection of sandwiches and breakfast items.","summarySource":"wikivoyage","wikivoyageTitle":"en:Kelowna"},{"id":"kelowna_wv_raudz_regional_table","areaId":"kelowna","name":"RauDZ Regional Table","category":"food","tags":["food"],"location":{"lat":49.8858,"lng":-119.4969},"visitMinutes":75,"priceLevel":2,"photoSeed":"kelowna_wv_raudz_regional_table","tickets":[{"vendor":"Official","url":"http://www.raudz.com","official":true}],"signals":{},"hashtags":["raudzregionaltable","kelowna"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Popular and well regarded bistro. Dishes focus mostly on BC seafood or meat from BC or Alberta. Seating is varied — there's one long communal table or you can choose a more traditional booth seat.","summarySource":"wikivoyage","wikivoyageTitle":"en:Kelowna"},{"id":"kelowna_wv_subcity_donair","areaId":"kelowna","name":"Subcity Donair","category":"food","tags":["food"],"location":{"lat":49.9018,"lng":-119.386},"visitMinutes":75,"priceLevel":1,"photoSeed":"kelowna_wv_subcity_donair","tickets":[{"vendor":"Official","url":"http://subcity.ca","official":true}],"signals":{},"hashtags":["subcitydonair","kelowna"],"hours":{"week":[{"open":"09:00","close":"21:00"},{"open":"09:00","close":"21:00"},{"open":"09:00","close":"21:00"},{"open":"09:00","close":"21:00"},{"open":"09:00","close":"21:00"},{"open":"09:00","close":"21:00"},{"open":"09:00","close":"21:00"}]},"summary":"Local Subway or Quizno's style of restaurant with locations downtow