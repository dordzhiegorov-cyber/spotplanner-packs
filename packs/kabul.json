istan","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/7/72/National_museum_of_Afghanistan.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/7/72/National_museum_of_Afghanistan.jpg","w":1200,"h":900,"author":"Michal Hvorecky from Slovak Republic","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:National_museum_of_Afghanistan.jpg"}},{"id":"kabul_bala_hissar","areaId":"kabul","name":"Bala Hissar","category":"monument","tags":["history","views"],"location":{"lat":34.50556,"lng":69.19167},"visitMinutes":90,"priceLevel":1,"photoSeed":"kabul_bala_hissar","tickets":[],"signals":{"commonsDepicts":1,"commonsNearby":0,"wikiPageviews":1863,"wikidataSitelinks":21,"fetchedAt":"2026-10-20"},"hashtags":["balahissar","kabul"],"bestLight":"golden","summary":"Bala Hissar was an ancient fortress located in the south of the old city of Kabul, Afghanistan. The estimated date of construction is around the 5th century AD. Bala Hissar sits to the south of the modern city centre at the tail end of the Kuh-e-Shēr Darwāzah mountain.","summarySource":"wikipedia","wikipediaTitle":"Bala Hissar, Kabul","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/8/86/Upper_Bala_Hissar_from_west_Kabul_in_1879.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/8/86/Upper_Bala_Hissar_from_west_Kabul_in_1879.jpg","w":1200,"h":764,"author":"John Burke","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Upper_Bala_Hissar_from_west_Kabul_in_1879.jpg"}},{"id":"kabul_shah_do_shamshira_mosque","areaId":"kabul","name":"Shah-Do Shamshira Mosque","category":"monument","tags":["history","photo"],"location":{"lat":34.51567,"lng":69.17144},"visitMinutes":45,"priceLevel":0,"photoSeed":"kabul_shah_do_shamshira_mosque","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":12,"wikiPageviews":784,"wikidataSitelinks":18,"fetchedAt":"2026-10-20"},"hashtags":["