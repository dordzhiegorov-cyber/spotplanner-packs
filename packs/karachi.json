2:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"A theme restaurant built in the style of a 17th-century Moghul fort. Offering Pakistani cuisine such as Barbecue, biryani, and a local beef-based delicacy, haleem, in its open brick courtyard. Very busy on weekends. Buffet dinner costs per person around Rs 1,300, lunch costs Rs 750.","summarySource":"wikivoyage","wikivoyageTitle":"en:Karachi"},{"id":"karachi_wv_nihari_inn","areaId":"karachi","name":"Nihari Inn","category":"food","tags":["food"],"location":{"lat":24.82676,"lng":67.02608},"visitMinutes":75,"priceLevel":1,"photoSeed":"karachi_wv_nihari_inn","tickets":[],"signals":{},"hashtags":["nihariinn","karachi"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Boat Basin. The restaurant is especially famous for its traditional Nihari (a popular meat dish of Pakistan) with piping hot hans. A plain nihari cost Rs 150 whereas special nihari dish cost per person around Rs 350. Located on the strip of Boat Basin food street.","summarySource":"wikivoyage","wikivoyageTitle":"en:Karachi"},{"id":"karachi_wv_dynasty","areaId":"karachi","name":"Dynasty","category":"food","tags":["food"],"location":{"lat":24.8523,"lng":67.03248},"visitMinutes":75,"priceLevel":3,"photoSeed":"karachi_wv_dynasty","tickets":[],"signals":{},"hashtags":["dynastykarachi","karachi"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Fatima Jinnah Road. Award winning top end restaurant servi