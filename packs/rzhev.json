ий краеведческий музей"},"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/%D0%A0%D0%B6%D0%B5%D0%B2%D1%81%D0%BA%D0%B8%D0%B9_%D0%BA%D1%80%D0%B0%D0%B5%D0%B2%D0%B5%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D0%BC%D1%83%D0%B7%D0%B5%D0%B9_%D1%81_%D0%BC%D0%BE%D1%81%D1%82%D0%B0.JPG/1280px-%D0%A0%D0%B6%D0%B5%D0%B2%D1%81%D0%BA%D0%B8%D0%B9_%D0%BA%D1%80%D0%B0%D0%B5%D0%B2%D0%B5%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D0%BC%D1%83%D0%B7%D0%B5%D0%B9_%D1%81_%D0%BC%D0%BE%D1%81%D1%82%D0%B0.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/%D0%A0%D0%B6%D0%B5%D0%B2%D1%81%D0%BA%D0%B8%D0%B9_%D0%BA%D1%80%D0%B0%D0%B5%D0%B2%D0%B5%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D0%BC%D1%83%D0%B7%D0%B5%D0%B9_%D1%81_%D0%BC%D0%BE%D1%81%D1%82%D0%B0.JPG/500px-%D0%A0%D0%B6%D0%B5%D0%B2%D1%81%D0%BA%D0%B8%D0%B9_%D0%BA%D1%80%D0%B0%D0%B5%D0%B2%D0%B5%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D0%BC%D1%83%D0%B7%D0%B5%D0%B9_%D1%81_%D0%BC%D0%BE%D1%81%D1%82%D0%B0.JPG","w":1200,"h":900,"author":"Георгий Долгопский at Russian Wikipedia","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:%D0%A0%D0%B6%D0%B5%D0%B2%D1%81%D0%BA%D0%B8%D0%B9_%D0%BA%D1%80%D0%B0%D0%B5%D0%B2%D0%B5%D0%B4%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D0%BC%D1%83%D0%B7%D0%B5%D0%B9_%D1%81_%D0%BC%D0%BE%D1%81%D1%82%D0%B0.JPG"}},{"id":"rzhev_gratsinsky_monument_in_rzhev","areaId":"rzhev","name":"Gratsinsky Monument in Rzhev","category":"monument","tags":["history","photo"],"location":{"lat":56.26124,"lng":34.33541},"visitMinutes":30,"priceLevel":0,"photoSeed":"rzhev_gratsinsky_monument_in_rzhev","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":17,"wikiPageviews":25,"wikidataSitelinks":2,"fetchedAt":"2026-10-24"},"hashtags":["gratsinskymonumentinrzhev","rzhev"],"bestLight":"morning","summary":"Небольшой парк на месте дореволюционного Никольского сада, рядом с Соборной горой, назван в честь военкома В.В. Грацинского, по