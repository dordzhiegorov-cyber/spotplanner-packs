iki/File:Saluga_and_ghazal.jpg"}},{"id":"aswan_wadi_el_hudi","areaId":"aswan","name":"Wadi el-Hudi","category":"monument","tags":["history"],"location":{"lat":24.1,"lng":32.9},"visitMinutes":90,"priceLevel":1,"photoSeed":"aswan_wadi_el_hudi","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":40,"wikiPageviews":154,"wikidataSitelinks":12,"fetchedAt":"2026-10-22"},"hashtags":["wadielhudi","aswan"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"}],"note":"Typical hours — check the official site"},"bestLight":"morning","summary":"Wadi el-Hudi is a mining region that includes a large wadi and a mountain named Gebel el-Hudi in the Egyptian Eastern Desert, Southeast of Aswan. The name hudi is thought to come from the Arabic word for guide. Wadi el-Hudi is geologically rich and has been the basis of considerable mining and study since Ancient times.","summarySource":"wikipedia","wikipediaTitle":"Wadi el-Hudi","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/H%C3%B4tel_M%C3%B6venpick_-_Assouan_%28EG%29_-_2025-12-07_-_1.jpg/1280px-H%C3%B4tel_M%C3%B6venpick_-_Assouan_%28EG%29_-_2025-12-07_-_1.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/H%C3%B4tel_M%C3%B6venpick_-_Assouan_%28EG%29_-_2025-12-07_-_1.jpg/500px-H%C3%B4tel_M%C3%B6venpick_-_Assouan_%28EG%29_-_2025-12-07_-_1.jpg","w":1200,"h":900,"author":"Chabe01","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:H%C3%B4tel_M%C3%B6venpick_-_Assouan_(EG)_-_2025-12-07_-_1.jpg"}},{"id":"aswan_el_tabia_mosque","areaId":"aswan","name":"El-Tabia Mosque","category":"monument","tags":["history","photo"],"location":{"lat":24.089,"lng":32.8998},"visitMinutes":45,"priceLevel":0,"photoSeed":"aswan_el_tabia_mo