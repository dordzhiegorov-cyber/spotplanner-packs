ro/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:%D0%A6%D0%B5%D1%80%D0%BA%D0%BE%D0%B2%D1%8C_%D1%81%D0%B5%D0%BC%D0%B8_%D0%BE%D1%82%D1%80%D0%BE%D0%BA%D0%BE%D0%B2_%D1%8D%D1%84%D0%B5%D1%81%D1%81%D0%BA%D0%B8%D1%85_(%D0%A2%D0%BE%D0%B1%D0%BE%D0%BB%D1%8C%D1%81%D0%BA).jpg"}},{"id":"tobolsk_wv_bazarnaya_ploshchad","areaId":"tobolsk","name":"Базарная площадь","category":"landmark","tags":["photo"],"location":{"lat":58.1972,"lng":68.2448},"visitMinutes":60,"priceLevel":1,"photoSeed":"tobolsk_wv_bazarnaya_ploshchad","tickets":[],"signals":{"commonsNearby":163,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["базарнаяплощадь","tobolsk"],"summary":"Некогда торговая, а ныне тихая и больше напоминающая города русского Севера площадь является одним из центров Подгорной части Тобольска. Кроме вполне рядовых торговых павильонов и лавок здесь находятся сразу несколько зданий XVIII века, в том числе магистрат (дом № 3, 1754) с нарочито простым и угловатым оформлением оконных проёмов. Два дома по улице Хохрякова (№ 2 и 10) — построенные в конце XVII","summarySource":"wikivoyage","wikivoyageTitle":"ru:Тобольск"},{"id":"tobolsk_osm_piteynye_zavedeniya_1790_gg","areaId":"tobolsk","name":"Питейные заведения (1790 гг.)","category":"landmark","tags":["photo"],"location":{"lat":58.19651,"lng":68.24599},"visitMinutes":60,"priceLevel":1,"photoSeed":"tobolsk_osm_piteynye_zavedeniya_1790_gg","tickets":[],"signals":{"commonsNearby":140,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["питейныезаведения1790гг","tobolsk"]},{"id":"tobolsk_osm_magazin_konstantinova_1893_g","areaId":"tobolsk","name":"Магазин Константинова (1893 г.)","category":"landmark","tags":["photo"],"location":{"lat":58.19744,"lng":68.24606},"visitMinutes":60,"priceLevel":1,"photoSeed":"tobolsk_osm_magazin_konstantinova_1893_g","tickets":[],"signals":{"commonsNearby":126,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["магазинконстантинова1893г","tobolsk"]},{"id":"tobolsk_osm_dom_magaz