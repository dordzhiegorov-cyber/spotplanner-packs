_wv_kaupe","tickets":[{"vendor":"Official","url":"http://www.kaupe.com.ar/","official":true}],"signals":{},"hashtags":["kaupeushuaia","ushuaia"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Expensive compared to other restaurants in Ushuaia, but the view is spectacular and the food is absolutely, positively guaranteed not to disappoint. Also known for its king crab.","summarySource":"wikivoyage","wikivoyageTitle":"en:Ushuaia"},{"id":"ushuaia_wv_barcleit_1912","areaId":"ushuaia","name":"Barcleit 1912","category":"food","tags":["food"],"location":{"lat":-54.80675,"lng":-68.30813},"visitMinutes":75,"priceLevel":1,"photoSeed":"ushuaia_wv_barcleit_1912","tickets":[],"signals":{},"hashtags":["barcleit1912","ushuaia"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Small restaurant with a variety of local dishes and a few unconventional options. Try the pizza alemana with mustard and sausage.","summarySource":"wikivoyage","wikivoyageTitle":"en:Ushuaia"},{"id":"ushuaia_wv_bodegon_fuegino","areaId":"ushuaia","name":"Bodegon Fuegino","category":"nightlife","tags":["nightlife"],"location":{"lat":-54.8077,"lng":-68.3095},"visitMinutes":90,"photoSeed":"ushuaia_wv_bodegon_fuegino","tickets":[{"vendor":"Official","url":"http://www.tierradehumos.com/bodegon/","official":true}],"signals":{},"hashtags":["bodegonfuegino","ushuaia"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close