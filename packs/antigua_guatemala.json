se":"19:00"},{"open":"10:00","close":"19:00"},{"open":"10:00","close":"19:00"},{"open":"10:00","close":"19:00"}]},"summary":"Learn how to make chocolate from the cocoa beans. A unique experience where you learn everything about the history of chocolate, the cacao plantations, and the industry of chocolate making. At the end of the class you will make your own chocolate bar at your taste and will be able to bring it back home with you.","summarySource":"wikivoyage","wikivoyageTitle":"Antigua Guatemala"},{"id":"antigua_guatemala_iglesia_de_nuestra_senora_del_carmen","areaId":"antigua_guatemala","name":"iglesia de Nuestra Señora del Carmen","category":"monument","tags":["history","photo"],"location":{"lat":14.56032,"lng":-90.73883},"visitMinutes":45,"priceLevel":0,"photoSeed":"antigua_guatemala_iglesia_de_nuestra_senora_del_carmen","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":28,"wikidataSitelinks":2,"fetchedAt":"2026-10-13"},"hashtags":["iglesiadenuestrasenoradelcarmen","antiguaguatemala"],"hours":{"week":[{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"}]},"summary":"The useful lifespan of the Colegio de San Jerónimo was short indeed: the sixteen years between its completion in 1757 and the earthquake of 1773 that destroyed it saw the building used first as a secondary school staffed by the Friars of La Merced, then as a royal customs house. Today, though it's quite a bit further afield from the other colonial ruins, San Jerónimo is popular with visitors for t","summarySource":"wikivoyage","wikivoyageTitle":"Antigua Guatemala","names":{"es":"Iglesia de Nuestra Señora del Carmen","ru":"Церковь Пресвятой Девы Марии Кармельской (Антигуа-Гуатемала)"},"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/48/Iglesia_del_Carmen_%283746568616%29.jpg/1280px-Iglesia_del_Carmen_%283746568616%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/48/Iglesia_del_Carmen_%283746568616%29.jpg/500px-Iglesia_del_Carmen_%283746568616%29.jpg","w":1200,"h":1279,"author":"Francisco Anzola","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Iglesia_del_Carmen_(3746568616).jpg"}},{"id":"antigua_guatemala_wv_convento_de_santa_clara","areaId":"antigua_guatemala","name":"Convento de Santa Clara","category":"landmark","tags":["photo"],"location":{"lat":14.55502,"lng":-90.73071},"visitMinutes":60,"priceLevel":1,"photoSeed":"antigua_guatemala_wv_convento_de_santa_clara","tickets":[],"signals":{"commonsNearby":29,"wikidataSitelinks":0,"fetchedAt":"2026-10-13"},"hashtags":["conventodesantaclara","antiguaguatemala"],"summary":"One of the largest complexes of colonial ruins in Antigua, the Convento de Santa Clara was built in 1715 as the home of an order of Franciscan nuns founded some years earlier by a group of six sisters from Mexico. Today this ruin is most notable for its facade, which largely survived the earthquake of 1773 that devastated the complex; it's one of the most ornate in all of Antigua, replete with int","summarySource":"wikivoyage","wikivoyageTitle":"Antigua Guatemala","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/View_of_Park_through_Arch_-_Antigua_Guatemala_-_Guatemala_%2815993697652%29.jpg/1280px-View_of_Park_through_Arch_-_Antigua_Guatemala_-_Guatemala_%2815993697652%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/View_of_Park_through_Arch_-_Antigua_Guatemala_-_Guatemala_%2815993697652%29.jpg/500px-View_of_Park_through_Arch_-_Antigua_Guatemala_-_Guatemala_%2815993697652%29.jpg","w":1200,"h":900,"author":"Adam Jones from Kelowna, BC, Canada","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:View_of_Park_through_Arch_-_Antigua_Guatemala_-_Guatemala_(15993697652).jpg"}},{"id":"antigua_guatemala_wv_museo_casa_del_tejido_antiguo","areaId":"antigua_guatemala","name":"Museo Casa del Tejido Antiguo","category":"museum","tags":["museums"],"location":{"lat":14.56061,"lng":-90.73962},"visitMinutes":120,"priceLevel":2,"photoSeed":"antigua_guatemala_wv_museo_casa_del_tejido_antiguo","tickets":[{"vendor":"Official","url":"http://www.casadeltejido.org","official":true}],"signals":{"commonsNearby":29,"wikidataSitelinks":0,"fetchedAt":"2026-10-13"},"hashtags":["museocasadeltejidoantiguo","antiguaguatemala"],"hours":{"week":[{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"17:00"},{"open":"09:00","close":"16:00"},null],"note":"Closed Sun"},"summary":"Founded in 1998, the Casa del Tejido Antiguo is a museum dedicated to the craft of weaving as practiced for centuries by the native Mayans of Guatemala. Tucked away in an out-of-the-way corner of central Antigua, you'll be taken on a brief (30- to 40-minute) guided tour through about a half-dozen rooms of museum exhibits detailing the history, tools and techniques of traditional Mayan weaving. The","summarySource":"wikivoyage","wikivoyageTitle":"Antigua Guatemala","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/24/Parque_Central_%283745764765%29.jpg/1280px-Parque_Central_%283745764765%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/24/Parque_Central_%283745764765%29.jpg/500px-Parque_Central_%283745764765%29.jpg","w":1200,"h":900,"author":"Francisco Anzola","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Parque_Central_(3745764765).jpg"}},{"id":"antigua_guatemala_wv_casa_escobar","areaId":"antigua_guatemala","name":"Casa Escobar","category":"food","tags":["food"],"location":{"lat":14.55759,"lng":-90.73516},"visitMinutes":75,"priceLevel":3,"photoSeed":"antigua_guatemala_wv_casa_escobar","tickets":[{"vendor":"Official","url":"http://www.casaescobar.com.gt","official":true}],"signals":{},"hashtags":["casaescobar","antiguaguatemala"],"hours":{"week":[{"open":"07:00","close":"22:00"},{"open":"07:00","close":"22:00"},{"open":"07:00","close":"22:00"},{"open":"07:00","close":"22:00"},{"open":"07:00","close":"22:00"},{"open":"07:00","close":"22:00"},{"open":"07:00","close":"22:00"}]},"summary":"Entire restaurant lit with candles. Beautiful interior blending in with the style of Antigua. Do not let relatively high prices and not very appetizing pictures in the menu fool you. Steaks brought to the table will look way more appetizing and after the first bite you will know that you will not leave a single bite on the plate no matter how big of cut you have ordered. If you like steak you are ","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_dona_luisa_xicotencatl","areaId":"antigua_guatemala","name":"Doña Luisa Xicotencatl","category":"food","tags":["food"],"location":{"lat":14.55747,"lng":-90.73189},"visitMinutes":75,"priceLevel":1,"photoSeed":"antigua_guatemala_wv_dona_luisa_xicotencatl","tickets":[],"signals":{},"hashtags":["donaluisaxicotencatl","antiguaguatemala"],"hours":{"week":[{"open":"07:00","close":"21:30"},{"open":"07:00","close":"21:30"},{"open":"07:00","close":"21:30"},{"open":"07:00","close":"21:30"},{"open":"07:00","close":"21:30"},{"open":"07:00","close":"21:30"},{"open":"07:00","close":"21:30"}]},"summary":"Has the feel of a well-run corporate restaurant set in a gorgeous leafy courtyard of a historic building. Menu includes well-executed breakfast, hamburgers, and Guatemalan interpretations of Tex-Mex food. They use purified water on their vegetables and for drinking and ice, which means their menu is in-bounds for tender First World stomachs. There is a bakery in the building, which means that when","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_la_canche","areaId":"antigua_guatemala","name":"La Canche","category":"food","tags":["food"],"location":{"lat":14.56093,"lng":-90.73535},"visitMinutes":75,"priceLevel":1,"photoSeed":"antigua_guatemala_wv_la_canche","tickets":[],"signals":{},"hashtags":["lacanche","antiguaguatemala"],"hours":{"week":[{"open":"06:45","close":"20:30"},{"open":"06:45","close":"20:30"},{"open":"06:45","close":"20:30"},{"open":"06:45","close":"20:30"},{"open":"06:45","close":"20:30"},{"open":"06:45","close":"20:30"},{"open":"06:45","close":"20:30"}]},"summary":"Popular among locals and well hidden behind the tienda this family-run restaurant rarely sees tourists. The ladies are very kind and helpful even though they don't speak English. They serve breakfast for Q20 and set lunch for Q20-25 that includes a drink. The lunch options are written on a board in front of the shop. Enjoy authentic homemade Guatemaltecan cuisine while sharing a table with locals ","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_rainbow_cafe","areaId":"antigua_guatemala","name":"Rainbow Café","category":"food","tags":["food"],"location":{"lat":14.55537,"lng":-90.73648},"visitMinutes":75,"priceLevel":1,"photoSeed":"antigua_guatemala_wv_rainbow_cafe","tickets":[{"vendor":"Official","url":"http://www.rainbowcafeantigua.com","official":true}],"signals":{},"hashtags":["rainbowcafe","antiguaguatemala"],"hours":{"week":[{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"}]},"summary":"Tourist-friendly and wholesome breakfasts, lunches, and dinners. An early-bird breakfast special of tomatoes, beans, eggs, rice, and tea or coffee is easy on the wallet. Sandwiches and dinner entrees are inexpensive too, and salads and big desserts are also on offer. Uses purified water for all drinks, ice, and preparation. They have a rich schedule of live music, poetry readings, and interesting ","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_travel_menu","areaId":"antigua_guatemala","name":"Travel Menu","category":"food","tags":["food"],"location":{"lat":14.55537,"lng":-90.73621},"visitMinutes":75,"priceLevel":1,"photoSeed":"antigua_guatemala_wv_travel_menu","tickets":[],"signals":{},"hashtags":["travelmenu","antiguaguatemala"],"hours":{"week":[{"open":"13:00","close":"23:00"},{"open":"13:00","close":"23:00"},{"open":"13:00","close":"23:00"},{"open":"13:00","close":"23:00"},{"open":"13:00","close":"23:00"},{"open":"13:00","close":"23:00"},{"open":"13:00","close":"23:00"}]},"summary":"Promises \"small place, big portions\", and delivers. It seats perhaps 20 people at about eight tables, in small, dim room painted to look like an underground European keller, lit only by candles on stands overflowing with cascades of wax drippings. They offer dinner entrees for low prices, with vegetarian options for everything. The portions are indeed generous. Beer and wine are also available, bu","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_y_tu_pina_tambien","areaId":"antigua_guatemala","name":"Y Tu Piña También","category":"food","tags":["food"],"location":{"lat":14.55554,"lng":-90.72985},"visitMinutes":75,"priceLevel":1,"photoSeed":"antigua_guatemala_wv_y_tu_pina_tambien","tickets":[{"vendor":"Official","url":"http://www.ytupinatambien.com","official":true}],"signals":{},"hashtags":["ytupinatambien","antiguaguatemala"],"hours":{"week":[{"open":"07:00","close":"17:00"},{"open":"07:00","close":"17:00"},{"open":"07:00","close":"17:00"},{"open":"07:00","close":"17:00"},{"open":"07:00","close":"17:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}]},"summary":"All-day breakfast and some lunch items catering to twentysomething backpackers. Depending on your sense of humor, be prepared to either LOL or be outraged at gleefully profane menu items such as \"Monkey's A**\" and \"Egg McF***in' Muffin\" (how trademark law lets them get away with that one in anyone's guess). Licuados. Benito's flavored rums. Luisa's famous hangover soups. Proper espressos. Manu Cha","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_fernando_s_kaffee","areaId":"antigua_guatemala","name":"Fernando's Kaffee","category":"cafe","tags":["cafes"],"location":{"lat":14.56155,"lng":-90.73615},"visitMinutes":45,"photoSeed":"antigua_guatemala_wv_fernando_s_kaffee","tickets":[{"vendor":"Official","url":"http://www.fernandoskaffee.com","official":true}],"signals":{},"hashtags":["fernandoskaffee","antiguaguatemala"],"hours":{"week":[{"open":"07:00","close":"19:00"},{"open":"07:00","close":"19:00"},{"open":"07:00","close":"19:00"},{"open":"07:00","close":"19:00"},{"open":"07:00","close":"19:00"},{"open":"07:00","close":"19:00"},{"open":"07:00","close":"13:00"}]},"bestLight":"morning","summary":"Some of the best coffee in Antigua, plus great breakfasts. Fernando, the owner, is very friendly and may show you his operation: the coffee roaster, grinder, etc. Pleasant courtyard seating is found when walking through the first two rooms and around the kitchen. The breakfasts are awesome: pancakes and crepes and fresh fruit. It is a great place to relax drinking wonderful coffee.","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_cafe_no_se","areaId":"antigua_guatemala","name":"Café No Sé","category":"cafe","tags":["cafes"],"location":{"lat":14.55565,"lng":-90.72949},"visitMinutes":45,"photoSeed":"antigua_guatemala_wv_cafe_no_se","tickets":[{"vendor":"Official","url":"http://www.cafenose.com","official":true}],"signals":{},"hashtags":["cafenose","antiguaguatemala"],"hours":{"week":[{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"},{"open":"08:00","close":"18:00"}],"note":"Typical hours — check the official site"},"bestLight":"morning","summary":"Cool hipster-backpacker bar serving up a range of drinks including the local favorite, \"Ilegal\" mezcal. Dim lighting, mysterious vibes, and interesting patrons from all over the world. Friendly staff and prices are a lot more reasonable than you'd expect from such a trendier-than-thou spot. Live music is presented frequently.","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_luna_de_miel","areaId":"antigua_guatemala","name":"Luna de Miel","category":"food","tags":["food"],"location":{"lat":14.5604,"lng":-90.73544},"visitMinutes":75,"priceLevel":1,"photoSeed":"antigua_guatemala_wv_luna_de_miel","tickets":[{"vendor":"Official","url":"http://www.lunademielantigua.com","official":true}],"signals":{},"hashtags":["lunademiel","antiguaguatemala"],"hours":{"week":[{"open":"09:00","close":"21:30"},{"open":"09:00","close":"21:30"},{"open":"09:00","close":"21:30"},{"open":"09:00","close":"21:30"},{"open":"09:00","close":"21:30"},{"open":"09:00","close":"21:30"},{"open":"09:00","close":"21:30"}]},"summary":"Luna de Miel opened its doors in July 2006, and Antigua immediately succumbed to the charms of crepes à la française. The first floor area is small, but there is an inviting open-roof terrace upstairs. The menu offers not a lot to choose, but all the products are fresh, selected each morning in the market. Free Wi-Fi.","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_monoloco","areaId":"antigua_guatemala","name":"Monoloco","category":"food","tags":["food"],"location":{"lat":14.55597,"lng":-90.73414},"visitMinutes":75,"priceLevel":2,"photoSeed":"antigua_guatemala_wv_monoloco","tickets":[{"vendor":"Official","url":"http://www.restaurantemonoloco.com","official":true}],"signals":{},"hashtags":["monolocoantiguaguatemala","antiguaguatemala"],"hours":{"week":[{"open":"11:00","close":"23:59"},{"open":"11:00","close":"23:59"},{"open":"11:00","close":"23:59"},{"open":"11:00","close":"23:59"},{"open":"11:00","close":"23:59"},{"open":"11:00","close":"23:59"},{"open":"11:00","close":"23:59"}]},"summary":"A funky tourist friendly joint with cheap international calling and a few computers for Internet use. The food is very \"gringo-esque\", but tasty nonetheless. There's a large bar on the ground level, as well as a covered open air second floor eating area. Good place to meet and greet or enjoy a burger.","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"},{"id":"antigua_guatemala_wv_reilly_s_irish_tavern","areaId":"antigua_guatemala","name":"Reilly's Irish Tavern","category":"nightlife","tags":["nightlife"],"location":{"lat":14.55519,"lng":-90.73442},"visitMinutes":90,"photoSeed":"antigua_guatemala_wv_reilly_s_irish_tavern","tickets":[],"signals":{},"hashtags":["reillysirishtavern","antiguaguatemala"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"Antigua's only Irish pub and a popular sports bar. Serves Guinness and Jaegermeister, among other things. Pool table. Burgers and snacks. Every Monday at 20:00 they hold a pub quiz.","summarySource":"wikivoyage","wikivoyageTitle":"en:Antigua Guatemala"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}