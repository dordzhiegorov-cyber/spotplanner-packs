_cathedral_from_riverside.jpg"}},{"id":"uglich_uglich_reservoir","areaId":"uglich","name":"Uglich Reservoir","category":"park","tags":["nature","photo"],"location":{"lat":57.48333,"lng":38.26667},"visitMinutes":60,"priceLevel":0,"photoSeed":"uglich_uglich_reservoir","tickets":[],"signals":{"commonsDepicts":8,"commonsNearby":0,"wikiPageviews":525,"wikidataSitelinks":22,"fetchedAt":"2026-10-24"},"hashtags":["uglichreservoir","uglich"],"bestLight":"golden","summary":"Uglich Reservoir or Uglichskoye Reservoir is an artificial lake in the upper part of the Volga River formed by the Uglich Hydroelectric Station dam.","summarySource":"wikipedia","wikipediaTitle":"Uglich Reservoir","names":{"nl":"Oeglitsjskoe vodochranilisjtsje","de":"Uglitscher Stausee","fr":"Réservoir d'Ouglitch","es":"Embalse de Úglich","it":"Bacino di Uglič","ru":"Угличское водохранилище","zh":"乌格利奇水库"},"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Uglitsch_Schleuse.JPG/1280px-Uglitsch_Schleuse.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Uglitsch_Schleuse.JPG/500px-Uglitsch_Schleuse.JPG","w":1200,"h":495,"author":"Finanzer","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Uglitsch_Schleuse.JPG"}},{"id":"uglich_transfiguration_cathedral","areaId":"uglich","name":"Transfiguration Cathedral","category":"monument","tags":["history","photo"],"location":{"lat":57.52891,"lng":38.31741},"visitMinutes":45,"priceLevel":0,"photoSeed":"uglich_transfiguration_cathedral","tickets":[],"signals":{"commonsDepicts":1,"commonsNearby":175,"wikiPageviews":220,"wikidataSitelinks":6,"fetchedAt":"2026-10-24"},"hashtags":["transfigurationcathedral","uglich"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","clos