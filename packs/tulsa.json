kipedia/commons/f/f4/1stPresbyterianChurchTulsa.jpg","w":1200,"h":900,"author":"David Stapleton (Dsmdgold)","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:1stPresbyterianChurchTulsa.jpg"}},{"id":"tulsa_oil_capital_historic_district","areaId":"tulsa","name":"Oil Capital Historic District","category":"landmark","tags":["history","photo"],"location":{"lat":36.15139,"lng":-95.99},"visitMinutes":45,"priceLevel":0,"photoSeed":"tulsa_oil_capital_historic_district","tickets":[],"signals":{"commonsDepicts":1,"commonsNearby":67,"wikiPageviews":114,"wikidataSitelinks":2,"fetchedAt":"2026-10-20"},"hashtags":["oilcapitalhistoricdistrict","tulsa"],"bestLight":"morning","summary":"The Oil Capital Historic District (OCHD) is an area in downtown Tulsa, Oklahoma that commemorates the success of the oil business in Tulsa during the early 20th century.","summarySource":"wikipedia","wikipediaTitle":"Oil Capital Historic District (Tulsa, Oklahoma)","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/11/Oil_Capital_Historic_District.jpg/1280px-Oil_Capital_Historic_District.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/11/Oil_Capital_Historic_District.jpg/500px-Oil_Capital_Historic_District.jpg","w":1200,"h":800,"author":"W. R. Oswald","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Oil_Capital_Historic_District.jpg"}},{"id":"tulsa_mayo_building","areaId":"tulsa","name":"Mayo Building","category":"landmark","tags":["history","photo"],"location":{"lat":36.1525,"lng":-95.99056},"visitMinutes":45,"priceLevel":0,"photoSeed":"tulsa_mayo_building","tickets":[],"signals":{"commonsDepicts":6,"commonsNearby":75,"wikiPageviews":72,"wikidataSitelinks":2,"fetchedAt":"2026-10-20"},"hashtags":["mayobuilding","tulsa"],"bestLight":"morning","summary":"The Mayo Building at the northwest corner o