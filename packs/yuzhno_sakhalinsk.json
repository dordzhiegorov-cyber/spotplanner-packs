:"wikivoyage","wikivoyageTitle":"en:Yuzhno-Sakhalinsk","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/2025-06-03-ys-teatr-zentr-kashtanka.jpg/1280px-2025-06-03-ys-teatr-zentr-kashtanka.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/2025-06-03-ys-teatr-zentr-kashtanka.jpg/500px-2025-06-03-ys-teatr-zentr-kashtanka.jpg","w":1200,"h":904,"author":"I13Robin","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:2025-06-03-ys-teatr-zentr-kashtanka.jpg"}},{"id":"yuzhno_sakhalinsk_wv_military_hospital","areaId":"yuzhno_sakhalinsk","name":"Military Hospital","category":"landmark","tags":["photo"],"location":{"lat":46.95547,"lng":142.7362},"visitMinutes":60,"priceLevel":1,"photoSeed":"yuzhno_sakhalinsk_wv_military_hospital","tickets":[],"signals":{"commonsNearby":2,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["militaryhospital","yuzhnosakhalinsk"],"summary":"1930s postconstructivist building that is still used as a military hospital. The military hospital was modern for its time, being equipped with an elevator and a solarium.","summarySource":"wikivoyage","wikivoyageTitle":"en:Yuzhno-Sakhalinsk","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/b/bc/Karafuto_Prefectural_Toyohara_Hospital.JPG","thumb":"https://upload.wikimedia.org/wikipedia/commons/b/bc/Karafuto_Prefectural_Toyohara_Hospital.JPG","w":1200,"h":881,"author":"Unknown authorUnknown author","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Karafuto_Prefectural_Toyohara_Hospital.JPG"}},{"id":"yuzhno_sakhalinsk_gorodskaya_bolnitsa","areaId":"yuzhno_sakhalinsk","name":"Городская больница","category":"landmark","tags":["photo"],"location":{"lat":46.95546,"lng":142.73621},"visitMinutes":60,"priceLevel":1,"photoSeed":"yuzhno_sakhalinsk_gorodskaya_bolnitsa","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":2,"wikidataSitel