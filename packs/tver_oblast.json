ast"],"bestLight":"golden","summary":"Lake Volgo is a lake in Ostashkovsky, Penovsky, and Selizharovsky Districts of Tver Oblast, Russia. The Volga River flows through the lake in its upper course. The lake has a surface area of 61 square kilometres (24 mi2), and the area of its drainage basin is 3,500 square kilometres (1,400 mi2).","summarySource":"wikipedia","wikipediaTitle":"Lake Volgo","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/0/0b/%D0%92%D0%BE%D0%BB%D0%B3%D0%BE.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/0/0b/%D0%92%D0%BE%D0%BB%D0%B3%D0%BE.jpg","w":1200,"h":900,"author":"Николаев И.Б.","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:%D0%92%D0%BE%D0%BB%D0%B3%D0%BE.jpg"}},{"id":"tver_oblast_central_forest_nature_reserve","areaId":"tver_oblast","name":"Central Forest Nature Reserve","category":"park","tags":["nature","hiking"],"location":{"lat":56.5,"lng":32.91667},"visitMinutes":120,"priceLevel":0,"photoSeed":"tver_oblast_central_forest_nature_reserve","tickets":[{"vendor":"Official","url":"http://clgz.ru/","official":true}],"signals":{"commonsDepicts":0,"commonsNearby":0,"wikiPageviews":278,"wikidataSitelinks":10,"fetchedAt":"2026-10-25"},"hashtags":["centralforestnaturereserve","tveroblast"],"bestLight":"golden","summary":"Central Forest Nature Reserve is a zapovednik in the north-west of Russia, located in Andreapolsky and Nelidovsky Districts of Tver Oblast, in the upper course of the Mezha River. It was established on 4 May 1930. The nature reserve is created to protect the conifer forest in the upper course of the Western Dvina River.","summarySource":"wikipedia","wikipediaTitle":"Central Forest Nature Reserve","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/5/5f/Boloto03.JPG","thumb":"https://upload.wikimedia.org/wikipedia/commons/5/5f/Boloto03.JPG","w":1200,"h":900,"author":"Makyvan","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.or