anchakki_%40_Evening.jpg/1280px-Paanchakki_%40_Evening.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a3/Paanchakki_%40_Evening.jpg/500px-Paanchakki_%40_Evening.jpg","w":1200,"h":900,"author":"Anjan05","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Paanchakki_@_Evening.jpg"}},{"id":"aurangabad_neher_water_system","areaId":"aurangabad","name":"Neher water system","category":"landmark","tags":["history","photo"],"location":{"lat":19.88978,"lng":75.31572},"visitMinutes":45,"priceLevel":0,"photoSeed":"aurangabad_neher_water_system","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":106,"wikiPageviews":167,"wikidataSitelinks":3,"fetchedAt":"2026-10-21"},"hashtags":["neherwatersystem","aurangabad"],"bestLight":"morning","summary":"Neher water system provided clean water for the people of Aurangabad and its suburbs. It was created by Malik Ambar who founded the town under the name Khadki and was later expanded by Aurangzeb to facilitate the military activity that became prevalent under Mughal rule during the 17th century.","summarySource":"wikipedia","wikipediaTitle":"Neher water system","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/1/1d/Aurangabad_city.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/1/1d/Aurangabad_city.jpg","w":1200,"h":713,"author":"Unknown authorUnknown author","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Aurangabad_city.jpg"}},{"id":"aurangabad_soneri_mahal","areaId":"aurangabad","name":"Soneri Mahal","category":"landmark","tags":["history","photo"],"location":{"lat":19.90667,"lng":75.30889},"visitMinutes":45,"priceLevel":0,"photoSeed":"aurangabad_soneri_mahal","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":8,"wikiPageviews":220,"wikidataSitelinks":4,"fetchedAt":"2026-10-21"},"hashtags":["sonerimahal","aurangabad"],"bestLight":"morning","summary":"Soneri Mahal, is a historic monument located in Aurangabad, Maharashtra, India, situated in the Satmala mountain range. It is near Dr. Babasaheb Ambedkar Marathwada University, and currently serves as the home of the Maharashtra State Museum for Aurangabad.","summarySource":"wikipedia","wikipediaTitle":"Soneri Mahal","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Soneri_Mahal%2C_Aurangabad.jpg/1280px-Soneri_Mahal%2C_Aurangabad.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Soneri_Mahal%2C_Aurangabad.jpg/500px-Soneri_Mahal%2C_Aurangabad.jpg","w":1200,"h":800,"author":"मयुरेश खडके","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Soneri_Mahal,_Aurangabad.jpg"}},{"id":"aurangabad_bhadkal_gate","areaId":"aurangabad","name":"Bhadkal Gate","category":"monument","tags":["art","photo"],"location":{"lat":19.88873,"lng":75.32168},"visitMinutes":20,"priceLevel":0,"photoSeed":"aurangabad_bhadkal_gate","tickets":[],"signals":{"commonsDepicts":3,"commonsNearby":0,"wikiPageviews":112,"wikidataSitelinks":4,"fetchedAt":"2026-10-21"},"hashtags":["bhadkalgate","aurangabad"],"bestLight":"morning","summary":"Bhadkal Gate is a structure in Aurangabad City in Maharashtra, India. This gate is the biggest in the city. It was built by Ahamadnagar's Murtaza Nizamshah's vizier Malik Ambar to commemorate the victory against the Mughals in 1612. It is also known as Victory Gate.","summarySource":"wikipedia","wikipediaTitle":"Bhadkal Gate","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Bhadkal_Gate.JPG/1280px-Bhadkal_Gate.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Bhadkal_Gate.JPG/500px-Bhadkal_Gate.JPG","w":1200,"h":797,"author":"Nefirious","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Bhadkal_Gate.JPG"}},{"id":"aurangabad_sambhajinagar_caves","areaId":"aurangabad","name":"Sambhajinagar Caves","category":"park","tags":["nature"],"location":{"lat":19.91694,"lng":75.31194},"visitMinutes":60,"priceLevel":1,"photoSeed":"aurangabad_sambhajinagar_caves","tickets":[],"signals":{"commonsDepicts":13,"commonsNearby":242,"wikidataSitelinks":12,"fetchedAt":"2026-10-21"},"hashtags":["sambhajinagarcaves","aurangabad"],"hours":{"week":[{"open":"10:00","close":"17:00"},{"open":"10:00","close":"17:00"},{"open":"10:00","close":"17:00"},{"open":"10:00","close":"17:00"},{"open":"10:00","close":"17:00"},{"open":"10:00","close":"17:00"},{"open":"10:00","close":"17:00"}],"note":"Typical hours — check the official site"},"summary":"The Aurangabad caves now known as Chhatrapati Sambhajinagar Caves are twelve rock-cut Buddhist shrines located on a hill running roughly east to west, close to the city of Chhatrapati Sambhajinagar. The first reference to the Aurangabad Caves is in the great chaitya of Kanheri Caves.","summarySource":"wikipedia","wikipediaTitle":"Chhatrapati Sambhajinagar Caves","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/002_The_Cave_Complex_%2833676095440%29.jpg/1280px-002_The_Cave_Complex_%2833676095440%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/002_The_Cave_Complex_%2833676095440%29.jpg/500px-002_The_Cave_Complex_%2833676095440%29.jpg","w":1200,"h":800,"author":"Photo Dharma from Sadao, Thailand","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:002_The_Cave_Complex_(33676095440).jpg"}},{"id":"aurangabad_wv_pan_chakki","areaId":"aurangabad","name":"Pan Chakki","category":"landmark","tags":["photo"],"location":{"lat":19.8941,"lng":75.3174},"visitMinutes":60,"priceLevel":1,"photoSeed":"aurangabad_wv_pan_chakki","tickets":[],"signals":{"commonsNearby":3,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["panchakki","aurangabad"],"summary":"This is a 17th-century water mill. The name has been derived from the mill that crushed grain for the pilgrims. There is a picturesque garden here that houses several beautiful fish tanks and it plays abode to the memorial of a Sufi Saint.","summarySource":"wikivoyage","wikivoyageTitle":"Aurangabad","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Makaigate.jpg/1280px-Makaigate.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Makaigate.jpg/500px-Makaigate.jpg","w":1200,"h":696,"author":"Gunjanppatel99","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Makaigate.jpg"}},{"id":"aurangabad_wv_aurangabad_caves","areaId":"aurangabad","name":"Aurangabad Caves","category":"landmark","tags":["photo"],"location":{"lat":19.91858,"lng":75.31583},"visitMinutes":60,"priceLevel":1,"photoSeed":"aurangabad_wv_aurangabad_caves","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["aurangabadcaves","aurangabad"],"hours":{"week":[{"open":"00:00","close":"23:59"},{"open":"00:00","close":"23:59"},{"open":"00:00","close":"23:59"},{"open":"00:00","close":"23:59"},{"open":"00:00","close":"23:59"},{"open":"00:00","close":"23:59"},{"open":"00:00","close":"23:59"}]},"summary":"This is a fine piece of architecture, is presented in the most unembellished manner. The caves lie just outside the city and are believed to have been excavated between the 2nd and the 6th century. They house the most stunningly intricate carvings. There are nine caves in all, most of them being the viharas. The 4th and the 7th cave are worth a dekko. The 4th cave stands well supported on 12 colum","summarySource":"wikivoyage","wikivoyageTitle":"Aurangabad"},{"id":"aurangabad_wv_history_museum_dr_babasaheb_ambedkar_marathwada_","areaId":"aurangabad","name":"History Museum - Dr. Babasaheb Ambedkar Marathwada University","category":"museum","tags":["museums"],"location":{"lat":19.9054,"lng":75.3119},"visitMinutes":120,"priceLevel":2,"photoSeed":"aurangabad_wv_history_museum_dr_babasaheb_ambedkar_marathwada_","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["historymuseumdrbabasahebambedkarmarathwadauniversity","aurangabad"],"hours":{"week":[null,{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Closed Mon; Typical hours — check the official site"},"summary":"It has on display a good number of ancient Indian paintings, coins, fabrics, arms, artifacts, etc. The museum collection is huge and has some fine sculptures from the excavation at Bhokardan, a nearby historic site.","summarySource":"wikivoyage","wikivoyageTitle":"Aurangabad","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Bibi_Ka_Maqbara_Aurangabad-02.jpg/1280px-Bibi_Ka_Maqbara_Aurangabad-02.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Bibi_Ka_Maqbara_Aurangabad-02.jpg/500px-Bibi_Ka_Maqbara_Aurangabad-02.jpg","w":1200,"h":800,"author":"Biswas Dibyendu","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Bibi_Ka_Maqbara_Aurangabad-02.jpg"}},{"id":"aurangabad_wv_shrimant_chatrapati_shivaji_raje_museum","areaId":"aurangabad","name":"Shrimant Chatrapati Shivaji Raje Museum","category":"museum","tags":["museums"],"location":{"lat":19.8945,"lng":75.3352},"visitMinutes":120,"priceLevel":2,"photoSeed":"aurangabad_wv_shrimant_chatrapati_shivaji_raje_museum","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["shrimantchatrapatishivajirajemuseum","aurangabad"],"hours":{"week":[null,{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Closed Mon; Typical hours — check the official site"},"summary":"As the name suggests, this museum is dedicated to the great warrior of Maharashtra - Chatrapati Shivaji Maharaj. A number of exhibits associated with Lord Shivaji are on display.","summarySource":"wikivoyage","wikivoyageTitle":"Aurangabad"},{"id":"aurangabad_wv_siddharth_garden","areaId":"aurangabad","name":"Siddharth Garden","category":"park","tags":["nature","photo"],"location":{"lat":19.8784,"lng":75.3143},"visitMinutes":60,"priceLevel":0,"photoSeed":"aurangabad_wv_siddharth_garden","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["siddharthgarden","aurangabad"],"bestLight":"golden","summary":"This is a beautiful landscaped garden, with good variety of trees and shrubs. There is a small aquarium inside the garden, however the biggest attraction is the Siddharth Garden Zoo, with a large variety of animals, viz. lions, tigers (white & Bengal), leopards, crocodiles, snakes (snake-house), civet cats, hyena, fox, porcupine, emu, deer and sprawling lawns to sit and have a great picnic.","summarySource":"wikivoyage","wikivoyageTitle":"Aurangabad"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}