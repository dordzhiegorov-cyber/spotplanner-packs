ativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:ET-Red_Terror_Martyr_Memorial_Museum,_Addis_Abeba_(2).JPG"}},{"id":"addis_ababa_yekatit_12_monument","areaId":"addis_ababa","name":"Yekatit 12 monument","category":"monument","tags":["history","photo"],"location":{"lat":9.04378,"lng":38.7612},"visitMinutes":30,"priceLevel":0,"photoSeed":"addis_ababa_yekatit_12_monument","tickets":[],"signals":{"commonsDepicts":5,"commonsNearby":4,"wikiPageviews":174,"wikidataSitelinks":10,"fetchedAt":"2026-10-19"},"hashtags":["yekatit12monument","addisababa"],"bestLight":"morning","summary":"The Yekatit 12 monument is a memorial in Addis Ababa commemorating the Yekatit 12 pogrom, an Italian war crime in Ethiopia. The pogrom took place from 19 to 21 February 1937 and is known as Yekatit 12 after the start date in the Ethiopian calendar.","summarySource":"wikipedia","wikipediaTitle":"Yekatit 12 monument","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Antun_Augustin%C4%8Di%C4%87_e_Frano_Kr%C5%A1ini%C4%87%2C_monumento_allo_yehkatit_12%2C_1955%2C_01.jpg/1280px-Antun_Augustin%C4%8Di%C4%87_e_Frano_Kr%C5%A1ini%C4%87%2C_monumento_allo_yehkatit_12%2C_1955%2C_01.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Antun_Augustin%C4%8Di%C4%87_e_Frano_Kr%C5%A1ini%C4%87%2C_monumento_allo_yehkatit_12%2C_1955%2C_01.jpg/500px-Antun_Augustin%C4%8Di%C4%87_e_Frano_Kr%C5%A1ini%C4%87%2C_monumento_allo_yehkatit_12%2C_1955%2C_01.jpg","w":1200,"h":672,"author":"Sailko","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Antun_Augustin%C4%8Di%C4%87_e_Frano_Kr%C5%A1ini%C4%87,_monumento_allo_yehkatit_12,_1955,_01.jpg"}},{"id":"addis_ababa_ethnological_museum_addis_ababa","areaId":"addis_ababa","name":"Ethnological Museum, Addis Ababa","category":"museum","tags":["museums"],"location":{"lat":9.04662,"lng":38.75762},"visitMinutes":120,"priceLevel":2,"photoSeed