0"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Typical hours — check the official site"},"summary":"Reopened in mid-2013 after complete renovation. Fewer than 200 animals from more than 100 species. Nice lion exhibit.","summarySource":"wikivoyage","wikivoyageTitle":"Bamako"},{"id":"bamako_wv_point_g_hill","areaId":"bamako","name":"Point G Hill","category":"landmark","tags":["photo"],"location":{"lat":12.67107,"lng":-8.01069},"visitMinutes":60,"priceLevel":1,"photoSeed":"bamako_wv_point_g_hill","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-22"},"hashtags":["pointghill","bamako"],"summary":"Houses caves with rock paintings, and offers good views across the city.","summarySource":"wikivoyage","wikivoyageTitle":"Bamako"},{"id":"bamako_wv_bla_bla","areaId":"bamako","name":"Bla Bla","category":"food","tags":["food"],"location":{"lat":12.65908,"lng":-7.97197},"visitMinutes":75,"priceLevel":3,"photoSeed":"bamako_wv_bla_bla","tickets":[],"signals":{},"hashtags":["blabla","bamako"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Bla Bla is where Bamako's upper crust go to relax and have a (expensive) cocktail or bottle of champagne. With a small but delicious African menu, a wide range of cocktails, and cold draft beer - it is one of the most popular restaurants to see and be seen. A starter here is around US$15. Also this place frequently has art exhibitions for local artists.","summarySource":"wikivoyage","wikivoyageTitle":"en:Bamako"},{"id":"bamako_wv_african_grill","areaId":"bamako","name":"African Grill","category":"food","tags":["food"],"location":{"lat":12.63876,"lng":-8.00289},"visitMinutes":75,"priceLevel":2,"photoSeed":"bamako_wv_african_grill","tickets":[],"signals":{},"hashtags":["africangrill","bamako"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Restaurant serving good authentic African cuisine, on a square just off a main road. Not luxurious but good. Beer and wine are available but, because of the proximity to a mosque, don't be surprised if on Fridays they ask you to keep the bottles out of sight on the floor. They have a second location at the Musée National.","summarySource":"wikivoyage","wikivoyageTitle":"en:Bamako"},{"id":"bamako_wv_broadway_cafe_badala","areaId":"bamako","name":"Broadway Café Badala","category":"food","tags":["food"],"location":{"lat":12.61697,"lng":-7.97898},"visitMinutes":75,"priceLevel":3,"photoSeed":"bamako_wv_broadway_cafe_badala","tickets":[{"vendor":"Official","url":"https://broadwaybadala.com/","official":true}],"signals":{},"hashtags":["broadwaycafebadala","bamako"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"A Western style restaurant which is pretty much the only place you can find a \"real\" hamburger with \"real\" cheese. Also on the menu are breakfast burritos, chicken wings, and shakes. Great if you are missing the comforts of home. Burgers only run US$4 without fries but expect to pay up to $12 for a full starter.","summarySource":"wikivoyage","wikivoyageTitle":"en:Bamako"},{"id":"bamako_wv_appaloosa","areaId":"bamako","name":"Appaloosa","category":"food","tags":["food"],"location":{"lat":12.63609,"lng":-7.99877},"visitMinutes":75,"priceLevel":2,"photoSeed":"bamako_wv_appaloosa","tickets":[],"signals":{},"hashtags":["appaloosabamako","bamako"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Restaurant and bar. One of the strangest sights on earth. Malians in velour cowboy hats and vests serve Tex-Mex dishes in the restaurant while blond Russian professional women work the bar. Must be seen to be believed. The food isn't bad either.","summarySource":"wikivoyage","wikivoyageTitle":"en:Bamako"},{"id":"bamako_wv_hotel_badala","areaId":"bamako","name":"Hotel Badala","category":"food","tags":["food"],"location":{"lat":12.62545,"lng":-7.98463},"visitMinutes":75,"photoSeed":"bamako_wv_hotel_badala","tickets":[],"signals":{},"hashtags":["hotelbadala","bamako"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Very well run, little known restaurant/brasserie. Excellent food (the Pave du boeuf is yummy). Excellent service. Small pool, outside tables. Near the river. Prices are relatively high for Mali but in Bamako you need a treat sometimes!","summarySource":"wikivoyage","wikivoyageTitle":"en:Bamako"},{"id":"bamako_wv_le_miniprix","areaId":"bamako","name":"Le Miniprix","category":"food","tags":["food"],"location":{"lat":12.66418,"lng":-7.97332},"visitMinutes":75,"photoSeed":"bamako_wv_le_miniprix","tickets":[],"signals":{},"hashtags":["leminiprix","bamako"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Supermarket Le Miniprix is actually the best one with the best service and with the lowest prices. They have a very clean store and are open 07:30-22:30. They also accept US and Canadian dollars, and euro.","summarySource":"wikivoyage","wikivoyageTitle":"en:Bamako"},{"id":"bamako_wv_le_bafing","areaId":"bamako","name":"Le Bafing","category":"food","tags":["food"],"location":{"lat":12.63645,"lng":-7.9978},"visitMinutes":75,"priceLevel":1,"photoSeed":"bamako_wv_le_bafing","tickets":[],"signals":{},"hashtags":["lebafing","bamako"],"hours":{"week":[{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"},{"open":"08:00","close":"23:00"}]},"summary":"Bistrot/restaurant/bar in a small street. Eating in a courtyard. Very good and friendly service. Daily special includes local dishes, à la carte steak, fish or spaghetti. Well stocked bar. Recommended.","summarySource":"wikivoyage","wikivoyageTitle":"en:Bamako"},{"id":"bamako_wv_ibiza","areaId":"bamako","name":"Ibiza","category":"nightlife","tags":["nightlife"],"location":{"lat":12.63916,"lng":-8.00287},"visitMinutes":90,"photoSeed":"bamako_wv_ibiza","tickets":[],"signals":{},"hashtags":["ibizabamako","bamako"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"Around midnight the Malians come alive; this is a nice nightclub with a variety of dance music from international to local dance tracks.","summarySource":"wikivoyage","wikivoyageTitle":"en:Bamako"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}