ipedia/commons/thumb/f/fb/GlenrockLagoonFromLeichhardtLookout.JPG/1280px-GlenrockLagoonFromLeichhardtLookout.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fb/GlenrockLagoonFromLeichhardtLookout.JPG/500px-GlenrockLagoonFromLeichhardtLookout.JPG","w":1200,"h":900,"author":"Athol Mullen","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:GlenrockLagoonFromLeichhardtLookout.JPG"}},{"id":"newcastle_castlemaine_brewery","areaId":"newcastle","name":"Castlemaine Brewery","category":"landmark","tags":["history","photo"],"location":{"lat":-32.9256,"lng":151.758},"visitMinutes":45,"priceLevel":0,"photoSeed":"newcastle_castlemaine_brewery","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":16,"wikiPageviews":54,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["castlemainebrewery","newcastle"],"bestLight":"morning","summary":"Castlemaine Brewery is a heritage-listed former brewery and museum and now serviced apartments at 787 Hunter Street, Newcastle West, New South Wales, Australia. It was designed by Oswald Lewis and built from 1874 to 1876 by Laing and Wylie under supervising architect G. H. Cox.","summarySource":"wikipedia","wikipediaTitle":"Castlemaine Brewery, Newcastle","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/5/59/312_-_Castlemaine_Brewery_%28former%29_%285001219b1%29.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/5/59/312_-_Castlemaine_Brewery_%28former%29_%285001219b1%29.jpg","w":1200,"h":1600,"author":"Lucy More","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:312_-_Castlemaine_Brewery_(former)_(5001219b1).jpg"}},{"id":"newcastle_old_newcastle_east_public_school","areaId":"newcastle","name":"Old Newcastle East Public School","category":"landmark","tags":["history","photo"],"location":{"lat":-32.9295,"lng":151.7822},"visitMinutes":45,"priceLevel":0,"photoSeed":"newcastle_old_newcastle_east_public_school","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":89,"wikiPageviews":20,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["oldnewcastleeastpublicschool","newcastle"],"bestLight":"morning","summary":"Old Newcastle East Public School is a heritage-listed former school building at 58 Bolton Street, Newcastle, City of Newcastle, New South Wales, Australia. It was designed by Walter Liberty Vernon and built from 1908 to 1912. It is also known as Newcastle Public School.","summarySource":"wikipedia","wikipediaTitle":"Old Newcastle East Public School","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/4/49/795_-_Newcastle_Annexe_%285011939b1%29.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/4/49/795_-_Newcastle_Annexe_%285011939b1%29.jpg","w":1200,"h":900,"author":"Lucy Moore","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:795_-_Newcastle_Annexe_(5011939b1).jpg"}},{"id":"newcastle_coal_river_precinct","areaId":"newcastle","name":"Coal River Precinct","category":"landmark","tags":["history","photo"],"location":{"lat":-32.924,"lng":151.792},"visitMinutes":45,"priceLevel":0,"photoSeed":"newcastle_coal_river_precinct","tickets":[],"signals":{"commonsDepicts":3,"commonsNearby":21,"wikiPageviews":43,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["coalriverprecinct","newcastle"],"bestLight":"morning","summary":"Coal River Precinct is a heritage-listed historic precinct at Nobbys Road, Newcastle, New South Wales, Australia. It was built from 1804 to 1960. It includes Fort Scratchley, Nobbys Head, the Convict Lumber Yard site, Macquarie Pier, the breakwater and Nobby's Beach.","summarySource":"wikipedia","wikipediaTitle":"Coal River Precinct","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/ad/Nobbys_Head.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/a/ad/Nobbys_Head.jpg","w":1200,"h":900,"author":"Macr, Mark McIntosh","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Nobbys_Head.jpg"}},{"id":"newcastle_earp_gillam_bond_store","areaId":"newcastle","name":"Earp Gillam Bond Store","category":"landmark","tags":["history","photo"],"location":{"lat":-32.92667,"lng":151.78677},"visitMinutes":45,"priceLevel":0,"photoSeed":"newcastle_earp_gillam_bond_store","tickets":[],"signals":{"commonsDepicts":7,"commonsNearby":38,"wikiPageviews":20,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["earpgillambondstore","newcastle"],"bestLight":"morning","summary":"The Earp Gillam Bond Store is a heritage-listed former bond store at 16 Telford Street, Newcastle East, in the Hunter region of New South Wales, Australia. It was added to the New South Wales State Heritage Register on 2 April 1999.","summarySource":"wikipedia","wikipediaTitle":"Earp Gillam Bond Store","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Earp_Gillam_Bond_Store.jpg/1280px-Earp_Gillam_Bond_Store.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Earp_Gillam_Bond_Store.jpg/500px-Earp_Gillam_Bond_Store.jpg","w":1200,"h":800,"author":"Willzc","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Earp_Gillam_Bond_Store.jpg"}}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}