s","photo"],"location":{"lat":34.16742,"lng":77.59032},"visitMinutes":90,"priceLevel":1,"photoSeed":"leh_namgyal_tsemo_monastery","tickets":[],"signals":{"commonsDepicts":6,"commonsNearby":65,"wikiPageviews":415,"wikidataSitelinks":5,"fetchedAt":"2026-10-22"},"hashtags":["namgyaltsemomonastery","leh"],"bestLight":"golden","summary":"Namgyal Tsemo Monastery or Namgyal Tsemo Gompa is a Buddhist monastery in Leh city of Leh district, Ladakh, northern India. Founded by King Tashi Namgyal (1555-1575) of Ladakh, it has a three-story high gold statue of Maitreya Buddha and ancient manuscripts and frescoes. It is situated near the Tsemo Castle.","summarySource":"wikipedia","wikipediaTitle":"Namgyal Tsemo Monastery","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/57/Leh_Palace%2C_Leh%2C_Ladakh.jpg/1280px-Leh_Palace%2C_Leh%2C_Ladakh.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/57/Leh_Palace%2C_Leh%2C_Ladakh.jpg/500px-Leh_Palace%2C_Leh%2C_Ladakh.jpg","w":1200,"h":835,"author":"Karunakar Rayker from India","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Leh_Palace,_Leh,_Ladakh.jpg"}},{"id":"leh_tsemo_castle","areaId":"leh","name":"Tsemo Castle","category":"monument","tags":["history","photo","views"],"location":{"lat":34.1675,"lng":77.5906},"visitMinutes":120,"priceLevel":2,"photoSeed":"leh_tsemo_castle","tickets":[],"signals":{"commonsDepicts":31,"commonsNearby":65,"wikiPageviews":78,"wikidataSitelinks":2,"fetchedAt":"2026-10-22"},"hashtags":["tsemocastle","leh"],"hours":{"week":[{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Typical hours — check the official site"},"bestLight":"morning","summary":"Tsemo Castle is an important religious and historical point