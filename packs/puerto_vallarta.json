 John Huston","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/b/bc/JohnHustoninPV.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/b/bc/JohnHustoninPV.jpg","w":1200,"h":1647,"author":"User Carptrash on en.wikipedia","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:JohnHustoninPV.jpg"}},{"id":"puerto_vallarta_triton_y_sirena","areaId":"puerto_vallarta","name":"Tritón y Sirena","category":"monument","tags":["art","photo"],"location":{"lat":20.60972,"lng":-105.23525},"visitMinutes":20,"priceLevel":0,"photoSeed":"puerto_vallarta_triton_y_sirena","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":338,"wikiPageviews":38,"wikidataSitelinks":2,"fetchedAt":"2026-10-21"},"hashtags":["tritonysirena","puertovallarta"],"bestLight":"morning","summary":"Tritón y Sirena is a sculpture by Carlos Espino, installed along Puerto Vallarta's Malecón, in the Mexican state of Jalisco. Installed the 1990, the artwork depicts Triton and a Siren.","summarySource":"wikipedia","wikipediaTitle":"Tritón y Sirena","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/76/Puerto_Vallarta%2C_March_2023_-_119.jpg/1280px-Puerto_Vallarta%2C_March_2023_-_119.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/76/Puerto_Vallarta%2C_March_2023_-_119.jpg/500px-Puerto_Vallarta%2C_March_2023_-_119.jpg","w":1200,"h":1600,"author":"Another Believer","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Puerto_Vallarta,_March_2023_-_119.jpg"}},{"id":"puerto_vallarta_the_rotunda_by_the_sea","areaId":"puerto_vallarta","name":"The Rotunda by the Sea","category":"monument","tags":["art","photo"],"location":{"lat":20.61144,"lng":-105.23461},"visitMinutes":20,"priceLevel":0,"photoSeed":"puerto_vallarta_the_rotunda_by_the_sea","tickets":[],"signals":{"commonsDepicts":1,"commonsNearby":216,