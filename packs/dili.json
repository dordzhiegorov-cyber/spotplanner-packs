ida_de_balide","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":15,"wikidataSitelinks":2,"fetchedAt":"2026-10-23"},"hashtags":["avenidadebalide","dili"],"bestLight":"golden","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/DSCI2906_Avenida_de_Balide.jpg/1280px-DSCI2906_Avenida_de_Balide.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/DSCI2906_Avenida_de_Balide.jpg/500px-DSCI2906_Avenida_de_Balide.jpg","w":1200,"h":900,"author":"Ludwig Müller","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:DSCI2906_Avenida_de_Balide.jpg"}},{"id":"dili_wv_timor_plaza","areaId":"dili","name":"Timor Plaza","category":"food","tags":["food"],"location":{"lat":-8.55352,"lng":125.5413},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_timor_plaza","tickets":[],"signals":{},"hashtags":["timorplaza","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Has a food court with western and Asian dishes, at higher prices than elsewhere. Makanan, the Indian-Malay place with roti canai, martabak and briyani, may be the best option (Il Gelato is in the same shop, with the best ice cream in Dili). There is a Gloria Jean's with reliable coffee but terrible breakfasts. Elsewhere in Timor Plaza are some cafes, a donut shop and a rooftop restaurant.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_bebonuk_beach_bbqs","areaId":"dili","name":"Bebonuk beach BBQs","category":"food","tags":["food"],"location":{"lat":-8.54135,"lng":125.54355},"visitMinutes":75,"priceLevel":1,"photoSeed":"dili_wv_bebonuk_beach_bbqs","tickets":[],"signals":{},"hashtags":["bebonukbeachbbqs","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"This is a string of identical BBQs that sets up every evening on the beach, serving excellent chicken, pork and fish skewers for about $1 each (they may try to overcharge foreigners) as well as katapas (rice cooked in coconut milk). Gets very messy but it is surely the best value beach dinner in Dili. The stalls set up low tables and chairs straight on the beach.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_caz_bar","areaId":"dili","name":"Caz Bar","category":"food","tags":["food"],"location":{"lat":-8.53393,"lng":125.61507},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_caz_bar","tickets":[],"signals":{},"hashtags":["cazbar","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Great for drinks or food on the beach (just find the plastic tables and chairs on the sand, or ask staff to get some for you; the main bar is across the road and under cover). Big menu of mostly-western items that are good value considering the location and quality.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_queen_tundriee","areaId":"dili","name":"Queen Tundriee","category":"food","tags":["food"],"location":{"lat":-8.55418,"lng":125.5668},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_queen_tundriee","tickets":[],"signals":{},"hashtags":["queentundriee","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"It can't decide on how to spell tandoori (you'll see tundriee, tundaree, tanduree, tondroori and others), but they know how to do it. Excellent tandoori chicken, samosas and daals, plus many other dishes, including great vegetable dishes.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_arriba","areaId":"dili","name":"Arriba","category":"food","tags":["food"],"location":{"lat":-8.54838,"lng":125.56054},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_arriba","tickets":[],"signals":{},"hashtags":["arribadili","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"A good opportunity to savour some of the worst Mexican food in the world. Very bland, poorly-made and quite expensive. Despite being the only Mexican option in town, still doesn't seem to get much business.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_tower","areaId":"dili","name":"Tower","category":"nightlife","tags":["nightlife"],"location":{"lat":-8.55379,"lng":125.55933},"visitMinutes":90,"photoSeed":"dili_wv_tower","tickets":[],"signals":{},"hashtags":["towerdili","dili"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"One of the hippest bars in town, it fills up with locals and expats (especially Portuguese) from about 23:00. $5 cover charge includes a drink. It's partly outdoors but still fills with cigarette smoke.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_new_88","areaId":"dili","name":"New 88","category":"food","tags":["food"],"location":{"lat":-8.55799,"lng":125.58369},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_new_88","tickets":[],"signals":{},"hashtags":["new88","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Also has a branch at Landmark and maybe others. Best Chinese food in town according to many Chinese, reliable place to get duck, but relatively expensive for Dili.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_little_pattaya","areaId":"dili","name":"Little Pattaya","category":"food","tags":["food"],"location":{"lat":-8.54651,"lng":125.60102},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_little_pattaya","tickets":[],"signals":{},"hashtags":["littlepattaya","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Combination Thai/Lebanese restaurant. Not the greatest food but probably the nicest setting of the beachfront restaurants and great for groups.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_panorama","areaId":"dili","name":"Panorama","category":"food","tags":["food"],"location":{"lat":-8.55327,"lng":125.54238},"visitMinutes":75,"priceLevel":3,"photoSeed":"dili_wv_panorama","tickets":[],"signals":{},"hashtags":["panoramadili","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Excellent views over Dili but disappointing food for the price. Just drink at the bar and get some satay sticks instead.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_kaliber_12","areaId":"dili","name":"Kaliber 12","category":"nightlife","tags":["nightlife"],"location":{"lat":-8.55675,"lng":125.58713},"visitMinutes":90,"photoSeed":"dili_wv_kaliber_12","tickets":[],"signals":{},"hashtags":["kaliber12","dili"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"24 jam! This corner store blasts music 24 hours a day. You can buy a beer at shop prices, sit outside and meet locals.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_kathy_s_cafe","areaId":"dili","name":"Kathy's Cafe","category":"food","tags":["food"],"location":{"lat":-8.53312,"lng":125.61514},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_kathy_s_cafe","tickets":[],"signals":{},"hashtags":["kathyscafe","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Part of Beachside Hotel, it's the other western place on the Areia Branca. Excellent breakfasts eaten on the sand.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_golden_star","areaId":"dili","name":"Golden Star","category":"food","tags":["food"],"location":{"lat":-8.55706,"lng":125.58679},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_golden_star","tickets":[],"signals":{},"hashtags":["goldenstar","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Attractive Chinese restaurant in the suburbs with a few interesting \"Timorese\" dishes, like the saboco fish dish.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_castaway","areaId":"dili","name":"Castaway","category":"food","tags":["food"],"location":{"lat":-8.54831,"lng":125.56008},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_castaway","tickets":[],"signals":{},"hashtags":["castawaydili","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"One of the hippest and most reliable western joints. Good food, good staff, good crowd and views over the water.","summarySource":"wikivoyage","wikivoyageTitle":"en:Dili"},{"id":"dili_wv_linivon","areaId":"dili","name":"Linivon","category":"food","tags":["food"],"location":{"lat":-8.55354,"lng":125.58816},"visitMinutes":75,"priceLevel":2,"photoSeed":"dili_wv_linivon","tickets":[],"signals":{},"hashtags":["linivondili","dili"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},