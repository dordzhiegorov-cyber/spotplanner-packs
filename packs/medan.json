v_ondo_grill_batak","areaId":"medan","name":"OnDo Grill Batak","category":"food","tags":["food"],"location":{"lat":3.59844,"lng":98.66006},"visitMinutes":75,"priceLevel":2,"photoSeed":"medan_wv_ondo_grill_batak","tickets":[],"signals":{},"hashtags":["ondogrillbatak","medan"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"A unique Batak restaurant where you can find the gems of Batak dishes, without all the germs. Cafe-like ambience with non-stop jazz music. Serves a reasonably-tasting saksang (a pork dish cooked in pork blood), babi panggang karo (Batak/Karo-style chopped roast-pork) and arsik (Batak-style fish dish). Don't forget to taste the hot pora-pora (a dish of sauteed papaya and cassava leaves cooked in co","summarySource":"wikivoyage","wikivoyageTitle":"en:Medan"},{"id":"medan_wv_pagaruyung_alley","areaId":"medan","name":"Pagaruyung Alley","category":"food","tags":["food"],"location":{"lat":3.58447,"lng":98.6703},"visitMinutes":75,"priceLevel":1,"photoSeed":"medan_wv_pagaruyung_alley","tickets":[],"signals":{},"hashtags":["pagaruyungalley","medan"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Located in Medan's \"Little India\" or Kampung Keling as it's called by locals. They offer, of course, Indian and Indonesian cuisine. Business begins when the sun sets and goes until 02:00 Well known for satay (chicken, lamb, mutton, liver, intestine, etc.), fried rice and martabak telur (egg pancake topped with diced potatoes, and onions, often served with curry). Also excellent Minang style \"pick ","summarySource":"wikivoyage","wikivoyageTitle":"en:Medan"},{"id":"medan_wv_the_tavern_pub","areaId":"medan","name":"The Tavern Pub","category":"nightlife","tags":["nightlife"],"location":{"lat":3.58246,"lng":98.67623},"visitMinutes":90,"photoSeed":"medan_wv_the_tavern_pub","tickets":[],"signals":{},"hashtags":["thetavernpub","medan"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"Dulunya merupakan salah satu bar yang paling populer bagi para ekspatriat di kota ini, tetapi sekarang sudah agak kumuh dan menarik perhatian orang-orang dari kalangan bawah. Tempat ini menyuguhkan musik langsung dari band-band lokal. Tempat ini cukup kecil, dan cukup populer serta ramai di akhir pekan dengan dipenuhi sekelompok teman muda-mudi, pasangan pacaran, dan beberapa gadis yang cukup rama","summarySource":"wikivoyage","wikivoyageTitle":"id:Medan"},{"id":"medan_wv_koki_sunda","areaId":"medan","name":"Koki Sunda","category":"food","tags":["food"],"location":{"lat":3.58267,"lng":98.66688},"visitMinutes":75,"priceLevel":2,"photoSeed":"medan_wv_koki_sunda","tickets":[],"signals":{},"hashtags":["kokisunda","medan"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"As the name implies, serves tasty Sundanese food and beverages such as Nasi Liwet and Es Delima. It's at the heart of the city at the corner of S.Parman and Hasanuddin so it's hard to miss if you travel around the city. Its reasonably priced and wide array selection of delicious food is well known to the locals and visitors. Koki Sunda now opens in Tanjung Morawa and Pekan Baru.","summarySource":"wikivoyage","wikivoyageTitle":"en:Medan"},{"id":"medan_wv_tip_top_restaurant","areaId":"medan","name":"Tip Top Restaurant","category":"food","tags":["food"],"location":{"lat":3.58602,"lng":98.67982},"visitMinutes":75,"priceLevel":2,"photoSeed":"medan_wv_tip_top_restaurant","tickets":[{"vendor":"Official","url":"http://www.tiptop-medan.com/","official":true}],"signals":{},"hashtags":["tiptoprestaurant","medan"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Used to be the restaurant in Medan, this unique restaurant can trace its history back to the Dutch colonisation. The food has a nostalgic taste clinging on every bite, such as the ox-tongue sandwich and the bitter-ballen, but the best experience you could have here is watching the buzz of Kesawan Square from your rattan chair on the verandah. Also famous for its cake.","summarySource":"wikivoyage","wikivoyageTitle":"en:Medan","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/5/5a/Tiptop.JPG","thumb":"https://upload.wikimedia.org/wikipedia/commons/5/5a/Tiptop.JPG","w":1200,"h":913,"author":"Iijjccoo at Dutch Wikipedia","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Tiptop.JPG"}},{"id":"medan_wv_kedai_kopi_apek","areaId":"medan","name":"Kedai Kopi Apek","category":"food","tags":["food"],"location":{"lat":3.58744,"lng":98.67731},"visitMinutes":75,"priceLevel":1,"photoSeed":"medan_wv_kedai_kopi_apek","tickets":[],"signals":{},"hashtags":["kedaikopiapek","medan"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Historic coffee house with excellent Lintong Coffee served up by Apek. This place was set up by Apek's father in 1922. Serves kopi susu and roti bakar srikaya (kaya toast). Contains stalls with Indian roti cane bread with goat curry, martabak and soto soup. Outside are nasi gurih, bakmi and kwetiau noodles. Piece of Medan history.","summarySource":"wikivoyage","wikivoyageTitle":"en:Medan"},{"id":"medan_wv_cahaya_baru_indian_restaurant","areaId":"medan","name":"Cahaya Baru Indian Restaurant","category":"food","tags":["food"],"location":{"lat":3.58341,"lng":98.66886},"visitMinutes":75,"priceLevel":1,"photoSeed":"medan_wv_cahaya_baru_indian_restaurant","tickets":[],"signals":{},"hashtags":["cahayabaruindianrestaurant","medan"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"The North and south Indian restaurant is one of Medan's best kept secrets, which has been featured in Kompas newspaper as the only restaurant in Medan which serves a wide range of authentic North-Indian cuisine. It offers delicious vegetarian and curry dishes.","summarySource":"wikivoyage","wikivoyageTitle":"en:Medan"},{"id":"medan_wv_medan_home_dairy","areaId":"medan","name":"Medan Home Dairy","category":"food","tags":["food"],"location":{"lat":3.54985,"lng":98.62424},"visitMinutes":75,"photoSeed":"medan_wv_medan_home_dairy","tickets":[{"vendor":"Official","url":"http://medandairy.weebly.com","official":true}],"signals":{},"hashtags":["medanhomedairy","medan"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","