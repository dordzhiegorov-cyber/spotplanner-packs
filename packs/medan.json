_View,_Tjong_A_Fie_Mansion,_Medan.jpg"}},{"id":"medan_rumah_tjong_a_fie","areaId":"medan","name":"Rumah Tjong A Fie","category":"landmark","tags":["photo"],"location":{"lat":3.58545,"lng":98.68033},"visitMinutes":60,"priceLevel":1,"photoSeed":"medan_rumah_tjong_a_fie","tickets":[{"vendor":"Official","url":"https://tjongafiemansion.org/","official":true}],"signals":{"commonsDepicts":2,"commonsNearby":8,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["rumahtjongafie","medan"],"summary":"Rumah besar ini dibangun oleh seorang pengusaha penting di Medan, seorang pemimpin komunitas Tionghoa lokal yang membentuk beberapa usaha bisnis dan sukses di masa hidupnya, bekerja dengan otoritas kolonial Belanda, Muslim Indonesia, pemilik perkebunan, eksportir dan pedagang di seluruh dunia dari semua golongan. Karena kekayaannya yang besar dan kegiatan filantropis yang melibatkan masjid, rumah ","summarySource":"wikivoyage","wikivoyageTitle":"id:Medan","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Skewed_Front_View%2C_Tjong_A_Fie_Mansion%2C_Medan.jpg/1280px-Skewed_Front_View%2C_Tjong_A_Fie_Mansion%2C_Medan.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Skewed_Front_View%2C_Tjong_A_Fie_Mansion%2C_Medan.jpg/500px-Skewed_Front_View%2C_Tjong_A_Fie_Mansion%2C_Medan.jpg","w":1200,"h":798,"author":"Pratyeka","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Skewed_Front_View,_Tjong_A_Fie_Mansion,_Medan.jpg"}},{"id":"medan_tirtanadi_water_tower","areaId":"medan","name":"Tirtanadi Water Tower","category":"landmark","tags":["views","photo"],"location":{"lat":3.58226,"lng":98.6851},"visitMinutes":60,"priceLevel":2,"photoSeed":"medan_tirtanadi_water_tower","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":10,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["tirtanadiwatertower","medan"],"hours":{"week":[{"open":"10:00","close":"19:00"},{"open":"10:00","close":"19:00"},{"open":"10:00","close":"19:00"},{"open":"10:00","close":"19:00"},{"open":"10:00","close":"19:00"},{"open":"10:00","close":"19:00"},{"open":"10:00","close":"19:00"}],"note":"Typical hours — check the official site"},"bestLight":"sunset","summary":"One of Medan's icons, the water tower was built by the Dutch government in 1908 with a height of 42 m. It is state-owned by PDAM Tirtanadi.","summarySource":"wikivoyage","wikivoyageTitle":"en:Medan","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/5/59/Tirta_Tower.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/5/59/Tirta_Tower.jpg","w":1200,"h":1600,"author":"ARamadhan at English Wikipedia","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Tirta_Tower.jpg"}},{"id":"medan_menara_air_tirtanadi","areaId":"medan","name":"Menara Air Tirtanadi","category":"landmark","tags":["photo"],"location":{"lat":3.58226,"lng":98.6851},"visitMinutes":60,"priceLevel":1,"photoSeed":"medan_menara_air_tirtanadi","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":10,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["menaraairtirtanadi","medan"],"summary":"Salah satu ikon kota Medan, menara air ini dibangun oleh pemerintah Belanda pada tahun 1908 dengan ketinggian 42 m. Menara air ini dimiliki oleh PDAM Tirtanadi.","summarySource":"wikivoyage","wikivoyageTitle":"id:Medan","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/5/59/Tirta_Tower.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/5/59/Tirta_Tower.jpg","w":1200,"h":1600,"author":"ARamadhan at English Wikipedia","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Tirta_Tower.jpg"}},{"id":"medan_wv_jalan_selat_panjang_sumatra_semarang","areaId":"medan","name":"Jalan Selat Panjang/ Sumatra/ Semarang","category":"food","tags":["food"],"location":{"lat":3.58335,"lng":98.6848},"visitMinutes":75,"priceLevel":2,"ph