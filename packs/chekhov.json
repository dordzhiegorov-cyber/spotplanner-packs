ws":4,"wikidataSitelinks":2,"fetchedAt":"2026-10-25"},"hashtags":["balanbashchekhov","chekhov"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"}],"note":"Typical hours — check the official site"},"bestLight":"morning","names":{"de":"Balanbasch","ru":"Баланбаш"}},{"id":"chekhov_wv_dom_kuptsa_markova","areaId":"chekhov","name":"Дом купца Маркова","category":"landmark","tags":["photo"],"location":{"lat":55.14443,"lng":37.45286},"visitMinutes":60,"priceLevel":1,"photoSeed":"chekhov_wv_dom_kuptsa_markova","tickets":[],"signals":{"commonsNearby":19,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["домкупцамаркова","chekhov"],"summary":"Купцы Марковы происходили из расположенного близ Лопасни села Репниково, владели лесами в окрестностях Любучан и занимались лесоторговлей. Сохранился их дом рядом со зданием Синельщиковых, несколько подрастерявший декор за годы советской власти.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Чехов"},{"id":"chekhov_wv_dom_kuptsa_sinelshchikova","areaId":"chekhov","name":"Дом купца Синельщикова","category":"landmark","tags":["photo"],"location":{"lat":55.14476,"lng":37.45306},"visitMinutes":60,"priceLevel":1,"photoSeed":"chekhov_wv_dom_kuptsa_sinelshchikova","tickets":[],"signals":{"commonsNearby":17,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["домкупцасинельщикова","chekhov"],"summary":"Чеховские купцы Синельщиковы сделали своё состояние на торговле мукой, которую они скупали у крестьян южнороссийских губерний, поэтому на первом этаже их дома располагались мучные лавки. На втором этаже находился трактир, в котором чаще всего бывали рабочие окрестных фабрик промышленника Медведева, и не удивительно, что в этом здании в 1905-1906 годах проходили наиболее активные митинги под руково","summarySource":"wikivoyage","wikivoyageTitle":"ru:Чехов"},{"id":"chekhov_wv_zdanie_rayzdravotdela","areaId":"chekhov","name":"Здание Райздравотдела","category":"landmark","tags":["photo"],"location":{"lat":55.14497,"lng":37.45543},"visitMinutes":60,"priceLevel":1,"photoSeed":"chekhov_wv_zdanie_rayzdravotdela","tickets":[],"signals":{"commonsNearby":15,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["зданиерайздравотдела","chekhov"],"summary":"Здание единого диспансера Лопасненского райздравотдела – именно так называлась организация, размещавшаяся в здании в 1920-е годы – представляет собой интересный образец архитектуры с чертами модерна. Датировка не отличается большой определённостью: здание построено то ли в конце 1910-х годов, то ли в начале 1920-х. Сейчас его занимают аптека и коммерческие фирмы.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Чехов","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/b/b6/2013_%D1%8F%D0%BD%D0%B2%D0%B0%D1%80%D1%8C_-_panoramio.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/b/b6/2013_%D1%8F%D0%BD%D0%B2%D0%B0%D1%80%D1%8C_-_panoramio.jpg","w":1200,"h":726,"author":"Валерий Дед","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:2013_%D1%8F%D0%BD%D0%B2%D0%B0%D1%80%D1%8C_-_panoramio.jpg"}},{"id":"chekhov_wv_dom_kuptsa_filippa_matveeva","areaId":"chekhov","name":"Дом купца Филиппа Матвеева","category":"landmark","tags":["photo"],"location":{"lat":55.14329,"lng":37.4522},"visitMinutes":60,"priceLevel":1,"photoSeed":"chekhov_wv_dom_kuptsa_filippa_matveeva","tickets":[{"vendor":"Official","url":"https://мплк.рф","official":true}],"signals":{"commonsNearby":11,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["домкупцафилиппаматвеева","chekhov"],"summary":"Симпатичный домик с декором в кирпичном стиле был построен в начале XIX века купцом Филиппом Матвеевым. На втором этаже располагались жилые комнаты, а на первом Матвеев держал «Рейнский погребок» – так в Российской Империи назывались винные лавки, где можно были приобрести алкоголь навынос. В советское время в здании располагалось отделение милиции, а в 2018 году в здании была размещена экспозиция","summarySource":"wikivoyage","wikivoyageTitle":"ru:Чехов"},{"id":"chekhov_wv_dom_ryumina_gde_byval_l_n_tolstoy","areaId":"chekhov","name":"Дом Рюмина, где бывал Л.Н. Толстой","category":"landmark","tags":["photo"],"location":{"lat":55.14238,"lng":37.45174},"visitMinutes":60,"priceLevel":1,"photoSeed":"chekhov_wv_dom_ryumina_gde_byval_l_n_tolstoy","tickets":[],"signals":{"commonsNearby":10,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["домрюминагдебываллнтолстой","chekhov"],"summary":"Исторический дом, в котором сейчас находится военкомат, был владением семьи Рюминых, которым также принадлежала усадьба Садки. На первом этаже здания работал постоялый двор, где останавливался, в частности, Лев Толстой в своих путешествиях из Москвы в [[Ясная Поляна","summarySource":"wikivoyage","wikivoyageTitle":"ru:Чехов"},{"id":"chekhov_wv_dom_kuptsa_yushina","areaId":"chekhov","name":"Дом купца Юшина","category":"landmark","tags":["photo"],"location":{"lat":55.14843,"lng":37.45632},"visitMinutes":60,"priceLevel":1,"photoSeed":"chekhov_wv_dom_kuptsa_yushina","tickets":[],"signals":{"commonsNearby":2,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["домкупцаюшина","chekhov"],"summary":"Красивый образец кирпичной эклектики конца XIX века, принадлежал купцу Юшину (в некоторых источниках - Юшкину), занимавшемуся кожевенным производством. В советское время в здании располагалась пожарная часть, из-за чего чеховчане старшего поколения этот дом называют «пожаркой».","summarySource":"wikivoyage","wikivoyageTitle":"ru:Чехов","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/%D0%A3%D1%81%D0%B0%D0%B4%D1%8C%D0%B1%D0%B0_%D0%BA%D1%83%D0%BF%D1%86%D0%B0_%D0%AE%D1%88%D0%BA%D0%B8%D0%BD%D0%B0.jpg/1280px-%D0%A3%D1%81%D0%B0%D0%B4%D1%8C%D0%B1%D0%B0_%D