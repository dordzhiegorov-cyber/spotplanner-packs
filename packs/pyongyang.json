dia/commons/thumb/2/22/Mansudae_Grand_Monument_18.JPG/1280px-Mansudae_Grand_Monument_18.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Mansudae_Grand_Monument_18.JPG/500px-Mansudae_Grand_Monument_18.JPG","w":1200,"h":889,"author":"Nicor","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Mansudae_Grand_Monument_18.JPG"}},{"id":"pyongyang_kim_il_sung_square","areaId":"pyongyang","name":"Kim Il Sung Square","category":"landmark","tags":["oldtown","photo"],"location":{"lat":39.01953,"lng":125.75247},"visitMinutes":30,"priceLevel":0,"photoSeed":"pyongyang_kim_il_sung_square","tickets":[],"signals":{"commonsDepicts":2,"commonsNearby":37,"wikiPageviews":1505,"wikidataSitelinks":34,"fetchedAt":"2026-10-19"},"hashtags":["kimilsungsquare","pyongyang"],"bestLight":"golden","summary":"Kim Il Sung Square (Korean: 김일성광장) is a large city square in the Central District of Pyongyang, North Korea, and is named after the country's founding leader, Kim Il Sung. The square was constructed in 1954 according to a master plan for reconstructing the capital after the destruction of the Korean War.","summarySource":"wikipedia","wikipediaTitle":"Kim Il Sung Square","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/Practising_a_torch_march_on_Kim_il-sung_square_11.JPG/1280px-Practising_a_torch_march_on_Kim_il-sung_square_11.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/Practising_a_torch_march_on_Kim_il-sung_square_11.JPG/500px-Practising_a_torch_march_on_Kim_il-sung_square_11.JPG","w":1200,"h":900,"author":"Nicor","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Practising_a_torch_march_on_Kim_il-sung_square_11.JPG"}},{"id":"pyongyang_grand_people_s_study_house","areaId":"pyongyang","name":"Grand People's Study House","category":"other","tags":["history"