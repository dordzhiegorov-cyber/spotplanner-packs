1%D0%BA%D0%BE%D0%B3%D0%BE_%D0%BB%D0%B8%D1%86%D0%B5%D1%8F_5.jpg/500px-%D0%97%D0%B4%D0%B0%D0%BD%D0%B8%D0%B5_%D1%81%D0%BE%D1%80%D1%82%D0%B2%D0%B0%D0%BB%D1%8C%D1%81%D0%BA%D0%BE%D0%B3%D0%BE_%D0%BB%D0%B8%D1%86%D0%B5%D1%8F_5.jpg","w":1200,"h":800,"author":"Sad sort","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:%D0%97%D0%B4%D0%B0%D0%BD%D0%B8%D0%B5_%D1%81%D0%BE%D1%80%D1%82%D0%B2%D0%B0%D0%BB%D1%8C%D1%81%D0%BA%D0%BE%D0%B3%D0%BE_%D0%BB%D0%B8%D1%86%D0%B5%D1%8F_5.jpg"}},{"id":"sortavala_vodonapornaya_bashnya_depo","areaId":"sortavala","name":"Водонапорная башня депо","category":"landmark","tags":["photo"],"location":{"lat":61.69803,"lng":30.6743},"visitMinutes":60,"priceLevel":1,"photoSeed":"sortavala_vodonapornaya_bashnya_depo","tickets":[],"signals":{"commonsDepicts":4,"commonsNearby":38,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["водонапорнаябашнядепо","sortavala"],"summary":"Водонапорная башня «на ножках» — один из ярчайших образцов функционализма и последнее здание, построенное финнами в Сортавале. Она была возведена в 1942 году по проекту Ярла Унгерна вместо взорванной советскими войсками при отступлении в 1941 году. Верхняя часть башни, напоминающая корабельную рубку — один из самых узнаваемых объектов города, который встречает всех прибывших по железной дороге.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала","names":{"ru":"Водонапорная башня (Сортавала)"}},{"id":"sortavala_osm_lyzhnyy_podemnik","areaId":"sortavala","name":"Лыжный подъёмник","category":"viewpoint","tags":["views","photo","sunset"],"location":{"lat":61.70519,"lng":30.67218},"visitMinutes":45,"priceLevel":0,"photoSeed":"sortavala_osm_lyzhnyy_podemnik","tickets":[],"signals":{"commonsNearby":45,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["лыжныйподъёмник","sortavala"],"bestLight":"sunset"},{"id":"sortavala_kompleks_postroek_depo_sortavala","areaId":"sortavala","name":"Комплекс построек депо Сортавала","category":"landmark","tags":["photo"],"location":{"lat":61.69814,"lng":30.67533},"visitMinutes":60,"priceLevel":1,"photoSeed":"sortavala_kompleks_postroek_depo_sortavala","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":44,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["комплекспостроекдепосортавала","sortavala"],"summary":"Комплекс построек веерного депо 1894 года с ремонтными мастерскими 1930-х годов и поворотным кругом. На конец 2020 года депо упразднено как отдельное учреждение и придано ТЧ-31 «Суоярви», но здесь базируется несколько локомотивов, в том числе три паровоза (2 серии Л и 1 серии П36) для «Рускеальского экспресса». К депо могут подойти все желающие.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала","names":{"ru":"Депо железнодорожное (Сортавала)"}},{"id":"sortavala_zdanie_lesnichestva","areaId":"sortavala","name":"Здание лесничества","category":"landmark","tags":["photo"],"location":{"lat":61.699,"lng":30.67798},"visitMinutes":60,"priceLevel":1,"photoSeed":"sortavala_zdanie_lesnichestva","tickets":[],"signals":{"commonsDepicts":1,"commonsNearby":39,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["зданиелесничества","sortavala"],"summary":"Один из самых изящных (и хорошо отреставрированных) образцов деревянного северного модерна построен в 1900 году архитектором Алваром Окерманом. Асимметричный фасад и богатая игра объёмов, создаваемая разными пристройками вроде сеней, мансарды и эркера с башенкой. Внутри сохранились облицованные кафелем печи-голландки. Изначально здесь находились гостиница с магазином, сейчас — управление сортаваль","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала","names":{"ru":"Дом жилой (дом приезжих \"Пяйвила\") (Сортавала)"}},{"id":"sortavala_osm_er788_81","areaId":"sortavala","name":"Эр788-81","category":"landmark","tags":["photo"],"location":{"lat":61.69919,"lng":30.67664},"visitMinutes":60,"priceLevel":1,"photoSeed":"sortavala_osm_er788_81","tickets":[],"signals":{"commonsNearby":36,"wikidataSitelinks":0,"fetchedAt":"2026-10-23"},"hashtags":["78881sortavala","sortavala"]},{"id":"sortavala_wv_kafe_kinza","areaId":"sortavala","name":"Кафе «Кинза»","category":"food","tags":["food"],"location":{"lat":61.7049,"lng":30.6942},"visitMinutes":75,"priceLevel":2,"photoSeed":"sortavala_wv_kafe_kinza","tickets":[{"vendor":"Official","url":"https://www.kinza.restaurant/","official":true}],"signals":{},"hashtags":["кафекинза","sortavala"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Уютное грузинское кафе на семь столиков, в меню есть также международная и карельская кухня. Заведение может похвастаться обширной винной картой, включающей в себя не только грузинские, но и европейские вина, а также вина из Нового Света по довольно демократичным ценам. Есть небольшой выбор крепкого алкоголя. Посетители отмечают, что при высоком качестве пищи обслуживание достаточно угловатое, а с","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала"},{"id":"sortavala_wv_kafe_relaks","areaId":"sortavala","name":"Кафе «Релакс»","category":"food","tags":["food"],"location":{"lat":61.70415,"lng":30.69281},"visitMinutes":75,"priceLevel":2,"photoSeed":"sortavala_wv_kafe_relaks","tickets":[],"signals":{},"hashtags":["каферелакс","sortavala"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Какие бы мысли ни навевало название заведения, это всё же классический ресторан, где быстро и вкусно готовят; особенно хороши супы на сырной основе. Никаких эксклюзивных блюд нет, но меню внушительных размеров. Приятная обстановка. Заведение некогда было лучшим в городе, хотя с увеличением конкуренции перешло в разряд средних. В отдельном помещении расположена небольшая кондитерская, где предлагаю","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала"},{"id":"sortavala_wv_kafe_uyut","areaId":"sortavala","name":"Кафе «Уют»","category":"food","tags":["food"],"location":{"lat":61.70298,"lng":30.69032},"visitMinutes":75,"priceLevel":2,"photoSeed":"sortavala_wv_kafe_uyut","tickets":[],"signals":{},"hashtags":["кафеуют","sortavala"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Единственное кафе города, работающее после полуночи. Цены чуть выше среднего, а вечерний контингент не отличается хорошими манерами, о чём красноречиво говорят ценники за разбитую посуду на последней странице меню. Тем не менее, еда тут достаточно вкусная, выбор блюд весьма широкий, а обслуживание порой даже слишком учтивое для таких посетителей. По понятным причинам, в меню есть выбор крепких алк","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала"},{"id":"sortavala_wv_kafe_krona","areaId":"sortavala","name":"Кафе «Крона»","category":"food","tags":["food"],"location":{"lat":61.70247,"lng":30.69397},"visitMinutes":75,"photoSeed":"sortavala_wv_kafe_krona","tickets":[],"signals":{},"hashtags":["кафекрона","sortavala"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Заведение на стыке кафе, столовой и финского кафетерия: в меню красивые десерты, рядом термос с кипятком и подогреваемые кувшины с кофе, но при этом в обед по ценам столовой дают суп и какую-нибудь котлету с картошкой. На завтрак хороший выбор омлетов и каши.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала"},{"id":"sortavala_wv_magazin_kulinar","areaId":"sortavala","name":"Магазин «Кулинар»","category":"food","tags":["food"],"location":{"lat":61.70312,"lng":30.69296},"visitMinutes":75,"photoSeed":"sortavala_wv_magazin_kulinar","tickets":[],"signals":{},"hashtags":["магазинкулинар","sortavala"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Магазин готовой еды с широким ассортиментом и низкими ценами, в числе прочего в продаже полуфабрикаты. Поесть негде, и вообще помещение крайне тесное, но среди местных жителей магазин очень популярен, так что обычно приходится стоять в очереди из 3-5 человек.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала"},{"id":"sortavala_wv_kafe_lamberg","areaId":"sortavala","name":"Кафе «Ламберг»","category":"food","tags":["food"],"location":{"lat":61.70063,"lng":30.68998},"visitMinutes":75,"priceLevel":2,"photoSeed":"sortavala_wv_kafe_lamberg","tickets":[{"vendor":"Official","url":"http://lamberg-club.ru/cafe.html","official":true}],"signals":{},"hashtags":["кафеламберг","sortavala"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Кафе принадлежит дорогому загородному клубу, но, увы, соответствием ему похвастаться не может: посетители в отзывах отмечают угловатое обслуживание, низкое качество ингредиентов и появление не заказанных позиций в счёте.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала"},{"id":"sortavala_wv_restoran_serdobol","areaId":"sortavala","name":"Ресторан «Сердоболь»","category":"food","tags":["food"],"location":{"lat":61.69951,"lng":30.69312},"visitMinutes":75,"priceLevel":3,"photoSeed":"sortavala_wv_restoran_serdobol","tickets":[],"signals":{},"hashtags":["ресторансердоболь","sortavala"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"}]},"summary":"Небольшой ресторан, совмещенный с центром детского творчества и работающий по его расписанию. Хорошая международная кухня, быстрое обслуживание и прекрасный вид на Ладогу.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сортавала"},{"id":"sortavala_wv_magazin_kafe_dom_berga","areaId":"sortavala","name":"Magazin-Kafe Dom Berga","category":"food","tags":["food"],"location":{"lat":61.7019,"lng":30.688},"visitMinutes":75,"photoSeed":"sortavala_wv_magazin_kafe_dom_berga","tickets":[],"signals":{},"hashtags":["magazinkafedomberga","sortavala"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"A café in Finnish style selling very good local specialty 'kalitki', Karelian dumplings. A must visit.","summarySource":"wikivoyage","wikivoyageTitle":"en:Sortavala"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStree