istory","photo"],"location":{"lat":40.79861,"lng":111.6575},"visitMinutes":45,"priceLevel":0,"photoSeed":"hohhot_five_pagoda_temple","tickets":[],"signals":{"commonsDepicts":1,"commonsNearby":12,"wikiPageviews":248,"wikidataSitelinks":10,"fetchedAt":"2026-10-24"},"hashtags":["fivepagodatemple","hohhot"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"}],"note":"Typical hours — check the official site"},"summary":"The Five Pagoda Temple, also known as the \"Precious Pagoda of the Buddhist Relics of the Diamond Throne\", is a Buddhist temple in the city of Hohhot in Inner Mongolia in north-west China. It is located in the older part of the city in the vicinity of Qingcheng Park.","summarySource":"wikipedia","wikipediaTitle":"Five Pagoda Temple (Hohhot)","names":{"de":"Fünf-Pagoden-Tempel (Hohhot)","fr":"Temple des cinq pagodes de Hohhot","es":"Templo de las Cinco Pagodas (Hohhot)","zh":"慈灯寺塔"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/1/11/Five_Pagoda_Temple%2C_Huhhot%2C_Inner_Mongolia.JPG","thumb":"https://upload.wikimedia.org/wikipedia/commons/1/11/Five_Pagoda_Temple%2C_Huhhot%2C_Inner_Mongolia.JPG","w":1200,"h":1600,"author":"me (w:User:pfctdayelise)","license":"CC BY-SA 2.5","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Five_Pagoda_Temple,_Huhhot,_Inner_Mongolia.JPG"}},{"id":"hohhot_xilitu_zhao","areaId":"hohhot","name":"Xilitu Zhao","category":"monument","tags":["history","photo"],"location":{"lat":40.79892,"lng":111.64971},"visitMinutes":45,"priceLevel":0,"photoSeed":"hohhot_xilitu_zhao","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":11,"wikiPageviews":184,"wikidataSitelinks":4,"fetchedAt":"2026-10-24"},"hashtags":["xilituzhao","hohhot"],"hours":{"week":[{"open":"09:00","c