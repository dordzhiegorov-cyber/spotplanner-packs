ия поддуболистная.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Ульяновская область","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/%D0%95%D0%BB%D0%BE%D0%B2%D0%B0%D1%8F_%D0%B0%D0%BB%D0%BB%D0%B5%D1%8F.jpg/1280px-%D0%95%D0%BB%D0%BE%D0%B2%D0%B0%D1%8F_%D0%B0%D0%BB%D0%BB%D0%B5%D1%8F.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/%D0%95%D0%BB%D0%BE%D0%B2%D0%B0%D1%8F_%D0%B0%D0%BB%D0%BB%D0%B5%D1%8F.jpg/500px-%D0%95%D0%BB%D0%BE%D0%B2%D0%B0%D1%8F_%D0%B0%D0%BB%D0%BB%D0%B5%D1%8F.jpg","w":1200,"h":1800,"author":"Игорь Улитин","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D0%95%D0%BB%D0%BE%D0%B2%D0%B0%D1%8F_%D0%B0%D0%BB%D0%BB%D0%B5%D1%8F.jpg"}}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}