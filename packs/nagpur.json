owds.","summarySource":"wikipedia","wikipediaTitle":"Yashwant Stadium","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Yashwant_Stadium.jpg/1280px-Yashwant_Stadium.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Yashwant_Stadium.jpg/500px-Yashwant_Stadium.jpg","w":1200,"h":900,"author":"Gppande","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Yashwant_Stadium.jpg"}},{"id":"nagpur_vidhan_bhavan","areaId":"nagpur","name":"Vidhan Bhavan","category":"landmark","tags":["photo"],"location":{"lat":21.1514,"lng":79.0796},"visitMinutes":60,"priceLevel":1,"photoSeed":"nagpur_vidhan_bhavan","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":6,"wikidataSitelinks":0,"fetchedAt":"2026-10-21"},"hashtags":["vidhanbhavan","nagpur"],"summary":"The seat of the winter sessions of the Maharashtra Legislature. It was built in 1912 to house the government of the Central Provinces of Berar, as Nagpur was its capital. The province was later incorporated into Madhya Pradesh in 1952 after India's independence, and Nagpur remained the capital of the Indian state. However, the Vidarbha region of Madhya Pradesh was later incorporated into Maharasht","summarySource":"wikivoyage","wikivoyageTitle":"Nagpur","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/Vidhan_Bhavan_%28State_Legislative_Assembly%29_Nagpur_-_panoramio.jpg/1280px-Vidhan_Bhavan_%28State_Legislative_Assembly%29_Nagpur_-_panoramio.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/Vidhan_Bhavan_%28State_Legislative_Assembly%29_Nagpur_-_panoramio.jpg/500px-Vidhan_Bhavan_%28State_Legislative_Assembly%29_Nagpur_-_panoramio.jpg","w":1200,"h":678,"author":"Ganesh Dhamodkar","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Vidhan_Bhavan_(State_Legislative_Assembly)_Nagpur_-_pan