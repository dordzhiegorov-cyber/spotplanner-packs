ce"},{"id":"damascus_sulaymaniyya_takiyya","areaId":"damascus","name":"Sulaymaniyya Takiyya","category":"monument","tags":["history","photo"],"location":{"lat":33.51231,"lng":36.29134},"visitMinutes":45,"priceLevel":0,"photoSeed":"damascus_sulaymaniyya_takiyya","tickets":[],"signals":{"commonsDepicts":4,"commonsNearby":67,"wikiPageviews":897,"wikidataSitelinks":28,"fetchedAt":"2026-10-19"},"hashtags":["sulaymaniyyatakiyya","damascus"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"}],"note":"Typical hours — check the official site"},"summary":"The Sulaymaniyya Takiyya is a takiyya, located in Damascus, Syria, on the right bank of the Barada River. Commissioned by the Ottoman sultan Suleiman the Magnificent, the western building of the complex was built, following the plans of Mimar Sinan, between 1554 and 1559.","summarySource":"wikipedia","wikipediaTitle":"Sulaymaniyya Takiyya"},{"id":"damascus_bab_tuma","areaId":"damascus","name":"Bab Tuma","category":"monument","tags":["history","views"],"location":{"lat":33.51373,"lng":36.3152},"visitMinutes":90,"priceLevel":1,"photoSeed":"damascus_bab_tuma","tickets":[],"signals":{"commonsDepicts":2,"commonsNearby":34,"wikiPageviews":1798,"wikidataSitelinks":16,"fetchedAt":"2026-10-19"},"hashtags":["babtuma","damascus"],"bestLight":"golden","summary":"Bab Tuma is a neighborhood located in the old city of Damascus in Syria. It is named after one of the seven gates of old city of Damascus, located within the neighbourhood.","summarySource":"wikipedia","wikipediaTitle":"Bab Tuma"},{"id":"damascus_citadel_of_damascus","areaId":"damascus","name":"Citadel of Damascus","category":"monument","tags":["history","photo","views"],"location":{"lat":33.51167,"lng":36.30194},"visitMinutes":120,"priceLevel":2,"photoSeed":"damascus_citadel_of_damasc