SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:0783_%D0%9F%D0%B0%D1%80%D0%BA%D0%B8_%D0%B8_%D1%81%D0%BA%D0%B2%D0%B5%D1%80%D1%8B_%D0%9E%D1%80%D0%BB%D0%B0.jpg"}},{"id":"oryol_pamyatnik_n_s_leskovu_orel","areaId":"oryol","name":"Памятник Н. С. Лескову (Орёл)","category":"monument","tags":["history","photo"],"location":{"lat":52.96218,"lng":36.06488},"visitMinutes":30,"priceLevel":0,"photoSeed":"oryol_pamyatnik_n_s_leskovu_orel","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":10,"wikiPageviews":93,"wikidataSitelinks":2,"fetchedAt":"2026-10-23"},"hashtags":["памятникнслесковуорёл","oryol"],"bestLight":"morning","summary":"Один из самых интересных памятников города установлен в 1981 году на правом берегу Орлика к 150-летию со дня рождения известного писателя. Лесков изображен сидящим на диване напротив гимназии, в которой он учился, а вокруг писателя раскиданы небольшие скульптуры героев его произведений: Левша, очарованный странник, леди Макбет Мценского уезда, тупейный художник и другие. Памятник популярен у молод","summarySource":"wikivoyage","wikivoyageTitle":"ru:Орёл","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/201309101625_IMAG1640.jpg/1280px-201309101625_IMAG1640.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/201309101625_IMAG1640.jpg/500px-201309101625_IMAG1640.jpg","w":1200,"h":900,"author":"Владимир Бруман","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:201309101625_IMAG1640.jpg"}},{"id":"oryol_statue_of_lenin_on_lenin_square","areaId":"oryol","name":"Statue of Lenin on Lenin Square","category":"monument","tags":["history","photo","art"],"location":{"lat":52.97104,"lng":36.06391},"visitMinutes":30,"priceLevel":0,"photoSeed":"oryol_statue_of_lenin_on_lenin_square","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":24,"wikiPageviews":28,"