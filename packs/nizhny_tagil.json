"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Closed Mon; Typical hours — check the official site"},"summary":"В замечательном особняке начала XIX века разместилась экспозиция, посвящённая жизни старого Тагила. Коллекция охватывает все социальные группы того времени, от ремесленников и простых рабочих до купцов и дворян, а через призму местной жизни показан и сам город. Внутри особняка аутентичного мало: до передачи музею он находился в очень плохом состоянии, так что все интерьеры восстановлены и приспосо","summarySource":"wikivoyage","wikivoyageTitle":"ru:Нижний Тагил","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/%D0%93%D0%BE%D1%81%D0%BF%D0%BE%D0%B4%D1%81%D0%BA%D0%B8%D0%B9_%D0%B4%D0%BE%D0%BC_%28%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9_%D0%A2%D0%B0%D0%B3%D0%B8%D0%BB%29.jpg/1280px-%D0%93%D0%BE%D1%81%D0%BF%D0%BE%D0%B4%D1%81%D0%BA%D0%B8%D0%B9_%D0%B4%D0%BE%D0%BC_%28%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9_%D0%A2%D0%B0%D0%B3%D0%B8%D0%BB%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/%D0%93%D0%BE%D1%81%D0%BF%D0%BE%D0%B4%D1%81%D0%BA%D0%B8%D0%B9_%D0%B4%D0%BE%D0%BC_%28%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9_%D0%A2%D0%B0%D0%B3%D0%B8%D0%BB%29.jpg/500px-%D0%93%D0%BE%D1%81%D0%BF%D0%BE%D0%B4%D1%81%D0%BA%D0%B8%D0%B9_%D0%B4%D0%BE%D0%BC_%28%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9_%D0%A2%D0%B0%D0%B3%D0%B8%D0%BB%29.jpg","w":1200,"h":800,"author":"Toshishiro","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D0%93%D0%BE%D1%81%D0%BF%D0%BE%D0%B4%D1%81%D0%BA%D0%B8%D0%B9_%D0%B4%D0%BE%D0%BC_(%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9_%D0%A2%D0%B0%D0%B3%D0%B8%D0%BB).jpg"}},{"id":"nizhny_tagil_bondin_s_house","areaId":"nizhny_tagil","name":"Bondin's house","category":"museum","tags":["museums","history","photo"],"location":{"lat":57.9042,"lng":59.9617},"visitMinutes":120,"priceLevel":2,"photoSeed":"nizhny_tagil_bondin_s_house","tickets":[{"vendor":"Official","url":"http://bondin1882.narod.ru","official":true}],"signals":{"commonsDepicts":0,"commonsNearby":20,"wikiPageviews":32,"wikidataSitelinks":4,"fetchedAt":"2026-10-23"},"hashtags":["bondinshouse","nizhnytagil"],"hours":{"week":[null,{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"},{"open":"10:00","close":"18:00"}],"note":"Closed Mon; Typical hours — check the official site"},"summary":"Алексей Бондин (1882&ndash;1939) — один из первых советских писателей, большую часть жизни провёл в Нижнем Тагиле. Его биография удивительно напоминает горьковскую, да и проза тоже: с той лишь разницей, что всерьёз Бондин начал писать только после революции в лучших традициях соцреализма. Именем Бондина назван окружающий дом-музей городской парк, там же стоит симпатичный бюст писателя.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Нижний Тагил","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/44/%D0%9C%D0%B5%D0%BC%D0%BE%D1%80%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D0%BE-%D0%BB%D0%B8%D1%82%D0%B5%D1%80%D0%B0%D1%82%D1%83%D1%80%D0%BD%D1%8B%D0%B9_%D0%BC%D1%83%D0%B7%D0%B5%D0%B9_%D0%91%D0%BE%D0%BD%D0%B4%D0%B8%D0%BD%D0%B0_%28%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9_%D0%A2%D0%B0%D0%B3%D0%B8%D0%BB%29.jpg/1280px-%D0%9C%D0%B5%D0%BC%D0%BE%D1%80%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D0%BE-%D0%BB%D0%B8%D1%82%D0%B5%D1%80%D0%B0%D1%82%D1%83%D1%80%D0%BD%D1%8B%D0%B9_%D0%BC%D1%83%D0%B7%D0%B5%D0%B9_%D0%91%D0%BE%D0%BD%D0%B4%D0%B8%D0%BD%D0%B0_%28%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9_%D0%A2%D0%B0%D0%B3%D0%B8%D0%BB%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/44/%D0%9C%D0%B5%D0%BC%D0%BE%D1%80%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D0%BE-%D0%BB%D0%B8%D1%82%D0%B5%D1%80%D0%B0%D1%82%D1%83%D1%80%D0%BD%D1%8B%D0%B9_%D0%BC%D1%83%D0%B7%D0%B5%D0%B9_%D0%91%D0%BE%D0%BD%D0%B4%D0%B8%D0%BD%D0%B0_%28%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9_%D0%A2%D0%B0%D0%