%80_%D0%A1%D0%B0%D1%80%D0%B0%D0%BF%D1%83%D0%BB%D0%B0.jpg/500px-%D0%A6%D0%B5%D0%BD%D1%82%D1%80_%D0%A1%D0%B0%D1%80%D0%B0%D0%BF%D1%83%D0%BB%D0%B0.jpg","w":1200,"h":900,"author":"Yan.gorev","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D0%A6%D0%B5%D0%BD%D1%82%D1%80_%D0%A1%D0%B0%D1%80%D0%B0%D0%BF%D1%83%D0%BB%D0%B0.jpg"}},{"id":"sarapul_former_administration_building_sarapul","areaId":"sarapul","name":"Former administration building, Sarapul","category":"landmark","tags":["photo"],"location":{"lat":56.47646,"lng":53.82034},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_former_administration_building_sarapul","tickets":[{"vendor":"Official","url":"https://politehvpo.ru/","official":true}],"signals":{"commonsDepicts":0,"commonsNearby":11,"wikiPageviews":10,"wikidataSitelinks":2,"fetchedAt":"2026-10-25"},"hashtags":["formeradministrationbuildingsarapul","sarapul"],"summary":"На центральной площади Сарапула некогда стоял Воскресенский собор, разрушенный в 1930-е гг. Ему площадь обязана своеобразной планировкой с длинным и узким сквером посередине. Собор был окружён торговыми рядами, которые дожили до наших дней, но теперь медленно разрушаются, создавая неприглядный фон для главной в городе автобусной остановки. Оценить этот комплекс по достоинству (причём без автобусно","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул","names":{"ru":"Здание бывшей городской управы"},"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Gorodskaya_uprava_%28Sarapul%29.jpg/1280px-Gorodskaya_uprava_%28Sarapul%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Gorodskaya_uprava_%28Sarapul%29.jpg/500px-Gorodskaya_uprava_%28Sarapul%29.jpg","w":1200,"h":1114,"author":"Emaus","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Gorodskaya_uprava_(Sarapul).jpg"}},{"id":"sarapul_uspenskaya_tserkov","areaId":"sarapul","name":"Успенская церковь","category":"monument","tags":["history","photo"],"location":{"lat":56.52259,"lng":53.79032},"visitMinutes":45,"priceLevel":0,"photoSeed":"sarapul_uspenskaya_tserkov","tickets":[],"signals":{"commonsDepicts":0,"commonsNearby":3,"wikiPageviews":12,"wikidataSitelinks":2,"fetchedAt":"2026-10-25"},"hashtags":["успенскаяцерковь","sarapul"],"hours":{"week":[{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"},{"open":"09:00","close":"18:00"}],"note":"Typical hours — check the official site"},"summary":"На севере к Сарапулу примыкает село Яромаска с Успенской церковью — хорошим памятником провинциального классицизма (1819-34). Авторство проекта приписывают тому же Семёну Дудину. До Яромаски можно дойти пешком (5 км от горы Урал), но, к сожалению, нет пути вдоль Камы — придётся идти по автодороге. Автобус № 11 едет до посёлка Котово и сокращает путь примерно вдвое.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Church_in_yaromaska_01.jpg/1280px-Church_in_yaromaska_01.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Church_in_yaromaska_01.jpg/500px-Church_in_yaromaska_01.jpg","w":1200,"h":1800,"author":"Alx0yago","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Church_in_yaromaska_01.jpg"}},{"id":"sarapul_wv_pamyatnik_kavalerist_devitse_nadezhde_durovoy","areaId":"sarapul","name":"Памятник кавалерист-девице Надежде Дуровой","category":"landmark","tags":["photo"],"location":{"lat":56.47783,"lng":53.82012},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_pamyatnik_kavalerist_devitse_nadezhde_durovoy","tickets":[],"signals":{"commonsNearby":9,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["памятниккавалеристдевиценадеждедуровой","sarapul"],"summary":"Персонаж почти фольклорный, известный в основном по фильму «Гусарская баллада», кавалерист-девица была вполне реальным историческим лицом. Сбежав от родных, она больше десяти лет служила в армии, успев поучаствовать в войне с Наполеоном, а, выйдя в отставку, написала мемуары, которые высоко оценил Пушкин. Жила Дурова в основном в Сарапуле и [[Елабуга","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%B0%D1%8F_%D0%BF%D0%BB%D0%BE%D1%89%D0%B0%D0%B4%D1%8C%2C3.jpg/1280px-%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%B0%D1%8F_%D0%BF%D0%BB%D0%BE%D1%89%D0%B0%D0%B4%D1%8C%2C3.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%B0%D1%8F_%D0%BF%D0%BB%D0%BE%D1%89%D0%B0%D0%B4%D1%8C%2C3.jpg/500px-%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%B0%D1%8F_%D0%BF%D0%BB%D0%BE%D1%89%D0%B0%D0%B4%D1%8C%2C3.jpg","w":1200,"h":1576,"author":"Yan.gorev","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%B0%D1%8F_%D0%BF%D0%BB%D0%BE%D1%89%D0%B0%D0%B4%D1%8C,3.jpg"}},{"id":"sarapul_wv_dom_bashenina","areaId":"sarapul","name":"Дом Башенина","category":"landmark","tags":["photo"],"location":{"lat":56.47277,"lng":53.82077},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_dom_bashenina","tickets":[],"signals":{"commonsNearby":6,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["домбашенина","sarapul"],"summary":"Самый яркий особняк Сарапула был построен для городского головы Башенина в 1904 году. Особенности здания — огромный угловой эркер, затейливая треугольная крыша и великолепный каменный декор.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/%D0%A3%D0%BB%D0%B8%D1%86%D0%B0_%D0%A2%D1%80%D1%83%D0%B4%D0%B0%2C22_%D0%B2_%D0%A1%D0%B0%D1%80%D0%B0%D0%BF%D1%83%D0%BB%D0%B5.jpg/1280px-%D0%A3%D0%BB%D0%B8%D1%86%D0%B0_%D0%A2%D1%80%D1%83%D0%B4%D0%B0%2C22_%D0%B2_%D0%A1%D0%B0%D1%80%D0%B0%D0%BF%D1%83%D0%BB%D0%B5.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/%D0%A3%D0%BB%D0%B8%D1%86%D0%B0_%D0%A2%D1%80%D1%83%D0%B4%D0%B0%2C22_%D0%B2_%D0%A1%D0%B0%D1%80%D0%B0%D0%BF%D1%83%D0%BB%D0%B5.jpg/500px-%D0%A3%D0%BB%D0%B8%D1%86%D0%B0_%D0%A2%D1%80%D1%83%D0%B4%D0%B0%2C22_%D0%B2_%D0%A1%D0%B0%D1%80%D0%B0%D0%BF%D1%83%D0%BB%D0%B5.jpg","w":1200,"h":900,"author":"Yan.gorev","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D0%A3%D0%BB%D0%B8%D1%86%D0%B0_%D0%A2%D1%80%D1%83%D0%B4%D0%B0,22_%D0%B2_%D0%A1%D0%B0%D1%80%D0%B0%D0%BF%D1%83%D0%BB%D0%B5.jpg"}},{"id":"sarapul_wv_dacha_bashenina","areaId":"sarapul","name":"Дача Башенина","category":"landmark","tags":["photo"],"location":{"lat":56.4745,"lng":53.7923},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_dacha_bashenina","tickets":[{"vendor":"Official","url":"http://museumsarapul.ru/about/bashenin/index.php","official":true}],"signals":{"commonsNearby":2,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["дачабашенина","sarapul"],"summary":"Выдающийся особняк в стиле модерн был построен в 1909 году для городского головы купца Башенина. Автором проекта считают всё того же Чарушина, хотя на этот счёт имеются разночтения, как есть они и относительно материала для строительства: снаружи особняк выглядит деревянным, напоминая старые дачи где-нибудь в окрестностях [[Санкт-Петербург","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул","photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/%D0%94%D0%B0%D1%87%D0%B0_%D0%91%D0%B0%D1%88%D0%B5%D0%BD%D0%B8%D0%BD%D0%B0_-_panoramio.jpg/1280px-%D0%94%D0%B0%D1%87%D0%B0_%D0%91%D0%B0%D1%88%D0%B5%D0%BD%D0%B8%D0%BD%D0%B0_-_panoramio.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/%D0%94%D0%B0%D1%87%D0%B0_%D0%91%D0%B0%D1%88%D0%B5%D0%BD%D0%B8%D0%BD%D0%B0_-_panoramio.jpg/500px-%D0%94%D0%B0%D1%87%D0%B0_%D0%91%D0%B0%D1%88%D0%B5%D0%BD%D0%B8%D0%BD%D0%B0_-_panoramio.jpg","w":1200,"h":1600,"author":"SerBor","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:%D0%94%D0%B0%D1%87%D0%B0_%D0%91%D0%B0%D1%88%D0%B5%D0%BD%D0%B8%D0%BD%D0%B0_-_panoramio.jpg"}},{"id":"sarapul_wv_dom_smagina","areaId":"sarapul","name":"Дом Смагина","category":"landmark","tags":["photo"],"location":{"lat":56.47435,"lng":53.81567},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_dom_smagina","tickets":[],"signals":{"commonsNearby":1,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["домсмагина","sarapul"],"summary":"Особняк в стиле модерн построен в 1912 году, и это уже достоверно проект Чарушина — довольно смелое (особенно для уездного города) решение, где сквозь плавные линии модерна проступают элементы классической архитектуры.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул","photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/1/19/Sarapul._Vyatskaya_street_01.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/1/19/Sarapul._Vyatskaya_street_01.jpg","w":1200,"h":779,"author":"Unknown authorUnknown author","license":"Public domain","licenseUrl":"","page":"https://commons.wikimedia.org/wiki/File:Sarapul._Vyatskaya_street_01.jpg"}},{"id":"sarapul_wv_tserkov_ksenii_peterburgskoy","areaId":"sarapul","name":"Церковь Ксении Петербургской","category":"landmark","tags":["photo"],"location":{"lat":56.47663,"lng":53.79331},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_tserkov_ksenii_peterburgskoy","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["церковьксениипетербургской","sarapul"],"summary":"Пятикупольный краснокирпичный храм был построен в 1911 году по проекту местного архитектора Николая Максимова, который руководил застройкой того квартала, что называется теперь музейным.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_zdaniya_bolnitsy_i_shkoly","areaId":"sarapul","name":"Здания больницы и школы","category":"landmark","tags":["photo"],"location":{"lat":56.4754,"lng":53.8018},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_zdaniya_bolnitsy_i_shkoly","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["зданиябольницыишколы","sarapul"],"summary":"Роскошные, губернские по своему размаху здания построены на рубеже XIX и XX вв. В больничных корпусах обратите внимание на мощные чугунные таблички, сообщающие когда здания заложены и для чего.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_voskresenskaya_tserkov","areaId":"sarapul","name":"Воскресенская церковь","category":"landmark","tags":["photo"],"location":{"lat":56.4834,"lng":53.8036},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_voskresenskaya_tserkov","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["воскресенскаяцерковь","sarapul"],"summary":"Приземистая кладбищенская церковь в стиле классицизма (1817) почти незаметна в череде одноэтажной застройки. Автором проекта считают ижевского архитектора Семёна Дудина, который обучался в петербургской Академии художеств и был на стажировке в Италии.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_tserkov_nikolaya_chudotvortsa","areaId":"sarapul","name":"Церковь Николая Чудотворца","category":"landmark","tags":["photo"],"location":{"lat":56.483,"lng":53.8181},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_tserkov_nikolaya_chudotvortsa","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["церковьниколаячудотворца","sarapul"],"summary":"Яркий пятикупольный храм построен в 1995-2009 гг. в память о погибших в Великой Отечественной войне и жертвах репрессий. От церкви хорошие виды на Каму. Они не сравнятся с видами со смотровой площадки на горе Урал, но, если у вас мало времени, доберитесь хотя бы сюда.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_mechet","areaId":"sarapul","name":"Мечеть","category":"landmark","tags":["photo"],"location":{"lat":56.48392,"lng":53.81819},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_mechet","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["мечетьsarapul","sarapul"],"summary":"Вдоль Камы много мечетей, и Сарапул тут — не исключение, хотя ничего исторического в мечети нет: кирпичное здание построено в 1994 году по самому что ни на есть типовому проекту.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_smotrovaya_ploshchadka_na_gore_ural","areaId":"sarapul","name":"Смотровая площадка на горе Урал","category":"landmark","tags":["photo"],"location":{"lat":56.49296,"lng":53.8135},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_smotrovaya_ploshchadka_na_gore_ural","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["смотроваяплощадканагореурал","sarapul"],"summary":"Лучшие виды на Каму открываются с высокого берега на северной окраине города. Путь сюда от центра занимает около получаса, причём дорога всё время идёт вверх, порой достаточно круто, поэтому целесообразно проехать автобусом до ост. «Улица Зайцева» и оттуда пройти ещё 200 м в сторону реки.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_elektrogeneratornyy_zavod_i_pamyatnik_mig_21","areaId":"sarapul","name":"Электрогенераторный завод и памятник МиГ-21","category":"landmark","tags":["photo"],"location":{"lat":56.44886,"lng":53.76138},"visitMinutes":60,"priceLevel":1,"photoSeed":"sarapul_wv_elektrogeneratornyy_zavod_i_pamyatnik_mig_21","tickets":[],"signals":{"commonsNearby":0,"wikidataSitelinks":0,"fetchedAt":"2026-10-25"},"hashtags":["электрогенераторныйзаводипамятникмиг21","sarapul"],"summary":"Если вам нечем занять время, можно съездить за железную дорогу, в район электрогенератного завода, где на площади перед проходной установлен истребитель МиГ-21 — самый массовый сверхзвуковой самолёт в истории, за свою форму (и происхождение) именуемый на Западе «балалайкой». Этот памятник напоминает об истории завода, возникшего в 1942 году для производства самолётных генераторов. Электрическая «н","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_restoran_artist","areaId":"sarapul","name":"Ресторан ARTIST","category":"nightlife","tags":["nightlife"],"location":{"lat":56.47348,"lng":53.80524},"visitMinutes":90,"photoSeed":"sarapul_wv_restoran_artist","tickets":[],"signals":{},"hashtags":["ресторанartist","sarapul"],"hours":{"week":[{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"},{"open":"18:00","close":"23:59"}],"note":"Typical hours — check the official site"},"bestLight":"night","summary":"Заведение расположено под землёй, но имеет отдельный вход с улицы, издали напоминающий павильон подземной парковки. Оформлено всё с большой претензией и таким же налётом провинциальности. Сам Артист характеризует себя как «народный вечерний ресторан с живым вокалом, безумными танцами и весельем». В меню ассортимент европейско-японской кухни с претензией на элитарность — попадаются кролик, улитки, ","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_kafe_pekarnya","areaId":"sarapul","name":"Кафе «Пекарня»","category":"food","tags":["food"],"location":{"lat":56.4726,"lng":53.8108},"visitMinutes":75,"photoSeed":"sarapul_wv_kafe_pekarnya","tickets":[],"signals":{},"hashtags":["кафепекарня","sarapul"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Булочная с парой столиков, где можно купить свежий («деревенский») хлеб, традиционную выпечку (по словам пекарей-удмуртов, «перемеч — удмуртская и элеш — татарская») и пироги — лимонный или сметанник. Есть чай, а также автомат, производящий дрянной кофе. Неуютно, но вкусно.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_kulinarnaya_lavka","areaId":"sarapul","name":"Кулинарная лавка","category":"food","tags":["food"],"location":{"lat":56.4725,"lng":53.8088},"visitMinutes":75,"photoSeed":"sarapul_wv_kulinarnaya_lavka","tickets":[],"signals":{},"hashtags":["кулинарнаялавка","sarapul"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Кафе-кондитерская, в котором предлагают выпечку с лёгким национальным оттенком и пирожные местного производства. Уютные деревянные столики в кафе уже поставили, но посуду ещё не завезли, поэтому кофе наливают в бумажный стаканчик, а пирожные кладут в целлофановый пакет.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_kafe_selfie","areaId":"sarapul","name":"Кафе Selfie","category":"food","tags":["food"],"location":{"lat":56.476,"lng":53.814},"visitMinutes":75,"photoSeed":"sarapul_wv_kafe_selfie","tickets":[],"signals":{},"hashtags":["selfie","sarapul"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Маленькое кафе в здании торгового центра. Кормят без особых изысков (салаты, супы, блины и, внезапно, лапша в разделе «Паназиатская кухня»), но быстро, съедобно и в приятном интерьере. Делать селфи не требуется. Wi-Fi.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_art_kafe_richi","areaId":"sarapul","name":"Арт-кафе Richi","category":"food","tags":["food"],"location":{"lat":56.47686,"lng":53.81679},"visitMinutes":75,"photoSeed":"sarapul_wv_art_kafe_richi","tickets":[{"vendor":"Official","url":"http://artcaferichi.ru","official":true}],"signals":{},"hashtags":["арткафеrichi","sarapul"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Приятное кафе, где проводятся мастер-классы и встречи с творческими людьми города. Европейская кухня с примесью суши, хорошая барная карта. Днём по будням недорогой бизнес-ланч.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"},{"id":"sarapul_wv_studiya_yaponskoy_kukhni_kioto","areaId":"sarapul","name":"Студия японской кухни «Киото»","category":"food","tags":["food"],"location":{"lat":56.47794,"lng":53.79797},"visitMinutes":75,"photoSeed":"sarapul_wv_studiya_yaponskoy_kukhni_kioto","tickets":[{"vendor":"Official","url":"http://sushisarapul.ru/","official":true}],"signals":{},"hashtags":["студияяпонскойкухникиото","sarapul"],"hours":{"week":[{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"},{"open":"12:00","close":"22:00"}],"note":"Typical hours — check the official site"},"summary":"Псевдо-японская еда, а для голодных — пицца, в том числе с доставкой. Бывают вечеринки и мастер-классы для детей.","summarySource":"wikivoyage","wikivoyageTitle":"ru:Сарапул"}],"sources":["Wikidata (CC0)","Wikimedia Commons (counts; photos credited per file)","Wikipedia (pageviews; summaries CC BY-SA 4.0)","Wikivoyage (listings: hours, prices, descriptions; CC BY-SA 4.0)","OpenStreetMap contributors (ODbL): opening hours, fees, websites"]}